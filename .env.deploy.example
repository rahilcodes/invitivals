# Copy to .env.deploy (which is never committed) and fill in.
DEPLOY_HOST=
DEPLOY_PORT=65002
DEPLOY_USER=
DEPLOY_DIR=domains/invitivals.com/public_html

# Sign in with an SSH key (preferred) …
DEPLOY_KEY=C:\Users\you\.ssh\id_rsa_hostinger
# … or, only if there is no key, a password.
DEPLOY_PASSWORD=
