---
import config from '../wedding.config';
import PhotoSlot from './PhotoSlot.astro';
---

<section class="gallery" data-screen="gallery" aria-labelledby="gallery-h">
  <div class="head rv-rise">
    <div class="overline">Gallery</div>
    <h2 id="gallery-h">{config.gallery.heading}</h2>
  </div>

  <div class="scroller no-scrollbar" tabindex="0" role="region" aria-label="Photo gallery — scroll horizontally">
    {
      config.gallery.photos.map((p, i) => (
        <button
          class="item"
          type="button"
          data-gal-index={i}
          style={`width:${p.w}px;height:${p.h}px`}
          aria-label={`View photo: ${p.alt}`}
        >
          <PhotoSlot src={p.src} alt={p.alt} label={`Photo ${i + 1}`} width={p.w} height={p.h} />
        </button>
      ))
    }
  </div>

  <div class="hint" aria-hidden="true">Swipe &rarr; &middot; tap to view</div>
</section>

<dialog class="glb" id="wl-gal-lightbox" aria-label="Photo viewer">
  <button class="glb-close" id="wl-gal-close" type="button" aria-label="Close photo viewer">&times;</button>
  <figure>
    <img id="wl-gal-img" alt="" />
    <figcaption>
      <span class="glb-caption" id="wl-gal-caption"></span>
      <span class="glb-count" id="wl-gal-count"></span>
    </figcaption>
  </figure>
  <button class="glb-nav glb-prev" id="wl-gal-prev" type="button" aria-label="Previous photo">&#8249;</button>
  <button class="glb-nav glb-next" id="wl-gal-next" type="button" aria-label="Next photo">&#8250;</button>
</dialog>

<style>
  .gallery {
    padding: 96px 0;
    background: var(--bg2);
  }
  .head {
    text-align: center;
    padding: 0 24px;
  }
  .overline {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--gold);
    text-transform: uppercase;
  }
  h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: clamp(34px, 6vw, 52px);
    margin: 12px 0 0;
  }
  .scroller {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 52px max(24px, calc(50vw - 460px)) 20px;
    align-items: center;
  }
  .item {
    flex: none;
    scroll-snap-align: center;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .item:disabled {
    cursor: default;
  }
  .hint {
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--mut);
  }

  /* ── Fullscreen photo viewer ─────────────────────────────────────────── */
  .glb {
    position: fixed;
    border: 0;
    padding: 0;
    background: transparent;
    width: min(92vw, 900px);
    max-width: 92vw;
    overflow: visible;
  }
  .glb::backdrop {
    background: rgba(10, 9, 7, 0.9);
    backdrop-filter: blur(8px);
  }
  figure {
    margin: 0;
  }
  #wl-gal-img {
    width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 3px;
    display: block;
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 14px;
  }
  .glb-caption {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 17px;
    color: #efe9da;
  }
  .glb-count {
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    flex: none;
  }
  .glb-close {
    position: absolute;
    top: -48px;
    right: 0;
    background: none;
    border: 0;
    color: #fff;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
    padding: 6px 10px;
  }
  .glb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(10, 9, 7, 0.35);
    color: #efe9da;
    font-family: 'Cormorant Garamond', serif;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 5px;
    transition: border-color 0.25s ease;
  }
  .glb-nav:hover {
    border-color: var(--gold);
  }
  .glb-prev { left: 10px; }
  .glb-next { right: 10px; }
</style>
