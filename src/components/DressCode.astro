---
import config from '../wedding.config';
---

<section class="dress" data-screen="dress-code" aria-labelledby="dress-h">
  <div class="rv-rise" style="--rvr:entry 10% cover 30%">
    <div class="overline">Dress code</div>
    <h2 id="dress-h">{config.dressCode.title}</h2>
    <p>
      {config.dressCode.body.map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </p>
    <div class="swatches" role="img" aria-label={`Suggested colours: ${config.dressCode.caption}`}>
      {config.dressCode.swatches.map((hex) => (
        <div class="swatch" style={`background:${hex}`}></div>
      ))}
    </div>
    <div class="caption" aria-hidden="true">{config.dressCode.caption}</div>
  </div>
</section>

<style>
  .dress {
    padding: 96px 24px;
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }
  .overline {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--gold);
    text-transform: uppercase;
  }
  h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-style: italic;
    font-size: clamp(34px, 6vw, 52px);
    margin: 12px 0 0;
  }
  p {
    font-size: 14px;
    line-height: 1.9;
    color: var(--mut);
    margin: 22px 0 0;
  }
  .swatches {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 34px;
  }
  .swatch {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--goldSoft);
  }
  .caption {
    font-size: 10px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--mut);
    margin-top: 14px;
  }
</style>
