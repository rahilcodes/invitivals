---
import { WA } from '../../data/site';

/* The bar fixed to the bottom of a phone: one thing to do next, always in
   reach of the thumb. Pages that use it pass `bar` to SiteLayout. */
interface Props {
  label: string;
  href: string;
  note?: string;
  /** opens in a new tab (WhatsApp) */
  blank?: boolean;
  /** the home page rewrites the label as sections scroll past */
  live?: boolean;
  /** a round WhatsApp button beside a main action that is not WhatsApp */
  chat?: boolean;
}
const { label, href, note, blank = false, live = false, chat = false } = Astro.props;
---

<div class="bar">
  {
    chat && (
      <a class="bar-wa" href={WA.general} target="_blank" rel="noopener" aria-label="Message us on WhatsApp">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5Z" />
          <path d="M8.5 10.5h7M8.5 13.5h4.5" />
        </svg>
      </a>
    )
  }
  <div class="bar-main">
    <a class="btn" id={live ? 'bar-cta' : undefined} href={href} target={blank ? '_blank' : undefined} rel={blank ? 'noopener' : undefined}>{label}</a>
    {note && <span class="note" id={live ? 'bar-note' : undefined}>{note}</span>}
  </div>
</div>
