---
import config from '../wedding.config';
import PhotoSlot from './PhotoSlot.astro';

const people = [
  { ...config.bride, anim: 'rv-l' },
  { ...config.groom, anim: 'rv-r' },
];
---

<section class="couple" data-screen="bride-and-groom" aria-labelledby="couple-h">
  <div class="head rv-rise">
    <div class="overline">The couple</div>
    <h2 id="couple-h">Two hearts, one promise</h2>
    <div class="rule rv-grow" style="--rvr:entry 10% cover 30%"></div>
  </div>

  <div class="pair">
    {
      people.map((p) => (
        <div class={`person ${p.anim}`} style="--rvr:entry 15% cover 35%">
          <div class="arch">
            <div class="arch-inner">
              <PhotoSlot src={p.photo} alt={p.name} label={`${p.role} portrait — ${p.photo}`} />
            </div>
          </div>
          <h3>{p.name}</h3>
          <div class="role">{p.role}</div>
          <p>{p.bio}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .couple {
    padding: 96px 24px 40px;
  }
  .head {
    text-align: center;
  }
  .overline {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--gold);
    text-transform: uppercase;
  }
  h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: clamp(34px, 6vw, 52px);
    margin: 12px 0 0;
  }
  .rule {
    width: 46px;
    height: 1px;
    background: var(--gold);
    margin: 20px auto 0;
  }
  .pair {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(20px, 5vw, 64px);
    margin-top: 56px;
  }
  .person {
    text-align: center;
    width: min(42vw, 280px);
  }
  .arch {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
    border: 1px solid var(--goldSoft);
    padding: 8px;
    box-sizing: border-box;
    background: var(--bg2);
  }
  .arch-inner {
    width: 100%;
    height: 100%;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
  }
  h3 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: clamp(24px, 4.5vw, 32px);
    margin: 22px 0 6px;
  }
  .role {
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold);
  }
  p {
    font-size: 14px;
    line-height: 1.75;
    color: var(--mut);
    margin: 14px 0 0;
  }
</style>
