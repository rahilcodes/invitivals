---
import config from '../wedding.config';
import PhotoSlot from './PhotoSlot.astro';
import { videoEmbed } from '../lib/helpers';

const embed = videoEmbed(config.film.video);
---

<section class="film" data-screen="film" aria-labelledby="film-h">
  <div class="head rv-rise">
    <div class="overline">Our film</div>
    <h2 id="film-h">{config.film.heading}</h2>
  </div>

  <div class="frame rv-mask" style="--rvr:entry 12% cover 36%">
    <PhotoSlot
      src={config.film.poster}
      alt="Film still"
      label="Film still, 16:9 — /photos/film.jpg"
    />
    {
      embed.kind !== 'none' && (
        <button
          class="play"
          id="wl-play"
          type="button"
          aria-label="Play our film"
          data-kind={embed.kind}
          data-src={embed.src}
        >
          <span class="disc" aria-hidden="true">
            <span class="triangle" />
          </span>
        </button>
      )
    }
  </div>
</section>

<dialog class="lightbox" id="wl-lightbox" aria-label="Our film">
  <button class="close" id="wl-lightbox-close" type="button" aria-label="Close video">&times;</button>
  <div class="stage" id="wl-lightbox-stage"></div>
</dialog>

<style>
  .film {
    padding: 96px 24px;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .overline {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--gold);
    text-transform: uppercase;
  }
  h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: clamp(34px, 6vw, 52px);
    margin: 12px 0 0;
  }
  .frame {
    position: relative;
    margin-top: 48px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 3px;
  }
  .play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    border: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .disc {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--bg) 80%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: kBreath 2.8s ease infinite;
  }
  .triangle {
    width: 0;
    height: 0;
    border-left: 18px solid var(--ink);
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
    margin-left: 5px;
  }

  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    width: min(94vw, 960px);
    max-width: 94vw;
  }
  .lightbox::backdrop {
    background: rgba(10, 9, 7, 0.88);
    backdrop-filter: blur(6px);
  }
  .stage {
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 3px;
    overflow: hidden;
  }
  .stage :global(iframe),
  .stage :global(video) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .close {
    position: absolute;
    top: -46px;
    right: 0;
    background: none;
    border: 0;
    color: #fff;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
    padding: 6px 10px;
  }
</style>
