---
import config from '../wedding.config';
---

<section class="faq" data-screen="faq" aria-labelledby="faq-h">
  <div class="head rv-rise" style="--rvr:entry 10% cover 30%">
    <div class="overline">Good to know</div>
    <h2 id="faq-h">{config.faq.heading}</h2>
  </div>

  {
    config.faq.items.map((item) => (
      <details>
        <summary>
          {item.q}
          <span class="plus" aria-hidden="true">+</span>
        </summary>
        <p set:html={item.a} />
      </details>
    ))
  }
</section>

<style>
  .faq {
    padding: 80px 24px 96px;
    max-width: 620px;
    margin: 0 auto;
  }
  .head {
    text-align: center;
  }
  .overline {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--gold);
    text-transform: uppercase;
  }
  h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: clamp(34px, 6vw, 52px);
    margin: 12px 0 24px;
  }
  details {
    border-bottom: 1px solid var(--goldSoft);
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 4px;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: 19px;
  }
  .plus {
    color: var(--gold);
    font-size: 20px;
    flex: none;
    transition: transform 0.3s ease;
  }
  details[open] .plus {
    transform: rotate(45deg);
  }
  details p {
    font-size: 14px;
    line-height: 1.8;
    color: var(--mut);
    margin: 0;
    padding: 0 4px 24px;
  }
  details p :global(strong) {
    color: var(--gold);
    font-weight: 500;
  }
</style>
