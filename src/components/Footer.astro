---
import config from '../wedding.config';
import { mediumDate } from '../lib/helpers';
---

<footer data-screen="footer">
  <div class="monogram" aria-hidden="true">
    {config.bride.initial}<span class="amp">&amp;</span>{config.groom.initial}
  </div>
  <div class="names">
    {config.bride.first} <span class="amp-lg">&amp;</span> {config.groom.first}
  </div>
  <div class="date">{mediumDate()} &middot; {config.venue.name}</div>
  <div class="hashtag">{config.hashtag}</div>
  <div class="closing">{config.footerClosing}</div>
</footer>

<style>
  footer {
    background: var(--dark);
    color: var(--darkInk);
    text-align: center;
    padding: 80px 24px 110px;
  }
  .monogram {
    width: 66px;
    height: 66px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    color: var(--gold);
  }
  .amp {
    margin: 0 5px;
    font-style: italic;
    font-size: 14px;
  }
  .names {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 6vw, 40px);
    margin: 26px 0 8px;
  }
  .amp-lg {
    font-style: italic;
    color: var(--gold);
  }
  .date {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--darkInk) 60%, transparent);
  }
  .hashtag {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 17px;
    color: var(--gold);
    margin-top: 30px;
  }
  .closing {
    font-size: 11px;
    color: color-mix(in srgb, var(--darkInk) 40%, transparent);
    margin-top: 44px;
    letter-spacing: 0.08em;
  }
</style>
