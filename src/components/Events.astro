---
import config from '../wedding.config';
---

<section id="events" class="events" data-screen="wedding-events" aria-labelledby="events-h">
  <div class="inner">
    <div class="head rv-rise">
      <div class="overline">Celebrations</div>
      <h2 id="events-h">{config.events.heading}</h2>
    </div>

    <div class="list">
      {
        config.events.items.map((ev, i) => (
          <div
            class={`card rv-rise ${ev.highlight ? 'highlight' : ''}`}
            style={`--rvr:entry 15% cover 35%;--rv-delay:${i * 0.1}s`}
          >
            <div class="date-block">
              <div class="day">{ev.day}</div>
              <div class="num">{ev.date}</div>
              <div class="month">{ev.month}</div>
            </div>
            <div class="body">
              <h3>{ev.title}</h3>
              <p>{ev.body}</p>
              <div class="dress">{ev.dress}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .events {
    padding: 96px 24px;
    background: var(--bg2);
  }
  .inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .head {
    text-align: center;
  }
  .overline {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--gold);
    text-transform: uppercase;
  }
  h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: clamp(34px, 6vw, 52px);
    margin: 12px 0 0;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin-top: 56px;
  }
  .card {
    display: flex;
    gap: 22px;
    align-items: stretch;
    background: var(--bg);
    border: 1px solid var(--goldSoft);
    padding: 26px;
    box-shadow: 0 24px 50px -34px color-mix(in srgb, var(--ink) 40%, transparent);
  }
  .card.highlight {
    border-color: var(--gold);
    box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--gold) 50%, transparent);
  }
  .date-block {
    flex: none;
    width: 74px;
    text-align: center;
    border-right: 1px solid var(--goldSoft);
    padding-right: 22px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .day {
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 40px;
    line-height: 1.1;
  }
  .highlight .num {
    color: var(--gold);
  }
  .month {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mut);
  }
  h3 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: 24px;
    margin: 0 0 6px;
  }
  .body p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--mut);
    margin: 0 0 10px;
  }
  .dress {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
</style>
