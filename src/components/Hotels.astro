---
import config from '../wedding.config';
import PhotoSlot from './PhotoSlot.astro';

const slots = ['/photos/hotel-1.jpg', '/photos/hotel-2.jpg'];
const anims = ['rv-l', 'rv-r'];
---

<section class="hotels" data-screen="accommodation" aria-labelledby="hotels-h">
  <div class="inner">
    <div class="head rv-rise">
      <div class="overline">Stay nearby</div>
      <h2 id="hotels-h">{config.hotels.heading}</h2>
      <p class="intro">
        {config.hotels.intro} <strong>{config.hotels.code}</strong> when booking.
      </p>
    </div>

    <div class="grid">
      {
        config.hotels.items.map((h, i) => (
          <div class={`card ${anims[i % 2]}`} style="--rvr:entry 15% cover 35%">
            <div class="photo">
              <PhotoSlot src={h.photo} alt={h.name} label={`Hotel photo — ${h.photo}`} />
            </div>
            <div class="body">
              <h3>{h.name}</h3>
              <div class="meta">{h.meta}</div>
              <p>{h.blurb}</p>
              <a class="book" href={h.bookUrl} target={h.bookUrl.startsWith('http') ? '_blank' : undefined} rel="noopener">Book a room</a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hotels {
    padding: 96px 24px;
    background: var(--bg2);
  }
  .inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .head {
    text-align: center;
  }
  .overline {
    font-size: 11px;
    letter-spacing: 0.32em;
    color: var(--gold);
    text-transform: uppercase;
  }
  h2 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: clamp(34px, 6vw, 52px);
    margin: 12px 0 0;
  }
  .intro {
    font-size: 14px;
    color: var(--mut);
    margin: 16px auto 0;
    max-width: 420px;
    line-height: 1.7;
  }
  .intro strong {
    color: var(--gold);
    font-weight: 500;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 22px;
    margin-top: 52px;
  }
  .card {
    background: var(--bg);
    border: 1px solid var(--goldSoft);
  }
  .photo {
    height: 160px;
    overflow: hidden;
  }
  .body {
    padding: 24px;
  }
  h3 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    font-size: 23px;
    margin: 0 0 4px;
  }
  .meta {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
  }
  p {
    font-size: 13px;
    line-height: 1.7;
    color: var(--mut);
    margin: 0 0 16px;
  }
  .book {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 3px;
  }
</style>
