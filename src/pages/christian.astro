  <button id="music" class="muted" type="button" aria-pressed="false" aria-label="Play background music">
    <span class="bar" aria-hidden="true"></span>
    <span class="bar" aria-hidden="true"></span>
    <span class="bar" aria-hidden="true"></span>
  </button>

  <script is:inline>
    (function () {
      'use strict';

      /* ---------- reveal on scroll ---------- */
      var rvs = document.querySelectorAll('.rv');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        rvs.forEach(function (el) { io.observe(el); });
      } else {
        rvs.forEach(function (el) { el.classList.add('in'); });
      }

      /* ---------- ambient music (WebAudio) ---------- */
      var NOTES = [261.63, 293.66, 329.63, 392, 440, 523.25];
      var PAD = [130.81, 164.81, 196.0];
      var ac = null, master = null, musicOn = false;
      var musicBtn = document.getElementById('music');

      function buildAudio() {
        if (ac) return true;
        var AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return false;
        ac = new AC();
        master = ac.createGain();
        master.gain.value = 0.045; /* master ceiling <= 0.05 */
        master.connect(ac.destination);
        PAD.forEach(function (f) {
          var o = ac.createOscillator(), g = ac.createGain();
          o.type = 'sine'; o.frequency.value = f;
          g.gain.setValueAtTime(0.0001, ac.currentTime);
          g.gain.linearRampToValueAtTime(0.012, ac.currentTime + 5);
          o.connect(g); g.connect(master); o.start();
        });
        (function loop() {
          if (!ac) return;
          if (musicOn && ac.state === 'running') pluck();
          setTimeout(loop, 1500 + Math.random() * 2000);
        })();
        return true;
      }
      function pluck() {
        var f = NOTES[Math.floor(Math.random() * NOTES.length)];
        var t = ac.currentTime;
        var o = ac.createOscillator(), g = ac.createGain();
        o.type = 'sine'; o.frequency.value = f;
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(0.22, t + 0.05); /* soft attack */
        g.gain.exponentialRampToValueAtTime(0.0001, t + 3.4); /* long decay */
        o.connect(g); g.connect(master);
        o.start(t); o.stop(t + 3.6);
      }
      function setMusic(on) {
        if (on && !buildAudio()) return;
        musicOn = on;
        if (ac) { on ? ac.resume() : ac.suspend(); }
        musicBtn.classList.toggle('muted', !on);
        musicBtn.setAttribute('aria-pressed', String(on));
        musicBtn.setAttribute('aria-label', on ? 'Mute background music' : 'Play background music');
      }
      musicBtn.addEventListener('click', function () { setMusic(!musicOn); });

      /* ---------- intro overlay ---------- */
      var intro = document.getElementById('intro');
      var openBtn = document.getElementById('open-invite');
      openBtn.addEventListener('click', function () {
        intro.classList.add('leave');
        document.body.classList.remove('locked');
        setMusic(true);
        setTimeout(function () { intro.remove(); }, 1100);
      });

      /* ---------- countdown ---------- */
      var TARGET = new Date('2026-12-28T10:00:00+05:30').getTime();
      var cd = {
        d: document.getElementById('cd-d'), h: document.getElementById('cd-h'),
        m: document.getElementById('cd-m'), s: document.getElementById('cd-s')
      };
      var pad = function (n) { return String(n).padStart(2, '0'); };
      var timer = null;
      function tick() {
        var diff = TARGET - Date.now();
        if (diff <= 0) {
          cd.d.textContent = cd.h.textContent = cd.m.textContent = cd.s.textContent = '00';
          if (timer) clearInterval(timer);
          return;
        }
        var s = Math.floor(diff / 1000);
        cd.d.textContent = pad(Math.floor(s / 86400));
        cd.h.textContent = pad(Math.floor(s / 3600) % 24);
        cd.m.textContent = pad(Math.floor(s / 60) % 60);
        cd.s.textContent = pad(s % 60);
      }
      tick();
      timer = setInterval(tick, 1000);

      /* ---------- candle wall ---------- */
      var wall = document.getElementById('candle-wall');
      var cForm = document.getElementById('candle-form');
      var wishText = document.getElementById('wish-text');
      var wishName = document.getElementById('wish-name');
      cForm.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var wish = wishText.value.trim();
        var name = wishName.value.trim();
        if (!wish || !name) return;
        var li = document.createElement('li');
        li.className = 'candle';
        li.style.setProperty('--h', (48 + Math.round(Math.random() * 18)) + 'px');
        li.title = wish;
        li.setAttribute('aria-label', 'Candle from ' + name + ': ' + wish);
        var flame = document.createElement('span');
        flame.className = 'flame'; flame.setAttribute('aria-hidden', 'true');
        var wax = document.createElement('span');
        wax.className = 'wax'; wax.setAttribute('aria-hidden', 'true');
        var cname = document.createElement('span');
        cname.className = 'cname'; cname.textContent = name;
        li.appendChild(flame); li.appendChild(wax); li.appendChild(cname);
        wall.appendChild(li);
        cForm.reset();
        wishText.focus();
      });

      /* ---------- rsvp ---------- */
      var rForm = document.getElementById('rsvp-form');
      var rMain = document.getElementById('rsvp-main');
      var rThanks = document.getElementById('rsvp-thanks');
      var thanksMsg = document.getElementById('thanks-msg');
      var rName = document.getElementById('r-name');
      var attYes = document.getElementById('att-yes');
      var attNo = document.getElementById('att-no');
      var attending = true;
      function setAttending(yes) {
        attending = yes;
        attYes.setAttribute('aria-pressed', String(yes));
        attNo.setAttribute('aria-pressed', String(!yes));
      }
      attYes.addEventListener('click', function () { setAttending(true); });
      attNo.addEventListener('click', function () { setAttending(false); });

      var guests = 1;
      var stepVal = document.getElementById('step-val');
      document.getElementById('step-down').addEventListener('click', function () {
        guests = Math.max(1, guests - 1); stepVal.textContent = guests;
      });
      document.getElementById('step-up').addEventListener('click', function () {
        guests = Math.min(8, guests + 1); stepVal.textContent = guests;
      });

      rForm.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var name = rName.value.trim();
        if (!name) { rName.focus(); return; }
        var first = name.split(/\s+/)[0];
        thanksMsg.textContent = attending
          ? 'Thank you, ' + first + '. We are overjoyed — ' + guests + (guests > 1 ? ' seats' : ' seat') + ' will be waiting for you on December 28.'
          : 'Thank you, ' + first + '. You will be dearly missed, and warmly remembered in our prayers.';
        rMain.hidden = true;
        rThanks.hidden = false;
      });
      document.getElementById('rsvp-change').addEventListener('click', function () {
        rThanks.hidden = true;
        rMain.hidden = false;
        rName.focus();
      });
    })();
  </script>
