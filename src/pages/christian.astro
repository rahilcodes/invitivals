---
import '@fontsource/pinyon-script/400.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/400-italic.css';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Joel &amp; Merin — December 28, 2026</title>
  <meta name="description" content="Together with their families, Joel Thomas and Merin George request the honour of your presence as they are united in Holy Matrimony — December 28, 2026, St. Francis CSI Church, Fort Kochi." />
  <meta property="og:title" content="Joel & Merin — December 28, 2026" />
  <meta property="og:description" content="Holy Matrimony at St. Francis CSI Church, Fort Kochi, followed by a reception at The Taj Malabar. #JoelWedsMerin" />
  <meta property="og:image" content="/art/christian/hero.svg" />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#FBF9F4" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23FBF9F4'/%3E%3Ccircle cx='27' cy='36' r='13' fill='none' stroke='%23C9B37E' stroke-width='3.5'/%3E%3Ccircle cx='39' cy='29' r='13' fill='none' stroke='%23C9B37E' stroke-width='3.5'/%3E%3C/svg%3E" />
  <script is:inline>document.documentElement.classList.add('js');</script>

  <style is:global>
    :root{
      --bg:#FBF9F4; --bg2:#F4EFE4; --ink:#3A3F45; --mut:#8B8F94;
      --blue:#7D92A1; --sage:#A8B8A0; --blush:#E8C9C0; --gold:#C9B37E;
      --gold-soft:rgba(201,179,126,.38); --dusk:#313B45; --dusk2:#3C4854;
      --serif:"EB Garamond",Georgia,serif; --script:"Pinyon Script",cursive;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;scroll-padding-top:84px}
    body{
      font-family:var(--serif);color:var(--ink);background:var(--bg);
      font-size:17px;line-height:1.65;overflow-x:clip;
      -webkit-font-smoothing:antialiased;
    }
    html.js body.locked{overflow:hidden}
    img{max-width:100%;display:block}
    a{color:inherit}
    button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
    :focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:2px}
    .wrap{max-width:680px;margin-inline:auto;padding-inline:24px}
    .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

    /* ---------- shared ornaments ---------- */
    .overline{font-size:11px;letter-spacing:.38em;text-transform:uppercase;color:var(--blue);font-weight:500}
    .script-title{font-family:var(--script);font-size:clamp(38px,9vw,56px);line-height:1.15;color:var(--ink);font-weight:400}
    .rule{width:64px;height:1px;background:var(--gold);margin:18px auto;position:relative}
    .rule::after{content:"";position:absolute;left:50%;top:50%;width:5px;height:5px;background:var(--gold);transform:translate(-50%,-50%) rotate(45deg)}
    section{padding:88px 0}
    .sec-head{text-align:center;margin-bottom:44px}
    .pill{
      display:inline-flex;align-items:center;justify-content:center;gap:10px;
      min-height:48px;padding:12px 34px;border:1px solid var(--gold);border-radius:999px;
      letter-spacing:.24em;text-transform:uppercase;font-size:12px;font-weight:500;
      color:var(--ink);background:transparent;text-decoration:none;
      transition:background .35s ease,color .35s ease;
    }
    .pill:hover{background:var(--gold);color:#fff}

    /* ---------- reveals ---------- */
    html.js .rv{opacity:0;transform:translateY(20px);transition:opacity .9s ease var(--d,0s),transform .9s ease var(--d,0s)}
    html.js .rv.in{opacity:1;transform:none}

    /* ---------- keyframes ---------- */
    @keyframes rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
    @keyframes curtain{from{clip-path:inset(0 0 100% 0)}to{clip-path:inset(0 0 -8% 0)}}
    @keyframes draw{to{stroke-dashoffset:0}}
    @keyframes flicker{
      0%{transform:translateX(-50%) scale(1) rotate(-2deg);opacity:.95}
      35%{transform:translateX(-52%) scale(.92,1.06) rotate(2deg)}
      70%{transform:translateX(-48%) scale(1.05,.94) rotate(-1deg);opacity:1}
      100%{transform:translateX(-50%) scale(.97) rotate(1.5deg);opacity:.9}
    }
    @keyframes glow{from{opacity:.55}to{opacity:.9}}
    @keyframes petalFall{
      0%{transform:translate3d(0,-6vh,0) rotate(0deg);opacity:0}
      12%{opacity:.85}
      50%{transform:translate3d(4vw,34vh,0) rotate(160deg)}
      88%{opacity:.7}
      100%{transform:translate3d(-3vw,72vh,0) rotate(320deg);opacity:0}
    }
    @keyframes breathe{
      0%,100%{box-shadow:0 0 0 0 rgba(201,179,126,.35)}
      50%{box-shadow:0 0 0 12px rgba(201,179,126,0)}
    }
    @keyframes eq{from{transform:scaleY(.25)}to{transform:scaleY(1)}}
    @keyframes pop{from{opacity:0;transform:translateY(14px) scale(.85)}to{opacity:1;transform:none}}

    /* ---------- intro overlay ---------- */
    html:not(.js) #intro{display:none}
    #intro{
      position:fixed;inset:0;z-index:60;background:var(--bg);
      display:flex;align-items:center;justify-content:center;text-align:center;
      padding:56px 28px;transition:opacity 1s ease,transform 1s ease,visibility 0s linear 1s;
    }
    #intro::before,#intro::after{content:"";position:absolute;pointer-events:none;border:1px solid var(--gold-soft)}
    #intro::before{inset:14px}
    #intro::after{inset:20px;border-color:var(--gold)}
    #intro.leave{opacity:0;transform:scale(1.045);visibility:hidden;pointer-events:none}
    .intro-inner{max-width:460px;animation:rise 1.1s ease both .15s}
    .intro-rings{width:52px;height:auto;margin:0 auto 20px;color:var(--gold)}
    .intro-kicker{font-size:11px;letter-spacing:.4em;text-transform:uppercase;color:var(--mut);margin-bottom:20px}
    .intro-names{font-family:var(--script);font-size:clamp(56px,15vw,86px);line-height:1.1;color:var(--ink)}
    .flourish{width:min(220px,60%);height:auto;margin:6px auto 22px;display:block;color:var(--gold)}
    .flourish path{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 2.2s ease .6s forwards}
    .intro-line{font-style:italic;color:var(--mut);font-size:16px}
    .intro-date{margin:14px 0 34px;font-size:13px;letter-spacing:.3em;text-transform:uppercase;color:var(--blue)}
    #open-invite{animation:breathe 2.8s ease-in-out infinite}

    /* ---------- nav ---------- */
    .nav{
      position:fixed;top:0;left:0;right:0;z-index:40;
      display:flex;align-items:center;justify-content:space-between;
      padding:10px 20px;min-height:60px;
      background:rgba(251,249,244,.78);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
      border-bottom:1px solid var(--gold-soft);
    }
    .nav-mono{font-family:var(--script);font-size:26px;text-decoration:none;line-height:1;padding:8px 6px}
    .nav-mono em{font-style:normal;color:var(--gold)}
    .nav ul{display:flex;gap:4px;list-style:none}
    .nav ul a{
      display:inline-flex;align-items:center;min-height:44px;padding:8px 12px;
      text-decoration:none;font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--ink);
      border-bottom:1px solid transparent;transition:color .3s ease;
    }
    .nav ul a:hover{color:var(--gold)}

    /* ---------- hero ---------- */
    .hero{position:relative}
    .hero-art{position:relative;height:64svh;min-height:420px;overflow:hidden}
    .hero-art img{width:100%;height:100%;object-fit:cover}
    .hero-art::after{content:"";position:absolute;inset:auto 0 0 0;height:140px;background:linear-gradient(to bottom,transparent,var(--bg))}
    .petals{position:absolute;inset:0;pointer-events:none;overflow:hidden}
    .petal{
      position:absolute;top:0;width:12px;height:12px;border-radius:60% 40% 60% 40%;
      background:radial-gradient(circle at 30% 30%,#fff,var(--blush));
      animation:petalFall 11s linear infinite;opacity:0;
    }
    .petal:nth-child(1){left:8%;animation-delay:0s}
    .petal:nth-child(2){left:24%;width:9px;height:9px;animation-delay:3.5s;animation-duration:13s}
    .petal:nth-child(3){left:41%;animation-delay:6s;background:radial-gradient(circle at 30% 30%,#fff,#f6e6e0)}
    .petal:nth-child(4){left:58%;width:10px;height:10px;animation-delay:1.5s;animation-duration:12s}
    .petal:nth-child(5){left:72%;animation-delay:8s}
    .petal:nth-child(6){left:86%;width:8px;height:8px;animation-delay:4.8s;animation-duration:14s}
    .petal:nth-child(7){left:50%;width:11px;height:11px;animation-delay:10s;background:radial-gradient(circle at 30% 30%,#fff,#f2d9d1)}
    .plate{
      position:relative;z-index:2;margin:-96px auto 0;max-width:600px;
      background:var(--bg);border:1px solid var(--gold-soft);outline:1px solid var(--gold);outline-offset:-7px;
      padding:44px 28px 40px;text-align:center;
      box-shadow:0 24px 60px -30px rgba(58,63,69,.25);
    }
    .plate-names{
      font-family:var(--script);font-size:clamp(52px,13vw,84px);line-height:1.15;
      padding-bottom:.18em;
    }
    html.js .plate.rv:not(.in) .plate-names{clip-path:inset(0 0 100% 0)}
    html.js .plate.rv.in .plate-names{animation:curtain 1.3s cubic-bezier(.22,.7,.3,1) .25s both}
    .plate-date{margin-top:14px;font-size:13px;letter-spacing:.3em;text-transform:uppercase;color:var(--ink)}
    .plate-place{margin-top:6px;font-style:italic;color:var(--mut);font-size:15px}

    /* ---------- verses ---------- */
    .verse{background:var(--bg);text-align:center}
    .verse blockquote p{
      font-size:clamp(21px,4.6vw,27px);font-style:italic;line-height:1.6;color:var(--ink);
      max-width:560px;margin-inline:auto;
    }
    .verse cite{display:block;margin-top:16px;font-style:normal;font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--gold)}
    .verse-second{margin-top:40px}
    .verse-second p{font-size:18px;font-style:italic;color:var(--mut)}
    .verse-second cite{color:var(--blue);margin-top:10px}

    /* ---------- couple ---------- */
    .couple{background:var(--bg2)}
    .arch{
      width:min(320px,78vw);margin:0 auto 40px;overflow:hidden;
      border-radius:999px 999px 12px 12px;border:1px solid var(--gold);
      padding:10px;background:var(--bg);
    }
    .arch img{border-radius:990px 990px 8px 8px}
    .bios{display:grid;gap:34px;text-align:center}
    .bio-name{font-family:var(--script);font-size:44px;line-height:1.2}
    .bio-line{color:var(--mut);font-size:15.5px;max-width:420px;margin:8px auto 0}
    .bio-sep{width:44px;height:1px;background:var(--gold);margin-inline:auto}

    /* ---------- order of the day ---------- */
    .order-grid{display:grid;gap:20px}
    @media(min-width:600px){.order-grid{grid-template-columns:1fr 1fr}}
    .ocard{
      background:#fff;border:1px solid rgba(201,179,126,.28);padding:26px 22px;text-align:center;
      display:flex;flex-direction:column;align-items:center;gap:6px;
    }
    .ocard.hl{border:1px solid var(--gold);outline:1px solid var(--gold-soft);outline-offset:5px;background:linear-gradient(#fff,#fdfbf5)}
    .ocard img{width:84px;height:84px;margin-bottom:8px}
    .otime{font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);font-weight:500}
    .otitle{font-size:21px;font-weight:500}
    .oplace{font-size:14px;color:var(--blue);letter-spacing:.06em}
    .onote{font-style:italic;color:var(--mut);font-size:14.5px}

    /* ---------- venue ---------- */
    .venue{background:var(--bg2)}
    .vcards{display:grid;gap:20px;margin-bottom:26px}
    @media(min-width:600px){.vcards{grid-template-columns:1fr 1fr}}
    .vcard{background:var(--bg);border:1px solid var(--gold-soft);padding:30px 24px;text-align:center}
    .vkind{font-size:11px;letter-spacing:.34em;text-transform:uppercase;color:var(--gold);font-weight:500}
    .vname{font-size:22px;font-weight:500;margin-top:10px}
    .vaddr{color:var(--mut);font-size:15px;margin-top:6px}
    .vtime{margin-top:12px;font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:var(--blue)}
    .mapbox{border:1px solid var(--gold-soft);padding:6px;background:#fff}
    .mapbox iframe{display:block;width:100%;height:300px;border:0;filter:saturate(.82)}
    .venue .pill{margin-top:26px}
    .venue-actions{text-align:center}

    /* ---------- countdown ---------- */
    .count{text-align:center}
    .count-grid{display:flex;justify-content:center;gap:clamp(10px,4vw,28px)}
    .cunit{min-width:64px}
    .cnum{
      font-size:clamp(40px,10vw,64px);font-weight:500;line-height:1;color:var(--ink);
      font-variant-numeric:tabular-nums;
    }
    .clab{margin-top:10px;font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--mut)}
    .count-tag{margin-top:30px;font-family:var(--script);font-size:30px;color:var(--blue)}

    /* ---------- gallery ---------- */
    .gallery{background:var(--bg);padding-bottom:96px}
    .gscroll{
      display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;
      padding:8px max(24px,calc((100vw - 680px)/2)) 22px;
      scrollbar-width:thin;scrollbar-color:var(--gold) transparent;
    }
    .gitem{flex:0 0 auto;scroll-snap-align:center;margin:0}
    .gitem img{height:100%;width:auto;object-fit:cover;border:1px solid var(--gold-soft);padding:6px;background:#fff}
    .g1{height:300px}.g2{height:250px;align-self:flex-end}.g3{height:250px}.g4{height:300px;align-self:flex-end}
    .gitem figcaption{margin-top:10px;text-align:center;font-style:italic;font-size:13.5px;color:var(--mut)}

    /* ---------- candle wall ---------- */
    .candles{background:linear-gradient(180deg,var(--dusk) 0%,var(--dusk2) 100%);color:var(--bg2)}
    .candles .overline{color:var(--blush)}
    .candles .script-title{color:var(--bg)}
    .candles .sec-lede{color:rgba(244,239,228,.72);font-style:italic;max-width:440px;margin:14px auto 0;font-size:15.5px}
    .candle-wall{
      list-style:none;display:flex;flex-wrap:wrap;justify-content:center;align-items:flex-end;
      gap:30px 26px;margin:48px auto 52px;max-width:560px;min-height:130px;
    }
    .candle{position:relative;display:flex;flex-direction:column;align-items:center;width:74px;animation:pop .7s ease both}
    .flame{
      position:absolute;left:50%;top:-15px;width:11px;height:16px;transform:translateX(-50%);
      background:radial-gradient(circle at 50% 78%,#fff6d8 0%,#f6d67c 45%,rgba(230,150,60,.85) 78%,transparent 100%);
      border-radius:50% 50% 42% 42%/62% 62% 38% 38%;
      animation:flicker .58s ease-in-out infinite alternate;
    }
    .candle::before{
      content:"";position:absolute;left:50%;top:-30px;width:44px;height:44px;transform:translateX(-50%);
      background:radial-gradient(circle,rgba(246,214,124,.4),transparent 68%);
      border-radius:50%;animation:glow 1.4s ease-in-out infinite alternate;pointer-events:none;
    }
    .candle:nth-child(2n) .flame{animation-delay:.22s;animation-duration:.66s}
    .candle:nth-child(3n) .flame{animation-delay:.4s;animation-duration:.52s}
    .wax{
      width:15px;height:var(--h,58px);border-radius:7px 7px 3px 3px;
      background:linear-gradient(180deg,#FBF9F4,#E9E1CC);
      box-shadow:inset 0 -8px 12px rgba(58,63,69,.12);
    }
    .cname{margin-top:12px;font-size:12.5px;letter-spacing:.05em;color:rgba(244,239,228,.85);text-align:center;line-height:1.4}
    .candle-form{display:grid;gap:12px;max-width:440px;margin-inline:auto}
    .candle-form input,.candle-form .cbtn{width:100%}
    .cfield{
      min-height:50px;padding:12px 18px;border-radius:8px;font:inherit;font-size:15px;
      background:rgba(251,249,244,.07);border:1px solid rgba(201,179,126,.45);color:var(--bg);
    }
    .cfield::placeholder{color:rgba(244,239,228,.5)}
    .cbtn{
      min-height:52px;border:1px solid var(--gold);border-radius:8px;color:var(--gold);
      letter-spacing:.24em;text-transform:uppercase;font-size:12px;font-weight:500;
      transition:background .35s ease,color .35s ease;
    }
    .cbtn:hover{background:var(--gold);color:var(--dusk)}
    .candle-note{text-align:center;font-size:12.5px;color:rgba(244,239,228,.5);margin-top:16px;font-style:italic}

    /* ---------- rsvp ---------- */
    .rsvp-card{
      background:#fff;border:1px solid var(--gold);outline:1px solid var(--gold-soft);outline-offset:6px;
      padding:44px 26px;text-align:center;
    }
    .rsvp-form{display:grid;gap:16px;max-width:400px;margin:30px auto 0;text-align:left}
    .rsvp-form label{font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--mut);display:block;margin-bottom:8px}
    .rfield{
      width:100%;min-height:50px;padding:12px 16px;font:inherit;font-size:15.5px;color:var(--ink);
      background:var(--bg);border:1px solid rgba(201,179,126,.45);border-radius:6px;
    }
    textarea.rfield{min-height:96px;resize:vertical}
    .att-pills{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .att{
      min-height:48px;border:1px solid rgba(201,179,126,.45);border-radius:999px;
      font-size:13px;letter-spacing:.08em;color:var(--mut);transition:all .3s ease;padding:10px 8px;
    }
    .att[aria-pressed="true"]{background:var(--blue);border-color:var(--blue);color:#fff}
    .stepper{display:flex;align-items:center;gap:14px}
    .step-btn{
      width:48px;height:48px;border:1px solid var(--gold);border-radius:50%;
      font-size:22px;line-height:1;color:var(--ink);transition:background .3s ease,color .3s ease;
    }
    .step-btn:hover{background:var(--gold);color:#fff}
    .step-val{font-size:24px;font-weight:500;min-width:2.2ch;text-align:center;font-variant-numeric:tabular-nums}
    .rsvp-submit{
      min-height:52px;background:var(--ink);color:var(--bg);border-radius:999px;
      letter-spacing:.26em;text-transform:uppercase;font-size:12px;font-weight:500;transition:background .35s ease;
    }
    .rsvp-submit:hover{background:var(--blue)}
    .rsvp-deadline{margin-top:22px;font-style:italic;color:var(--mut);font-size:14px}
    #rsvp-thanks{animation:rise .8s ease both}
    #rsvp-thanks[hidden]{display:none}
    .thanks-rings{width:56px;margin:6px auto 18px;color:var(--gold)}
    .thanks-title{font-family:var(--script);font-size:40px;margin-bottom:10px}
    .thanks-msg{color:var(--mut);max-width:380px;margin:0 auto 26px}
    .change-btn{min-height:44px;text-decoration:underline;text-underline-offset:5px;color:var(--blue);letter-spacing:.08em;font-size:14px}

    /* ---------- footer ---------- */
    .foot{background:#5B6E7C;color:var(--bg2);text-align:center;padding:80px 24px 96px}
    .wreath{
      width:118px;height:118px;margin:0 auto 26px;border-radius:50%;
      border:1px solid rgba(251,249,244,.55);outline:1px solid rgba(251,249,244,.25);outline-offset:5px;
      display:flex;align-items:center;justify-content:center;
    }
    .wreath span{font-family:var(--script);font-size:44px;color:var(--bg)}
    .foot-names{font-family:var(--script);font-size:clamp(38px,9vw,52px);color:var(--bg)}
    .foot-date{margin-top:12px;font-size:12px;letter-spacing:.34em;text-transform:uppercase;color:rgba(244,239,228,.8)}
    .foot-tag{margin-top:20px;font-size:15px;letter-spacing:.12em;color:var(--blush)}
    .foot-love{margin-top:34px;font-style:italic;font-size:14.5px;color:rgba(244,239,228,.65)}

    /* ---------- music toggle ---------- */
    #music{
      position:fixed;right:18px;bottom:18px;z-index:45;width:52px;height:52px;border-radius:50%;
      background:rgba(251,249,244,.8);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
      border:1px solid var(--gold);display:flex;align-items:center;justify-content:center;gap:3px;
      box-shadow:0 8px 24px -10px rgba(58,63,69,.35);
    }
    #music .bar{width:3px;height:16px;border-radius:2px;background:var(--gold);transform-origin:bottom;animation:eq .5s ease-in-out infinite alternate}
    #music .bar:nth-child(2){animation-delay:.16s;height:20px}
    #music .bar:nth-child(3){animation-delay:.32s;height:13px}
    #music.muted .bar{animation-play-state:paused;transform:scaleY(.28);background:var(--mut)}

    @media (prefers-reduced-motion:reduce){
      *,*::before,*::after{
        animation-duration:.01ms !important;animation-iteration-count:1 !important;
        transition-duration:.01ms !important;scroll-behavior:auto !important;
      }
      html.js .rv{opacity:1;transform:none}
    }
  </style>
</head>

<body class="locked">

  <svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <defs>
      <symbol id="rings" viewBox="0 0 64 44">
        <circle cx="24" cy="24" r="15" fill="none" stroke="currentColor" stroke-width="2"/>
        <circle cx="40" cy="20" r="15" fill="none" stroke="currentColor" stroke-width="2"/>
        <path d="M38 4l2-3 2 3-2 3z" fill="currentColor"/>
      </symbol>
    </defs>
  </svg>

  <!-- 1 · intro overlay -->
  <div id="intro" role="dialog" aria-modal="true" aria-label="Wedding invitation for Joel and Merin">
    <div class="intro-inner">
