---
import '@fontsource/cormorant/400.css';
import '@fontsource/cormorant/500.css';
import '@fontsource/cormorant-infant/400.css';
import '@fontsource/cormorant-upright/400.css';
import '@fontsource/cormorant-unicase/400.css';
import '@fontsource/gotu/400.css';
import '@fontsource/manrope/600.css';

/* ── The Mountain — a moonlit pahadi shaadi, night to day in one scroll ── */

const title = 'Vihaan & Anaya — March 8, 2027';
const description =
  'With the heavenly blessings of our families — Vihaan & Anaya invite you to their wedding celebrations. The Deodar Palace, Mussoorie · March 5–9, 2027.';

const MAPS = 'https://maps.google.com/?q=Mussoorie,+Uttarakhand';
const RSVP = 'https://wa.me/919999999999?text=' + encodeURIComponent('We would love to join Vihaan & Anaya in Mussoorie! RSVP from: ');
const INSTAGRAM = 'https://instagram.com/invitivals.in';
const SHAADI_ISO = '2027-03-08T18:00:00+05:30';

const events = [
  { key: 'mehendi',   name: 'Mehendi',     date: 'Friday, March 5th 2027',   venue: 'The Deodar Palace, Mussoorie', time: '4pm Onwards' },
  { key: 'haldi',     name: 'Haldi',       date: 'Saturday, March 6th 2027', venue: 'The Deodar Palace, Mussoorie', time: '10am Onwards' },
  { key: 'cocktail',  name: 'Cocktail',    date: 'Saturday, March 6th 2027', venue: 'The Deodar Palace, Mussoorie', time: '7pm Onwards' },
  { key: 'prewed',    name: 'Pre-Wedding', date: 'Sunday, March 7th 2027',   venue: 'The Deodar Palace, Mussoorie', time: '6pm Onwards' },
  { key: 'shaadi',    name: 'Shaadi',      date: 'Monday, March 8th 2027',   venue: 'The Deodar Palace, Mussoorie', time: '6pm Onwards' },
  { key: 'reception', name: 'Reception',   date: 'Tuesday, March 9th 2027',  venue: 'The Deodar Palace, Mussoorie', time: '7pm Onwards' },
];

const know = [
  { key: 'hashtag', head: 'Hashtag', body: 'While posting photos and stories on social media, please use our hashtag — #AnayaWedsVihaan' },
  { key: 'weather', head: 'Weather', body: 'March evenings in the hills dip to about 8°C — do carry a shawl or a smart jacket for the outdoor functions' },
  { key: 'staff',   head: 'Staff',   body: 'Comfortable rooms for accompanying staff and drivers are arranged at Cedar Lodge, two minutes from the venue' },
  { key: 'parking', head: 'Parking', body: 'Valet parking will be available at the main gate of the venue for all our guests' },
];

/* star field: top%, left%, scale, delay(s) */
const stars = [
  [6, 12, 1, 0], [9, 74, 0.7, 0.9], [14, 40, 0.55, 1.6], [18, 88, 0.9, 0.4],
  [22, 8, 0.6, 2.1], [26, 58, 1, 1.2], [31, 26, 0.7, 0.2], [34, 80, 0.55, 1.8],
  [42, 14, 0.8, 0.7], [46, 66, 0.6, 2.4], [54, 36, 0.9, 1.1], [58, 90, 0.7, 0.5],
  [66, 20, 0.55, 1.4], [72, 72, 0.8, 2.0], [80, 46, 0.6, 0.8], [86, 10, 0.9, 1.7],
];

const poms = Array.from({ length: 12 }, (_, i) => i);
const pines = Array.from({ length: 13 }, (_, i) => i);

const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="32" fill="#022938"/><path d="M40 12 a20 20 0 1 0 12 30 a16 16 0 1 1 -12 -30 Z" fill="#c9b06a"/><circle cx="44" cy="20" r="2" fill="#c9b06a"/></svg>'
  );
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#022938" />
    <link rel="icon" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/art/mountain/hero.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>

  <body>
    <!-- ── shared svg defs ─────────────────────────────────────────── -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="archsky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#04374a"></stop>
          <stop offset="1" stop-color="#11576a"></stop>
        </linearGradient>
        <radialGradient id="moonglow" cx="0.5" cy="0.5" r="0.5">
          <stop offset="0" stop-color="#f3e9d2" stop-opacity=".45"></stop>
          <stop offset="1" stop-color="#f3e9d2" stop-opacity="0"></stop>
        </radialGradient>
        <path
          id="archp"
          d="M28 332 V168 Q28 112 62 84 Q78 71 88 56 Q100 38 112 32 Q122 27 126 16 L130 8 L134 16 Q138 27 148 32 Q160 38 172 56 Q182 71 198 84 Q232 112 232 168 V332 Z"
        ></path>
        <clipPath id="archclip">
          <path
            d="M28 332 V168 Q28 112 62 84 Q78 71 88 56 Q100 38 112 32 Q122 27 126 16 L130 8 L134 16 Q138 27 148 32 Q160 38 172 56 Q182 71 198 84 Q232 112 232 168 V332 Z"
          ></path>
        </clipPath>
        <path
          id="cloudp"
          d="M14 58 Q0 54 4 42 Q-2 28 16 26 Q20 8 42 12 Q52 -4 72 6 Q94 -2 100 18 Q120 18 116 38 Q126 52 108 58 Q104 64 92 62 L26 62 Q16 64 14 58 Z"
        ></path>
        <g id="starp">
          <path d="M0 -9 L2.2 -2.2 L9 0 L2.2 2.2 L0 9 L-2.2 2.2 L-9 0 L-2.2 -2.2 Z"></path>
        </g>
        <g id="pinep">
          <path d="M14 0 L26 26 L20 24 L29 46 L21 44 L28 62 L0 62 L7 44 L-1 46 L8 24 L2 26 Z"></path>
          <rect x="11" y="62" width="6" height="9" rx="1"></rect>
        </g>
        <g id="palaceg">
          <g stroke="#97854f" stroke-width="2">
            <rect x="10" y="96" width="220" height="22" fill="#efe2c4"></rect>
            <rect x="60" y="38" width="120" height="58" fill="#f1e4c8"></rect>
            <path d="M120 -22 Q88 -8 92 38 L148 38 Q152 -8 120 -22 Z" fill="#c9a24b"></path>
            <path d="M120 -22 L120 -40" stroke-linecap="round"></path>
            <path d="M120 -40 L136 -34 L120 -28 Z" fill="#b0533b" stroke="none"></path>
            <rect x="20" y="26" width="34" height="70" fill="#f1e4c8"></rect>
            <rect x="186" y="26" width="34" height="70" fill="#f1e4c8"></rect>
            <path d="M37 8 Q24 14 24 26 L50 26 Q50 14 37 8 Z" fill="#c9a24b"></path>
            <path d="M203 8 Q190 14 190 26 L216 26 Q216 14 203 8 Z" fill="#c9a24b"></path>
          </g>
          <g fill="#0c4860">
            <path d="M84 96 v-20 q0 -12 12 -12 q12 0 12 12 v20 Z"></path>
            <path d="M132 96 v-20 q0 -12 12 -12 q12 0 12 12 v20 Z"></path>
            <rect x="31" y="52" width="12" height="20" rx="6"></rect>
            <rect x="197" y="52" width="12" height="20" rx="6"></rect>
          </g>
          <g fill="#c9a24b">
            <circle cx="96" cy="70" r="2"></circle>
            <circle cx="144" cy="70" r="2"></circle>
          </g>
        </g>
      </defs>
    </svg>

    <div class="page" id="top">
      <!-- soft damask wallpaper over the night sky -->
      <div class="damask" aria-hidden="true"></div>

      <!-- ── HERO — names under the sleeping moon ────────────────────── -->
      <header class="hero">
        <div class="stars" aria-hidden="true">
          {stars.map(([t, l, s, d]) => (
            <svg class="star" viewBox="-10 -10 20 20" style={`top:${t}%;left:${l}%;--s:${s};--d:${d}s`}>
              <use href="#starp" fill="#e8d9a8"></use>
            </svg>
          ))}
        </div>

        <svg class="garl left" viewBox="0 0 36 780" preserveAspectRatio="xMidYMin meet" aria-hidden="true">
          {poms.map((i) => (
            <g transform={`translate(18 ${24 + i * 64})`}>
              <circle r="11" fill={i % 2 ? '#e4b33c' : '#e8952f'}></circle>
              <circle r="6.5" fill="none" stroke={i % 2 ? '#bd8f22' : '#c9741d'} stroke-width="2" stroke-dasharray="2 3"></circle>
              <ellipse cx="-8" cy="32" rx="8" ry="3.6" fill="#4c7a55" transform="rotate(-26 -8 32)"></ellipse>
              <ellipse cx="8" cy="32" rx="8" ry="3.6" fill="#4c7a55" transform="rotate(26 8 32)"></ellipse>
            </g>
          ))}
        </svg>
        <svg class="garl right" viewBox="0 0 36 780" preserveAspectRatio="xMidYMin meet" aria-hidden="true">
          {poms.map((i) => (
            <g transform={`translate(18 ${24 + i * 64})`}>
              <circle r="11" fill={i % 2 ? '#e8952f' : '#e4b33c'}></circle>
              <circle r="6.5" fill="none" stroke={i % 2 ? '#c9741d' : '#bd8f22'} stroke-width="2" stroke-dasharray="2 3"></circle>
              <ellipse cx="-8" cy="32" rx="8" ry="3.6" fill="#4c7a55" transform="rotate(-26 -8 32)"></ellipse>
              <ellipse cx="8" cy="32" rx="8" ry="3.6" fill="#4c7a55" transform="rotate(26 8 32)"></ellipse>
            </g>
          ))}
        </svg>

        <div class="moon-wrap" data-plx="0.06" aria-hidden="true">
          <svg class="moon float" viewBox="0 0 140 140">
            <circle cx="70" cy="70" r="70" fill="url(#moonglow)"></circle>
            <mask id="cres">
              <rect width="140" height="140" fill="#fff"></rect>
              <circle cx="100" cy="50" r="46" fill="#000"></circle>
            </mask>
            <circle cx="70" cy="70" r="46" fill="#f3e9d2" mask="url(#cres)"></circle>
            <path d="M40 72 Q47 79 54 72" stroke="#b9a77f" stroke-width="2.6" fill="none" stroke-linecap="round"></path>
            <path d="M39 79 l-3 4 M46 81 l-1 5 M53 79 l2 5" stroke="#b9a77f" stroke-width="1.8" stroke-linecap="round"></path>
            <path d="M46 92 Q52 97 59 92" stroke="#b9a77f" stroke-width="2.6" fill="none" stroke-linecap="round"></path>
            <circle cx="36" cy="88" r="4.5" fill="#e8c9a8" opacity=".75"></circle>
          </svg>
        </div>

        <svg class="cloud c1 drift" viewBox="-4 -6 134 74" aria-hidden="true"><use href="#cloudp" fill="#f2eada" opacity=".92"></use></svg>
        <svg class="cloud c2 drift slow" viewBox="-4 -6 134 74" aria-hidden="true"><use href="#cloudp" fill="#e9dfc8" opacity=".8"></use></svg>

        <h1 class="hero-names rv in">
          <span class="groom f-inf">Vihaan</span>
          <span class="weds f-uni">weds</span>
          <span class="bride f-upr">Anaya</span>
        </h1>

        <svg class="cloud c3 drift" viewBox="-4 -6 134 74" aria-hidden="true"><use href="#cloudp" fill="#f2eada" opacity=".9"></use></svg>

        <div class="palace-wrap" data-plx="-0.04" aria-hidden="true">
          <svg class="palace float slow" viewBox="-60 -60 360 260">
            <use href="#cloudp" transform="translate(-52 96) scale(2.9 2.2)" fill="#f2eada" opacity=".95"></use>
            <use href="#palaceg"></use>
          </svg>
        </div>
      </header>

      <!-- ── INVITE ──────────────────────────────────────────────────── -->
      <section class="invite" aria-label="Invitation">
        <p class="mantra rv" lang="hi">ॐ श्री गणेशाय नमः</p>

        <div class="bless rv">
          <p>With the heavenly blessings of</p>
          <p class="bless-names">Smt. Kaushalya Devi &amp; Shri Devraj Sharma</p>
          <p class="dashes" aria-hidden="true">——</p>
          <p class="bless-names">Mrs. Nirmala &amp; Mr. Arvind Sharma</p>
        </div>

        <h2 class="big-invite f-inf rv">INVITE</h2>

        <p class="line rv">You to join us in the wedding celebrations of</p>

        <div class="pair rv">
          <div class="p-name f-upr">Vihaan</div>
          <div class="p-amp f-uni" aria-hidden="true">&amp;</div>
          <div class="p-name f-cor">Anaya</div>
        </div>

        <p class="line rv">Daughter of</p>
        <p class="bless-names rv">Mrs. Sunita &amp; Mr. Rakesh Malhotra,</p>

        <p class="line onfollow rv">On the following events</p>

        <svg class="mrange" viewBox="0 0 750 170" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
          <path d="M0 120 L90 55 L150 95 L235 38 L310 100 L390 52 L470 108 L560 42 L640 98 L750 50 L750 170 L0 170 Z" fill="#0b4552" opacity=".85"></path>
          <path d="M235 38 L262 66 L249 62 L235 76 L221 62 L208 66 Z" fill="#efe6d2" opacity=".9"></path>
          <path d="M560 42 L586 68 L574 64 L560 78 L546 64 L534 68 Z" fill="#efe6d2" opacity=".9"></path>
          <path d="M0 148 L80 92 L170 142 L290 78 L420 148 L540 88 L660 146 L750 100 L750 170 L0 170 Z" fill="#083a44"></path>
          <use href="#pinep" transform="translate(120 108) scale(.62)" fill="#062f38"></use>
          <use href="#pinep" transform="translate(430 112) scale(.55)" fill="#062f38"></use>
          <use href="#pinep" transform="translate(600 106) scale(.66)" fill="#062f38"></use>
        </svg>
      </section>

      <!-- ── EVENTS ──────────────────────────────────────────────────── -->
      <section class="events" aria-label="Wedding events">
        <div class="balloon-wrap" data-plx="0.05" aria-hidden="true">
          <svg class="balloon sway" viewBox="0 0 90 132">
            <path d="M45 4 C70 4 82 27 82 50 C82 76 62 91 45 95 C28 91 8 76 8 50 C8 27 20 4 45 4 Z" fill="#c9a24b"></path>
            <path d="M45 4 C57 4 63 27 63 50 C63 76 54 91 45 95 C36 91 27 76 27 50 C27 27 33 4 45 4 Z" fill="#0f5b66"></path>
            <path d="M45 4 C50 4 53 27 53 50 C53 76 49 91 45 95 C41 91 37 76 37 50 C37 27 40 4 45 4 Z" fill="#e8952f"></path>
            <path d="M26 92 L34 112 M64 92 L56 112 M45 95 L45 112" stroke="#8a6b3f" stroke-width="2"></path>
            <rect x="33" y="112" width="24" height="16" rx="3" fill="#8a6b3f"></rect>
            <path d="M33 118 h24 M41 112 v16 M49 112 v16" stroke="#6f5531" stroke-width="1.4"></path>
          </svg>
        </div>

        {events.map((e, i) => (
          <article class={`event rv ${i % 2 ? 'ev-r' : 'ev-l'}`} id={e.key}>
            <div class="ev-art">
              <svg viewBox="0 0 260 340" role="img" aria-label={`${e.name} illustration`}>
                <use href="#archp" fill="url(#archsky)" stroke="#ac9545" stroke-width="2.5"></use>
                <path
                  d="M20 336 V166 Q20 106 56 77 Q73 63 83 49 Q96 30 109 24 Q120 19 124 8 L130 -2 L136 8 Q140 19 151 24 Q164 30 177 49 Q187 63 204 77 Q240 106 240 166 V336"
                  fill="none" stroke="#ac9545" stroke-width="1.2" opacity=".75"
                ></path>
                <circle cx="130" cy="2" r="3" fill="#c9b06a"></circle>

                <g clip-path="url(#archclip)">
                  <use href="#starp" transform="translate(60 60) scale(.7)" fill="#e8d9a8" opacity=".7"></use>
                  <use href="#starp" transform="translate(206 82) scale(.55)" fill="#e8d9a8" opacity=".55"></use>
                  <use href="#starp" transform="translate(178 46) scale(.4)" fill="#e8d9a8" opacity=".8"></use>

                  {e.key === 'mehendi' && (
                    <g>
                      <rect x="116" y="142" width="28" height="86" rx="14" fill="#e7b98b"></rect>
                      <rect x="92" y="158" width="24" height="72" rx="12" fill="#e7b98b"></rect>
                      <rect x="144" y="158" width="24" height="72" rx="12" fill="#e7b98b"></rect>
                      <path d="M92 236 q-22 -4 -22 -26 q0 -16 13 -16 q11 0 11 15 Z" fill="#e7b98b"></path>
                      <path d="M168 236 q22 -4 22 -26 q0 -16 -13 -16 q-11 0 -11 15 Z" fill="#e7b98b"></path>
                      <path d="M92 214 h76 q12 10 12 30 q0 40 -50 40 q-50 0 -50 -40 q0 -20 12 -30 Z" fill="#e7b98b"></path>
                      <circle cx="130" cy="252" r="18" fill="none" stroke="#c9741d" stroke-width="2"></circle>
                      <circle cx="130" cy="252" r="11" fill="none" stroke="#c9741d" stroke-width="1.5" stroke-dasharray="2 3"></circle>
                      <circle cx="130" cy="252" r="4" fill="#c9741d"></circle>
                      <circle cx="104" cy="176" r="2.2" fill="#c9741d"></circle>
                      <circle cx="130" cy="160" r="2.2" fill="#c9741d"></circle>
                      <circle cx="156" cy="176" r="2.2" fill="#c9741d"></circle>
                      <path d="M104 196 q0 8 0 12 M130 182 q0 8 0 12 M156 196 q0 8 0 12" stroke="#c9741d" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-dasharray="1 4"></path>
                      <path d="M96 224 q34 12 68 0" stroke="#c9741d" stroke-width="1.6" fill="none"></path>
                      <circle cx="106" cy="266" r="2" fill="#c9741d"></circle>
                      <circle cx="154" cy="266" r="2" fill="#c9741d"></circle>
                      <path d="M118 288 q12 8 24 0" stroke="#c9741d" stroke-width="1.6" fill="none" stroke-linecap="round"></path>
                      <path d="M84 300 q46 18 92 0" stroke="#c9741d" stroke-width="2" fill="none" stroke-linecap="round" opacity=".7"></path>
                      <ellipse cx="74" cy="180" rx="9" ry="4" fill="#4c7a55" transform="rotate(-30 74 180)"></ellipse>
                      <ellipse cx="192" cy="150" rx="9" ry="4" fill="#4c7a55" transform="rotate(24 192 150)"></ellipse>
                    </g>
                  )}

                  {e.key === 'haldi' && (
                    <g>
                      <path d="M130 60 v36" stroke="#c9a24b" stroke-width="1.6"></path>
                      <circle cx="130" cy="66" r="4" fill="#e8952f"></circle>
                      <circle cx="130" cy="78" r="4" fill="#e4b33c"></circle>
                      <circle cx="130" cy="90" r="4" fill="#e8952f"></circle>
                      <path d="M76 238 q0 -22 22 -24 q6 -12 20 -10 q8 -12 24 -8 q16 -4 22 8 q16 0 18 16 q4 8 -4 18 Z" fill="#e4b33c"></path>
                      <path d="M70 238 h120 q4 0 4 6 q0 10 -12 12 q-8 26 -52 26 q-44 0 -52 -26 q-12 -2 -12 -12 q0 -6 4 -6 Z" fill="#c9a24b" stroke="#97854f" stroke-width="1.6"></path>
                      <path d="M96 262 q34 10 68 0" stroke="#97854f" stroke-width="1.4" fill="none" opacity=".6"></path>
                      <ellipse cx="86" cy="206" rx="7" ry="3.4" fill="#e8952f" transform="rotate(-24 86 206)"></ellipse>
                      <ellipse cx="182" cy="196" rx="7" ry="3.4" fill="#e8952f" transform="rotate(28 182 196)"></ellipse>
                      <ellipse cx="160" cy="300" rx="8" ry="3.6" fill="#e8952f" transform="rotate(12 160 300)"></ellipse>
                      <path d="M92 306 q6 -10 18 -6 q4 -8 12 -4" stroke="#d9a13a" stroke-width="7" fill="none" stroke-linecap="round"></path>
                    </g>
                  )}

                  {e.key === 'cocktail' && (
                    <g stroke="#d9c078" stroke-width="2.4" fill="none" stroke-linecap="round">
                      <g transform="rotate(-10 105 210)">
                        <path d="M75 172 L105 208 L135 172 Z" fill="#0d4b5c"></path>
                        <path d="M105 208 V252 M87 254 Q105 248 123 254"></path>
                        <path d="M82 180 q23 12 46 0" stroke-width="1.6" opacity=".8"></path>
                        <circle cx="98" cy="184" r="4.5" fill="#b0533b" stroke="none"></circle>
                      </g>
                      <g transform="rotate(10 158 210)">
                        <path d="M128 172 L158 208 L188 172 Z" fill="#0d4b5c"></path>
                        <path d="M158 208 V252 M140 254 Q158 248 176 254"></path>
                        <path d="M135 180 q23 12 46 0" stroke-width="1.6" opacity=".8"></path>
                        <circle cx="168" cy="184" r="3.5" fill="#e4b33c" stroke="none"></circle>
                      </g>
                      <use href="#starp" transform="translate(131 152) scale(.9)" fill="#e8d9a8" stroke="none"></use>
                      <circle cx="118" cy="140" r="2" fill="#e8d9a8" stroke="none"></circle>
                      <circle cx="146" cy="132" r="2.6" fill="#e8d9a8" stroke="none"></circle>
                      <path d="M96 292 h68" stroke-width="1.4" opacity=".5"></path>
                    </g>
                  )}

                  {e.key === 'prewed' && (
                    <g>
                      <path d="M96 306 L88 330 M164 306 L172 330 M130 308 V330" stroke="#d9c078" stroke-width="2.4" stroke-linecap="round"></path>
                      <rect x="80" y="196" width="100" height="70" rx="12" fill="#0f5b66" stroke="#d9c078" stroke-width="2.4"></rect>
                      <rect x="106" y="184" width="30" height="14" rx="4" fill="#0f5b66" stroke="#d9c078" stroke-width="2"></rect>
                      <circle cx="130" cy="231" r="22" fill="#04374a" stroke="#d9c078" stroke-width="2.4"></circle>
                      <circle cx="130" cy="231" r="12" fill="none" stroke="#d9c078" stroke-width="1.6"></circle>
                      <path d="M124 224 a9 9 0 0 1 6 -3" stroke="#e8d9a8" stroke-width="2" fill="none" stroke-linecap="round"></path>
                      <circle cx="164" cy="212" r="4" fill="#e8952f"></circle>
                      <path d="M130 160 q-7 -11 -15 -3 q-7 8 15 22 q22 -14 15 -22 q-8 -8 -15 3 Z" fill="#b0533b"></path>
                      <use href="#starp" transform="translate(94 168) scale(.6)" fill="#e8d9a8"></use>
                    </g>
                  )}

                  {e.key === 'shaadi' && (
                    <g>
                      <rect x="62" y="160" width="11" height="130" rx="4" fill="#c9a24b"></rect>
                      <rect x="187" y="160" width="11" height="130" rx="4" fill="#c9a24b"></rect>
                      <path d="M50 158 Q130 200 210 158 L210 142 Q130 186 50 142 Z" fill="#b0533b" stroke="#c9a24b" stroke-width="1.6"></path>
                      <path d="M84 172 q0 26 0 34 M130 184 q0 22 0 30 M176 172 q0 26 0 34" stroke="#e8952f" stroke-width="4.5" stroke-dasharray="0.5 8" stroke-linecap="round" fill="none"></path>
                      <path d="M116 290 q0 -18 14 -18 q14 0 14 18 q-4 6 -14 6 q-10 0 -14 -6 Z" fill="#c9a24b"></path>
                      <circle cx="130" cy="266" r="7" fill="#8a5a2b"></circle>
                      <path d="M124 262 l-8 -8 M130 260 v-11 M136 262 l8 -8" stroke="#4c7a55" stroke-width="3" stroke-linecap="round"></path>
                      <path d="M78 298 q4 -10 8 0 q-4 4 -8 0 Z" fill="#e8952f"></path>
                      <path d="M174 298 q4 -10 8 0 q-4 4 -8 0 Z" fill="#e8952f"></path>
                      <path d="M70 302 h120" stroke="#d9c078" stroke-width="1.4" opacity=".5"></path>
                    </g>
