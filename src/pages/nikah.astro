    g.gain.exponentialRampToValueAtTime(0.0001, t + 3.6); /* long exponential decay */
    o.connect(g); g.connect(bus);
    o.start(t); o.stop(t + 3.8);
  }

  function scheduleNotes() {
    pluck();
    if (Math.random() < 0.3) setTimeout(pluck, 240 + Math.random() * 160);
    noteTimer = setTimeout(scheduleNotes, 1500 + Math.random() * 2300);
  }

  muteBtn.addEventListener('click', function () {
    muted = !muted;
    muteBtn.classList.toggle('off', muted);
    muteBtn.setAttribute('aria-pressed', String(muted));
    muteBtn.setAttribute('aria-label', muted ? 'Unmute music' : 'Mute music');
    if (!actx) { if (!muted) startMusic(); return; }
    if (muted) { actx.suspend(); } else { actx.resume(); }
  });

  /* ---------- Intro overlay ---------- */
  var intro = d.getElementById('intro');
  var openBtn = d.getElementById('openBtn');
  openBtn.addEventListener('click', function () {
    intro.classList.add('open');
    d.body.classList.remove('locked');
    startMusic();
    setTimeout(function () { intro.classList.add('gone'); }, 1350);
  });

  /* ---------- Countdown ---------- */
  var TARGET = new Date('2026-12-18T16:00:00+05:30').getTime();
  var cdD = d.getElementById('cdD'), cdH = d.getElementById('cdH'),
      cdM = d.getElementById('cdM'), cdS = d.getElementById('cdS');
  function pad(n) { return String(n).padStart(2, '0'); }
  var cdTimer = null;
  function tick() {
    var diff = TARGET - Date.now();
    if (diff <= 0) {
      cdD.textContent = cdH.textContent = cdM.textContent = cdS.textContent = '00';
      if (cdTimer) clearInterval(cdTimer);
      return;
    }
    cdD.textContent = pad(Math.floor(diff / 864e5));
    cdH.textContent = pad(Math.floor(diff / 36e5) % 24);
    cdM.textContent = pad(Math.floor(diff / 6e4) % 60);
    cdS.textContent = pad(Math.floor(diff / 1e3) % 60);
  }
  tick();
  cdTimer = setInterval(tick, 1000);

  /* ---------- Duas & wishes wall ---------- */
  var wform = d.getElementById('wform');
  var winp = d.getElementById('winp');
  var wlist = d.getElementById('wlist');
  wform.addEventListener('submit', function (e) {
    e.preventDefault();
    var text = winp.value.trim();
    if (!text) { winp.focus(); return; }
    var card = d.createElement('article');
    card.className = 'wcard mine pop';
    var p = d.createElement('p');
    p.textContent = text;
    var f = d.createElement('footer');
    f.textContent = '— You · just now';
    card.appendChild(p); card.appendChild(f);
    wlist.insertBefore(card, wlist.firstChild);
    winp.value = '';
    winp.focus();
  });

  /* ---------- RSVP (local only) ---------- */
  var attending = true, guests = 2;
  var accY = d.getElementById('accY'), accN = d.getElementById('accN');
  var stDown = d.getElementById('stDown'), stUp = d.getElementById('stUp'), stN = d.getElementById('stN');
  var rname = d.getElementById('rname'), rnote = d.getElementById('rnote');
  var rsvpForm = d.getElementById('rsvpForm'), rsvpDone = d.getElementById('rsvpDone');
  var doneHead = d.getElementById('doneHead'), doneMsg = d.getElementById('doneMsg');

  function setAttending(v) {
    attending = v;
    accY.classList.toggle('sel', v);
    accN.classList.toggle('sel', !v);
    accY.setAttribute('aria-pressed', String(v));
    accN.setAttribute('aria-pressed', String(!v));
  }
  accY.addEventListener('click', function () { setAttending(true); });
  accN.addEventListener('click', function () { setAttending(false); });

  function setGuests(n) {
    guests = Math.min(8, Math.max(1, n));
    stN.textContent = String(guests);
    stDown.disabled = guests <= 1;
    stUp.disabled = guests >= 8;
  }
  stDown.addEventListener('click', function () { setGuests(guests - 1); });
  stUp.addEventListener('click', function () { setGuests(guests + 1); });
  setGuests(2);

  d.getElementById('rsend').addEventListener('click', function () {
    var name = rname.value.trim();
    if (!name) { rname.classList.add('err'); rname.focus(); return; }
    rname.classList.remove('err');
    doneHead.textContent = 'JazakAllah khair, ' + name;
    doneMsg.textContent = attending
      ? 'We look forward to welcoming ' + (guests === 1 ? 'you' : 'your party of ' + guests) +
        ' at the Nikah on Friday, December 18, 2026. Your reply has been noted with love.'
      : 'You will be dearly missed — thank you for letting us know. Our duas travel with you.';
    rsvpForm.hidden = true;
    rsvpDone.hidden = false;
    doneHead.focus();
  });
  d.getElementById('rEdit').addEventListener('click', function () {
    rsvpDone.hidden = true;
    rsvpForm.hidden = false;
    rname.focus();
  });

  rname.addEventListener('input', function () { rname.classList.remove('err'); });
})();
</script>
