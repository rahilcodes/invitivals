---
import '@fontsource/noto-serif-telugu/telugu-400.css';
import '@fontsource/noto-serif-devanagari/devanagari-400.css';
import '@fontsource/noto-nastaliq-urdu/arabic-400.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import InviteCard from '../components/site/InviteCard.astro';
import Plans from '../components/site/Plans.astro';
import Timeline from '../components/site/Timeline.astro';
import {
  WA, SITE, STUDIO, SAMPLE, MOMENTS, TRADITIONS, LANGS, HOW, PROMISE, QUOTES, FAQS, CTAS,
} from '../data/site';
import { DESIGNS, LIVE_OCCASIONS, byId, designUrl } from '../data/designs';

const title = 'Digital Wedding Invitations for WhatsApp, Made by Hand | Invitivals';
const description =
  'Digital invitations made by hand for Indian celebrations: Telugu and Hindu weddings, Nikah, Christian weddings, engagement, Aqeeqah and Gruhapravesha. Opened from WhatsApp, ready in 48 hours.';

const jsonLd = [
  {
    '@type': 'WebSite',
    name: 'Invitivals',
    url: SITE + '/',
    description,
    inLanguage: 'en-IN',
    publisher: { '@id': `${SITE}/#studio` },
  },
  {
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

// the home page shows the first few; the rest are on /invitations/
const FEATURED = DESIGNS.slice(0, 8);

// clip-path, x, y, rotation, delay — the five pieces the seal breaks into
const SHARDS = [
  ['polygon(0 0, 52% 0, 47% 38%, 30% 55%, 0 45%)', -44, -30, -22, 0],
  ['polygon(52% 0, 100% 0, 100% 40%, 70% 50%, 47% 38%)', 44, -26, 18, 0.08],
  ['polygon(0 45%, 30% 55%, 45% 100%, 0 100%)', -38, 34, -12, 0.16],
  ['polygon(30% 55%, 47% 38%, 70% 50%, 62% 100%, 45% 100%)', 4, 48, 6, 0.04],
  ['polygon(70% 50%, 100% 40%, 100% 100%, 62% 100%)', 44, 32, 14, 0.12],
];
// left %, delay, size, drift
const PETALS = [[6, 0, 9, 18], [22, 1.4, 11, -26], [38, 2.6, 8, 30], [55, 0.8, 10, -18], [70, 3.2, 9, 24], [84, 1.9, 7, -32], [14, 4.1, 8, 20], [62, 4.8, 11, -22], [90, 3.6, 8, 28], [30, 5.4, 9, -16], [48, 6.2, 10, 22], [76, 7.1, 8, -20]];
const PETAL_COLORS = ['#D9A5A0', '#CBB48B', '#E7C1B4', '#D9A5A0'];

const heroPetal = (p: number[], i: number) =>
  `left:${p[0]}%;width:${p[2]}px;height:${p[2] * 1.5}px;background:${PETAL_COLORS[i % 4]};--dx:${p[3]}px;--dy:420px;--rot:${p[3] * 6}deg;animation-duration:${6 + (i % 3)}s;animation-delay:${p[1]}s`;
const driftPetal = (p: number[], i: number) =>
  `left:${p[0]}%;top:${(i * 11) % 80}%;width:${p[2] * 1.4}px;height:${p[2] * 2.1}px;background:${PETAL_COLORS[i % 4]};--dx:${p[3] * 3}px;--dy:520px;--rot:${p[3] * 7}deg;animation-duration:${14 + (i % 4) * 3}s;animation-delay:${p[1] * 1.5}s`;

// real invitations fanned behind the sealed one
const HERO_LEFT = ['/showcase/previews/telugu-wedding-door.webp', '/showcase/previews/gruhapravesha-door.webp', '/showcase/previews/christian-wedding-door.webp'];
const HERO_RIGHT = ['/showcase/previews/nikah.webp', '/showcase/previews/aqeeqah-door.webp', '/showcase/previews/telugu-wedding.webp'];

const langFont: Record<string, string> = {
  TE: "'Noto Serif Telugu', serif",
  HI: "'Noto Serif Devanagari', serif",
  UR: "'Noto Nastaliq Urdu', serif",
  EN: 'inherit',
};
---

<SiteLayout title={title} description={description} jsonLd={jsonLd} bar>
  <!-- ══════════════ HERO ══════════════ -->
  <section id="top" class="hero on-green" data-cta="top">
    <span class="hero-frame" aria-hidden="true"></span>
    <div class="petals" data-depth="0.05" aria-hidden="true">
      {PETALS.slice(2, 10).map((p, i) => <i style={driftPetal(p, i)} />)}
    </div>

    <div class="wrap hero-in">
      <div class="hero-copy">
        <span class="eyebrow">Digital invitations, made by hand for Indian celebrations</span>
        <h1>The first moment of your wedding happens <em>on a phone.</em></h1>
        <p>
          Before the mandap, the music, or the first garland, your guests open a link. We make that moment feel
          like the celebration has already begun.
        </p>
        <div class="hero-actions">
          <a class="btn-inv lg" href="#invitations">See real invitations</a>
          <a class="tlink" href={WA.general} target="_blank" rel="noopener">Message us on WhatsApp</a>
        </div>
        <ul class="hero-marks">
          <li>Ready in 48 hours</li>
          <li>Opens from WhatsApp</li>
          <li>Pay half to begin</li>
        </ul>
      </div>

      <div class="hero-side">
        <div class="stage">
          <span class="stage-arch" aria-hidden="true"></span>
          <span class="stage-glow" aria-hidden="true"></span>

          <a class="phone side left" href="#invitations" aria-label="See real invitations" data-cycle>
            <span class="phone-screen">
              {HERO_LEFT.map((src, i) => <img class:list={{ on: i === 0 }} src={i === 0 ? src : undefined} data-src={src} alt="" decoding="async" />)}
            </span>
          </a>
          <a class="phone side right" href="#invitations" aria-label="See real invitations" data-cycle>
            <span class="phone-screen">
              {HERO_RIGHT.map((src, i) => <img class:list={{ on: i === 0 }} src={i === 0 ? src : undefined} data-src={src} alt="" decoding="async" />)}
            </span>
          </a>

          <button class="phone hero-phone" id="seal" type="button" aria-label="Tap the seal" aria-pressed="false">
            <span class="phone-screen" id="seal-screen">
              <span class="inner-rule"></span>
              <span class="glow"></span>
              <span class="invite-text">
                <span class="it-for" data-guest="Especially for the {g} family">Especially for the {SAMPLE.family} family</span>
                <span class="it-bless">With the blessings of our elders</span>
                <span class="it-name">{SAMPLE.bride}</span>
                <span class="it-amp">&amp;</span>
                <span class="it-name">{SAMPLE.groom}</span>
                <span class="rule"></span>
                <span class="it-date">{SAMPLE.date} · {SAMPLE.place}</span>
              </span>
              <span class="hero-petals" aria-hidden="true">
                {PETALS.map((p, i) => <i style={heroPetal(p, i)} />)}
              </span>
              {
                SHARDS.map((s) => (
                  <span
                    class="shard"
                    style={`clip-path:${s[0]};--x:${(Number(s[1]) / 2.78).toFixed(1)}cqw;--y:${(Number(s[2]) / 2.78).toFixed(1)}cqw;--r:${s[3]}deg;--dl:${s[4]}s`}
                  />
                ))
              }
              <span class="hint">Tap the seal</span>
            </span>
          </button>
        </div>
        <button class="sound" id="sound" type="button" aria-pressed="false">
          <span class="sound-dot"></span><span id="sound-label">Sound off · tap for music</span>
        </button>
      </div>
    </div>
  </section>
  <div class="scallop down" style="--c:#1C332B"></div>

  <!-- ══════════════ HOW THE LINK ARRIVES ══════════════ -->
  <section class="wrap arrives">
    <div class="arrives-copy">
      <span class="eyebrow">How the link arrives</span>
      <p class="lede">
        One message on WhatsApp. It carries the family’s name, the couple’s names and the seal. Nothing to
        download, nothing to sign in to.
      </p>
    </div>
    <div class="chat">
      <div class="chat-head"><span>{SAMPLE.bride}’s family</span><span>7.12 pm</span></div>
      <div class="bubble">
        <p>
          Namaste. With the blessings of our elders, we invite you to the wedding of {SAMPLE.bride} and {SAMPLE.groom}.
          <span data-guest="Especially for the {g} family.">Especially for the {SAMPLE.family} family.</span>
        </p>
        <a class="preview" href={SAMPLE.href}>
          <img src="/brand/seal.png" alt="" width="278" height="284" />
          <span>
            <b>{SAMPLE.names} · {SAMPLE.short}</b>
            <i>Tap to open the invitation</i>
            <code>invitivals.com/<span data-guest-slug>reddy</span></code>
          </span>
        </a>
        <code class="tick">7.12 pm ✓✓</code>
      </div>
    </div>
  </section>

  <!-- ══════════════ WHAT THE GUEST EXPERIENCES ══════════════ -->
  <div class="scallop"></div>
  <section class="story on-green" data-cta="story">
    <div class="wrap story-in">
      <div class="head">
        <span class="eyebrow">What the guest experiences</span>
        <h2>Seven small moments, from the first tap to the last forward.</h2>
      </div>
      <div class="story-cols">
        <div class="story-phone">
          <div class="phone">
            <div class="phone-screen">
              {
                MOMENTS.map((m, i) => (
                  <div class:list={['mscreen', { on: i === 0 }]} data-screen={i}>
                    <span class="inner-rule" />
                    <span class="m-head">{m.head}</span>
                    {m.seal && <img class="m-seal" src="/brand/seal.png" alt="" width="278" height="284" />}
                    {m.bubble && <div class="m-bubble">{m.bubble}</div>}
                    {m.title2 && <span class="m-title">{m.title2}</span>}
                    {m.rows.length > 0 && (
                      <div class="m-rows">
                        {m.rows.map((r) => (
                          <div><span>{r.l}</span><i>{r.r}</i></div>
                        ))}
                      </div>
                    )}
                    {m.cta && <span class="m-cta">{m.cta}</span>}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <ol class="steps">
          {
            MOMENTS.map((m, i) => (
              <li class:list={{ on: i === 0 }} data-step={i}>
                <span class="step-no">{m.no}</span>
                <div>
                  <h3>{m.title}</h3>
                  <p>{m.line}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
  <div class="scallop down"></div>

  <!-- ══════════════ REAL INVITATIONS ══════════════ -->
  <section id="invitations" class="sec first" data-cta="gallery">
    <!-- older links on the sample invitations point here -->
    <span id="collection"></span>
    <div class="wrap col">
      <div class="head">
        <span class="eyebrow">Real invitations</span>
        <h2>Each one made for a family, in their colours and their words.</h2>
      </div>
      <div class="chips" role="group" aria-label="Filter by occasion">
        <button class="chip" type="button" data-filter="All" aria-pressed="true">All</button>
        {LIVE_OCCASIONS.map((o) => <button class="chip" type="button" data-filter={o.slug} aria-pressed="false">{o.name}</button>)}
      </div>
      <div class="scroller">
        {FEATURED.map((d, i) => <InviteCard invite={d} index={i} />)}
      </div>
      <div class="gallery-foot">
        <p>Every invitation here was made for a real family. Names have been changed for their privacy.</p>
        <a class="tlink sm" href="/invitations/">All {DESIGNS.length} invitations, by occasion</a>
      </div>
      <p class="studio">
        <span class="eyebrow">Also from the studio</span>
        {STUDIO.map((t) => <a href={t.href}>{t.name}</a>)}
      </p>
    </div>
  </section>

  <!-- ══════════════ MADE FOR YOUR TRADITION ══════════════ -->
  <section id="traditions" class="sec traditions" data-cta="traditions">
    <div class="petals" data-depth="0.06" aria-hidden="true">
      {PETALS.slice(0, 8).map((p, i) => <i style={driftPetal(p, i)} />)}
    </div>
    <div class="wrap col wide-gap">
      <div class="head" style="max-width:34em">
        <span class="eyebrow">Made for your tradition</span>
        <h2>Nothing here is adapted from a generic template.</h2>
        <p class="lede">
          Each tradition has its own words, its own order of events and its own motifs. We begin from those,
          not from a blank card. Each family can receive a link that greets them by name:
          <em>“Especially for the Ahmed Family”.</em>
        </p>
      </div>
      <div class="trad-grid">
        {
          TRADITIONS.map((t) => (
            <a class="trad" href={designUrl(byId(t.id)!)}>
              <img src={byId(t.id)!.door} alt="" width="540" height="1085" loading="lazy" decoding="async" />
              <span class="eyebrow">{t.occasion}</span>
              <p>{t.line}</p>
            </a>
          ))
        }
      </div>
      <div class="lang">
        <div class="lang-copy">
          <span class="eyebrow">In your language</span>
          <p class="lede">
            Written in English, Telugu, Hindi or Urdu. Or two side by side, so grandparents and cousins abroad
            read the same card.
          </p>
        </div>
        <div class="lang-demo">
          <div class="chips" style="gap:8px" role="group" aria-label="Language">
            {
              LANGS.map((l, i) => (
                <button class="chip lang-chip" type="button" data-lang={i} aria-pressed={i === 0 ? 'true' : 'false'}>{l.label}</button>
              ))
            }
          </div>
          {
            LANGS.map((l, i) => (
              <p class="lang-text" data-lang-text={i} hidden={i !== 0} dir={l.rtl ? 'rtl' : 'ltr'} lang={l.code.toLowerCase()} style={`font-family:${langFont[l.code]}`}>
                {l.text}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ HOW IT WORKS ══════════════ -->
  <section class="sec" data-cta="how">
    <div class="wrap col wide-gap">
      <div class="head">
        <span class="eyebrow">How it works</span>
        <h2>Three steps. No forms, no logins.</h2>
      </div>
      <div class="how">
        {
          HOW.map((h, i) => (
            <div>
              <span class="numeral">{i + 1}</span>
              <p class="lede" set:html={h} />
            </div>
          ))
        }
      </div>
      <Timeline />
    </div>
  </section>

  <!-- ══════════════ PLANS ══════════════ -->
  <section id="plans" class="sec" data-cta="plans">
    <div class="wrap col wide-gap">
      <div class="head">
        <span class="eyebrow">Plans</span>
        <h2>One price, told plainly.</h2>
      </div>
      <Plans />
      <p class="promise">{PROMISE}</p>
    </div>
  </section>

  <!-- ══════════════ FROM FAMILIES — only once real quotes exist ══════════════ -->
  {
    QUOTES.length > 0 && (
      <section class="sec">
        <div class="wrap quotes">
          <span class="eyebrow">From families</span>
          {QUOTES.map((q, i) => (
            <figure data-quote={i} hidden={i !== 0}>
              <blockquote>{q.text}</blockquote>
              <figcaption class="eyebrow">{q.who}</figcaption>
            </figure>
          ))}
          {QUOTES.length > 1 && (
            <div class="quote-nav">
              <button type="button" aria-label="Previous" data-quote-step="-1">←</button>
              <span id="quote-index">1 / {QUOTES.length}</span>
              <button type="button" aria-label="Next" data-quote-step="1">→</button>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- ══════════════ QUESTIONS ══════════════ -->
  <section id="questions" class="sec">
    <div class="wrap narrow col">
      <div class="head">
        <span class="eyebrow">Questions</span>
        <h2>Things families ask us.</h2>
      </div>
      <div class="faq">
        {
          FAQS.map((f, i) => (
            <details name="faq" open={i === 0}>
              <summary>
                <span>{f.q}</span>
                <i aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══════════════ CLOSING ══════════════ -->
  <div class="scallop" style="--c:#1C332B"></div>
  <section class="closing on-green" data-cta="close">
    <div class="petals" data-depth="0.1" aria-hidden="true">
      {PETALS.slice(4, 12).map((p, i) => <i style={driftPetal(p, i)} />)}
    </div>
    <div class="wrap closing-in">
      <div class="doors" id="doors" aria-hidden="true">
        <span class="arch"></span>
        <span class="lantern"></span>
        <span class="door l"></span>
        <span class="door r"></span>
      </div>
      <h2>Let the celebration begin on their phone.</h2>
      <div class="stack" style="align-items:center;gap:10px">
        <a class="btn-inv lg" href={WA.general} target="_blank" rel="noopener" style="padding:0 32px">Message us on WhatsApp</a>
        <span class="note">Opens WhatsApp</span>
      </div>
    </div>
  </section>

  <!-- ══════════════ CONTEXTUAL STICKY BAR (phones) ══════════════ -->
  <div class="bar">
    <a class="bar-wa" href={WA.general} target="_blank" rel="noopener" aria-label="Message us on WhatsApp"><span></span></a>
    <div class="bar-main">
      <a class="btn" id="bar-cta" href={CTAS.top.href}>{CTAS.top.label}</a>
      <span class="note" id="bar-note">{CTAS.top.note}</span>
    </div>
  </div>

  <script id="cta-data" type="application/json" is:inline set:html={JSON.stringify(CTAS)} />
</SiteLayout>

<script>
  import { playCrack, startMusic, stopMusic } from '../scripts/site-audio.js';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s);
  const $$ = <T extends HTMLElement>(s: string) => Array.from(document.querySelectorAll<T>(s));

  /* ── the seal: opens by itself (silently) after 2.2s, tap to toggle ── */
  const seal = $('#seal');
  const soundBtn = $('#sound');
  const soundLabel = $('#sound-label');
  let open = false;
  let sound = false;
  const setSeal = (next: boolean) => {
    open = next;
    seal?.classList.toggle('open', open);
    seal?.setAttribute('aria-pressed', String(open));
  };
  const auto = setTimeout(() => setSeal(true), 2200);
  seal?.addEventListener('click', () => {
    clearTimeout(auto);
    setSeal(!open);
    if (open) {
      playCrack();
      if (sound) startMusic();
    } else stopMusic();
  });
  soundBtn?.addEventListener('click', () => {
    sound = !sound;
    soundBtn.classList.toggle('on', sound);
    soundBtn.setAttribute('aria-pressed', String(sound));
    if (soundLabel) soundLabel.textContent = sound ? 'Sound on' : 'Sound off · tap for music';
    if (sound && open) startMusic();
    if (!sound) stopMusic();
  });

  /* ── the phone screen warms with the time of day ── */
  const screen = $('#seal-screen');
  if (screen) {
    const d = new Date();
    const h = d.getHours() + d.getMinutes() / 60;
    const t = Math.min(1, Math.max(0, Math.abs(h - 13) / 8));
    const a = [246, 240, 231];
    const b = [241, 222, 192];
    screen.style.background = `rgb(${a.map((c, i) => Math.round(c + (b[i] - c) * t)).join(',')})`;
  }

  /* ── the phones behind the seal turn through the real invitations ── */
  const cyclers = $$('[data-cycle]').map((el) => ({ imgs: Array.from(el.querySelectorAll('img')), i: 0 }));
  let turn = 0;
  if (!reduced && cyclers.length) {
    // the later pictures are fetched once the page has settled
    addEventListener('load', () => cyclers.forEach((c) => c.imgs.forEach((img) => img.src || (img.src = img.dataset.src || ''))));
    setInterval(() => {
      const c = cyclers[turn++ % cyclers.length];
      const next = (c.i + 1) % c.imgs.length;
      if (!c.imgs[next].complete || !c.imgs[next].naturalWidth) return;
      c.imgs[c.i].classList.remove('on');
      c.imgs[next].classList.add('on');
      c.i = next;
    }, 3600);
  }

  /* ── occasion filter ── */
  const filters = $$('[data-filter]');
  const cards = $$('.scroller .icard');
  filters.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter || 'All';
      filters.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      cards.forEach((c) => (c.hidden = f !== 'All' && !(c.dataset.tags || '').split('|').includes(f)));
      $('.scroller')?.scrollTo({ left: 0, behavior: reduced ? 'auto' : 'smooth' });
    })
  );

  /* ── in your language ── */
  const langChips = $$('[data-lang]');
  const langTexts = $$('[data-lang-text]');
  langChips.forEach((chip) =>
    chip.addEventListener('click', () => {
      langChips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      langTexts.forEach((t) => (t.hidden = t.dataset.langText !== chip.dataset.lang));
    })
  );

  /* ── quotes, hand-advanced ── */
  const quotes = $$('[data-quote]');
  let q = 0;
  $$('[data-quote-step]').forEach((b) =>
    b.addEventListener('click', () => {
      q = (q + Number(b.dataset.quoteStep) + quotes.length) % quotes.length;
      quotes.forEach((el, i) => (el.hidden = i !== q));
      const idx = $('#quote-index');
      if (idx) idx.textContent = `${q + 1} / ${quotes.length}`;
    })
  );

  /* ── keep only one question open where `name` is unsupported ── */
  const faqItems = $$<HTMLDetailsElement>('.faq details');
  if (!('name' in document.createElement('details'))) {
    faqItems.forEach((d) =>
      d.addEventListener('toggle', () => {
        if (d.open) faqItems.forEach((o) => o !== d && (o.open = false));
      })
    );
  }

  /* ── the doors ease open once, when they come into view ── */
  const doors = $('#doors');
  if (doors) {
    new IntersectionObserver(
      (es, io) => {
        if (es.some((e) => e.isIntersecting)) {
          doors.classList.add('open');
          io.disconnect();
        }
      },
      { threshold: 0.4 }
    ).observe(doors);
  }

  /* ── scroll: the walkthrough step, the sticky bar's label, the petals ── */
  const steps = $$('[data-step]');
  const screens = $$('[data-screen]');
  const sections = $$('[data-cta]');
  const petals = $$('.petals');
  const barCta = $<HTMLAnchorElement>('#bar-cta');
  const barNote = $('#bar-note');
  const CTA = JSON.parse($('#cta-data')?.textContent || '{}');
  let active = 0;
  let cta = 'top';

  const measure = () => {
    const vh = innerHeight;
    const mid = vh * 0.45;
    let best = -1;
    let bestD = Infinity;
    steps.forEach((el, i) => {
      const r = el.getBoundingClientRect();
      const d = Math.abs((r.top + r.bottom) / 2 - mid);
      if (r.bottom > 0 && r.top < vh && d < bestD) {
        bestD = d;
        best = i;
      }
    });
    if (best >= 0 && best !== active) {
      active = best;
      steps.forEach((el, i) => el.classList.toggle('on', i === active));
      screens.forEach((el, i) => el.classList.toggle('on', i === active));
    }

    let next = cta;
    sections.forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.top <= vh * 0.55 && r.bottom > vh * 0.35) next = el.dataset.cta || next;
    });
    if (next !== cta && CTA[next] && barCta && barNote) {
      cta = next;
      const c = CTA[cta];
      barCta.textContent = c.label;
      barCta.href = c.href;
      if (c.blank) {
        barCta.target = '_blank';
        barCta.rel = 'noopener';
      } else barCta.removeAttribute('target');
      barNote.textContent = c.note;
    }

    if (!reduced) petals.forEach((p) => (p.style.transform = `translateY(${-scrollY * Number(p.dataset.depth)}px)`));
  };
  let raf = 0;
  const onScroll = () => {
    if (raf) return;
    raf = requestAnimationFrame(() => {
      raf = 0;
      measure();
    });
  };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  measure();
</script>

