      /* ══════════════════════════════════════════════════════════════
         WIDE BUT SHORT WINDOWS — a half-height desktop window keeps the
         full desktop composition; it just scrolls instead of snapping,
         and the scale switches from height-driven to width-driven.
         ══════════════════════════════════════════════════════════════ */
      @media (min-width: 900px) and (max-height: 599px) {
        :root {
          --u: clamp(11px, 1.05vw, 17px);
        }
        .scr {
          padding: calc(var(--nav) + 44px) var(--pad-x) 60px;
        }
        .rail {
          display: none;
        }
      }

      /* the nav links only appear once there is room for them */
      @media (max-width: 819px) {
        .nav-links {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
