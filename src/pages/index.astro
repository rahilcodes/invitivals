---
import '@fontsource/marcellus/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';

/* ─────────────────────────────────────────────────────────────────────────
   INVITIVALS — brand storefront.
   Design language: the wax seal. Forest green, ivory, gold.
   Layout law: on a laptop every section is exactly one full screen —
   nothing is cut, nothing scrolls inside itself. On phones the same
   sections flow naturally, sized for the thumb.
   Everything a buyer edits lives in this frontmatter.
   ───────────────────────────────────────────────────────────────────────── */

// ⚠️ SET THIS BEFORE GOING LIVE — your WhatsApp number, country code, digits only.
const WHATSAPP = '917997001700';
const EMAIL = 'hello@invitivals.in';
const INSTAGRAM = 'https://instagram.com/invitivals.in';
const SITE = 'https://invitivals.com';

const wa = (msg: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
const waHello = wa('Hi Invitivals! I want a wedding invitation website.');

const designs = [
  {
    n: 'I',
    href: '/hindu',
    img: '/art/hindu/hero.svg',
    tag: 'Hindu · Shubh Vivah',
    title: 'The Mandap',
    desc: 'Maroon & gold, Ganesh invocation, haldi-to-pheras events, a shehnai score.',
    bg: '#5A1F1F',
  },
  {
    n: 'II',
    href: '/mountain',
    img: '/art/mountain/hero.svg',
    tag: 'Hindu · Pahadi Shaadi',
    title: 'The Mountain',
    desc: 'Moonlit teal & gold — a palace in the clouds, one long scroll from night to day in Mussoorie.',
    bg: '#12363B',
  },
  {
    n: 'III',
    href: '/nikah',
    img: '/art/nikah/hero.svg',
    tag: 'Muslim · Nikah',
    title: 'The Fanoos',
    desc: 'Emerald nights, bismillah calligraphy, swaying lanterns and a wall of duas.',
    bg: '#123A2C',
  },
  {
    n: 'IV',
    href: '/sikh',
    img: '/art/sikh/hero.svg',
    tag: 'Sikh · Anand Karaj',
    title: 'The Phulkari',
    desc: 'Saffron & royal blue, the four Laavan, jaggo night — and a dhol your guests can play.',
    bg: '#B4651A',
  },
  {
    n: 'V',
    href: '/christian',
    img: '/art/christian/hero.svg',
    tag: 'Christian · Holy Matrimony',
    title: 'The Chapel',
    desc: 'Stained glass, script names, 1 Corinthians 13 and light-a-candle wishes.',
    bg: '#2B2E4A',
  },
  {
    n: 'VI',
    href: '/modern',
    img: '/art/modern/hero.svg',
    tag: 'Modern · Editorial',
    title: 'The Rooftop',
    desc: 'Charcoal & terracotta, giant type, marquee energy, a playlist your guests build.',
    bg: '#2A2724',
  },
  {
    n: 'VII',
    href: '/luxe',
    img: '/photos/demo/hero.svg',
    tag: 'Classic · Luxe',
    title: 'The Estate',
    desc: 'Ivory & gold restraint — an envelope opening, a Ken Burns hero, quiet luxury.',
    bg: '#E9E0CD',
  },
];

const steps = [
  { n: 'I', t: 'They receive your link', d: 'One tap away, on WhatsApp.' },
  { n: 'II', t: 'They break the seal', d: 'The invitation opens like a gift, with music.' },
  { n: 'III', t: 'They discover your story', d: 'How you met, in your own words.' },
  { n: 'IV', t: 'They explore every event', d: 'Haldi to reception, each with its own moment.' },
  { n: 'V', t: 'They find the venue', d: 'Live maps — nobody ever wonders where.' },
  { n: 'VI', t: 'They RSVP', d: "You know who's coming before the first baraat arrives." },
  { n: 'VII', t: 'They replay it', d: 'And forward it. And replay it again.' },
];

const promises = [
  { t: 'Opens like a gift', d: 'An envelope, a tap, music — guests experience your invitation, not just read it.' },
  { t: 'RSVPs count themselves', d: 'No more calling 200 relatives. Replies land in your sheet with guest counts and notes.' },
  { t: 'Nobody gets lost', d: 'Every venue with live maps and directions built in — one tap from the invite.' },
  { t: 'Personal for each guest', d: 'Links that greet each family by name. “Especially for the Sharmas.”' },
  { t: 'No printing, no couriers', d: 'Send it to 500 guests in five minutes. Update details anytime — even after sending.' },
  { t: 'Made for Indian weddings', d: 'Haldi to walima, jaggo to high tea — designs that speak your tradition fluently.' },
];

const how = [
  {
    n: 'I',
    t: 'Pick your design',
    d: 'Explore all seven live demos. Found the one? Tap “Create this for us” — it opens WhatsApp with us on the other side.',
  },
  {
    n: 'II',
    t: 'Send your details',
    d: 'Names, dates, events, story, photos — a simple checklist we send you. Ten minutes of your time, no forms, no logins.',
  },
  {
    n: 'III',
    t: 'Approve & share',
    d: 'Within 48 hours you get your private link. Review it, request changes, and when you love it — share it with the world.',
  },
];

const plans = [
  {
    name: 'Essential',
    price: '₹1,499',
    line: 'to begin beautifully',
    features: [
      'Any one design, personalised',
      'Your names, dates, venues & events',
      'Live countdown + Google Maps',
      'Up to 6 photos',
      'Link live for 12 months',
      'Delivered in 48 hours',
    ],
  },
  {
    name: 'Signature',
    price: '₹2,999',
    line: 'the one most choose',
    popular: true,
    features: [
      'Everything in Essential',
      'Your love story & full event schedule',
      'RSVPs to your WhatsApp / Google Sheet',
      'Music of your choice',
      'Up to 20 photos + film section',
      'Personalised guest links',
      'Unlimited text revisions',
    ],
  },
  {
    name: 'Royal',
    price: '₹4,999',
    line: 'the wedding of the year',
    features: [
      'Everything in Signature',
      'Custom colour palette on any design',
      'Extra custom sections',
      'Your own domain (yourname.wedding)',
      'Priority same-day delivery',
      'Dedicated support till the vidaai',
    ],
  },
];

/* SAMPLE testimonials — replace with real customer reviews before running ads. */
const reviews = [
  {
    q: 'We sent one link on WhatsApp and the whole family felt like they had received a shagun. The RSVP list filled itself.',
    who: 'Priya & Rohan · Mumbai',
  },
  {
    q: 'The lanterns, the bismillah, the music — my nani watched it five times. Worth every rupee.',
    who: 'Ayesha & Faisal · Hyderabad',
  },
  {
    q: 'Guests kept tapping the dhol at the dinner table. Best decision of the wedding after the caterer.',
    who: 'Sana & Jaskirat · Chandigarh',
  },
];

const faqs = [
  {
    q: 'How do my guests see the invitation?',
    a: 'You get one link. Share it on WhatsApp, Instagram, anywhere — it opens instantly in the browser. No app, no download, works on every phone.',
  },
  {
    q: 'What can be personalised?',
    a: 'Everything you see in the demos — names, dates, every event, your story, family names, venues and maps, photos, music, hashtag, even the colours on the Royal plan.',
  },
  {
    q: 'How fast will it be ready?',
    a: 'Within 48 hours of receiving your details and photos on WhatsApp. Need it today? The Royal plan includes same-day priority delivery.',
  },
  {
    q: 'Where do RSVP responses go?',
    a: 'To you — as a live Google Sheet and WhatsApp notifications. You always know who is coming and how many guests they bring.',
  },
  {
    q: 'Can the text be in Hindi, Punjabi or Urdu?',
    a: 'Yes — any of your events, blessings or quotes can be set in your language at no extra cost.',
  },
  {
    q: 'How do I pay?',
    a: 'UPI or bank transfer. 50% to begin, the rest only after you have seen and approved your invitation. If you do not love it, full refund — no questions.',
  },
];

const navSections = [
  { id: 'top', label: 'Home' },
  { id: 'collection', label: 'The Collection' },
  { id: 'experience', label: 'The Experience' },
  { id: 'how', label: 'How it works' },
  { id: 'pricing', label: 'Pricing' },
  { id: 'voices', label: 'Reviews & FAQ' },
  { id: 'start', label: 'Start' },
];

const title = 'Invitivals — Premium Wedding Invitation Websites';
const description =
  'Your wedding invitation, as a beautiful website. Seven hand-crafted designs for Hindu, Muslim, Sikh, Christian and modern weddings — live demos, RSVP tracking, music & maps. Personalised in 48 hours.';
const ogImage = '/brand/seal-on-ivory.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Invitivals',
      url: SITE,
      logo: `${SITE}/brand/lockup-light.png`,
      email: EMAIL,
      description,
      sameAs: [INSTAGRAM],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};

const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="#1C332B"/><circle cx="32" cy="32" r="21" fill="none" stroke="#CBB48B" stroke-width="1.6"/><path d="M32 47V27" stroke="#F6F0E7" stroke-width="2" stroke-linecap="round"/><path d="M32 38c-6 0-9-3-9-7 4 0 9 2 9 7Z" fill="#F6F0E7"/><path d="M32 33c6 0 9-3 9-7-4 0-9 2-9 7Z" fill="#F6F0E7"/><circle cx="32" cy="22" r="3.2" fill="none" stroke="#F6F0E7" stroke-width="1.8"/><circle cx="26" cy="18" r="1.7" fill="#F6F0E7"/><circle cx="38" cy="17" r="1.7" fill="#F6F0E7"/></svg>'
  );
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1C332B" />
    <link rel="icon" href={favicon} />
    <link rel="apple-touch-icon" href="/brand/seal-on-ivory.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Invitivals" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>

  <body>
    <!-- ══════════════ NAV ══════════════ -->
    <nav aria-label="Main">
      <a class="brand" href="#top" aria-label="Invitivals — home">
        <span class="brand-seal">
          <img class="on-light" src="/brand/seal.png" alt="" width="278" height="284" />
          <img class="on-dark-seal" src="/brand/seal-light.png" alt="" width="278" height="284" />
        </span>
        <span class="brand-name">INVITIVALS</span>
      </a>
      <div class="nav-links">
        <a href="#collection">THE COLLECTION</a>
        <a href="#experience">THE EXPERIENCE</a>
        <a href="#pricing">PRICING</a>
      </div>
      <a class="nav-cta" href={waHello} target="_blank" rel="noopener">WHATSAPP US</a>
    </nav>

    <!-- ══════════════ SCREEN RAIL (desktop) ══════════════ -->
    <aside class="rail" aria-hidden="true">
      {navSections.map((s) => <a href={`#${s.id}`} data-rail={s.id}><i></i><em>{s.label}</em></a>)}
    </aside>

    <main class="deck">
      <!-- ══════════════ 1 · HERO ══════════════ -->
      <section id="top" class="scr hero dark">
        <div class="wrap hero-wrap">
          <div class="hero-copy">
            <span class="eyebrow gold rv">PREMIUM DIGITAL WEDDING INVITATIONS · INDIA</span>
            <h1 class="rv">The first moment of your wedding happens on a phone.</h1>
            <p class="lead rv">
              Before the mandap, before the music, before the first garland — your guests open a
              link. Invitivals makes that moment feel like the wedding has already begun.
            </p>
          </div>

          <div class="hero-phone rv">
            <button class="phone" id="invite" type="button" aria-live="polite" aria-label="Tap to break the seal on a sample invitation">
              <span class="phone-screen">
                <span class="face sealed">
                  <span class="micro">AN INVITATION FOR YOU</span>
                  <img class="seal" src="/brand/seal.png" alt="" width="278" height="284" />
                  <span class="tap">TAP TO BREAK THE SEAL</span>
                </span>
                <span class="face opened">
                  <span class="micro gold">TOGETHER WITH THEIR FAMILIES</span>
                  <span class="names">Aarav<i>&amp;</i>Diya</span>
                  <span class="rule"></span>
                  <span class="req">request the honour of your presence</span>
                  <span class="when">27 · 11 · 2026 — UDAIPUR</span>
                  <span class="reseal">SEAL IT AGAIN</span>
                </span>
              </span>
            </button>
            <span class="phone-note">A LIVE INVITATION — GO ON, TAP IT</span>
          </div>

          <div class="hero-actions">
            <div class="btn-row rv">
              <a class="btn gold-btn" href="#collection">EXPERIENCE A LIVE INVITE</a>
              <a class="btn line-btn" href={waHello} target="_blank" rel="noopener">START ON WHATSAPP</a>
            </div>
            <ul class="marks rv">
              <li>SEVEN LIVE DESIGNS</li>
              <li>READY IN 48 HOURS</li>
              <li>MONEY-BACK PROMISE</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ══════════════ 2 · THE COLLECTION ══════════════ -->
      <section id="collection" class="scr coll">
        <div class="wrap coll-wrap">
          <div class="coll-list">
            <div class="s-head rv">
              <span class="eyebrow">THE INVITIVALS COLLECTION</span>
              <h2>Seven weddings,<br />seven worlds.</h2>
              <p>
                Every design is a complete experience — opening ritual, music, story, events,
                countdown, gallery and RSVP. Open any of them live, exactly as your guests would.
              </p>
            </div>
            <div class="picker rv" role="tablist" aria-label="The seven designs">
              {
                designs.map((d, i) => (
                  <button
                    class={`pick${i === 0 ? ' on' : ''}`}
                    type="button"
                    role="tab"
                    aria-selected={i === 0 ? 'true' : 'false'}
                    data-pick={i}
                  >
                    <span class="pick-n">{d.n}</span>
                    <span class="pick-body">
                      <span class="pick-name">{d.title}</span>
                      <span class="pick-tag">{d.tag}</span>
                    </span>
                    <span class="pick-arrow">↗</span>
                  </button>
                ))
              }
            </div>
          </div>

          <div class="coll-stage rv">
            <div class="stage-frame">
              {
                designs.map((d, i) => (
                  <img
                    class={`stage-img${i === 0 ? ' on' : ''}`}
                    data-stage={i}
                    src={d.img}
                    alt={`${d.title} — ${d.tag} invitation design`}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ))
              }
              <div class="stage-veil"></div>
              <div class="stage-cap">
                <span class="micro gold" data-out="tag">{designs[0].tag}</span>
                <span class="stage-name" data-out="title">{designs[0].title}</span>
                <p data-out="desc">{designs[0].desc}</p>
              </div>
            </div>
            <div class="stage-ctas">
              <a class="btn dark-btn" data-out="demo" href={designs[0].href}>OPEN THE DEMO</a>
              <a
                class="btn line-btn dark-line"
                data-out="wa"
                href={wa(`Hi Invitivals! I love the ${designs[0].title} (${designs[0].tag}) design. I'd like it for my wedding.`)}
                target="_blank"
                rel="noopener">CREATE THIS FOR US</a
              >
            </div>
          </div>

          <!-- phones get the full card deck instead of the stage -->
          <div class="coll-cards">
            {
              designs.map((d, i) => (
                <article class="dcard">
                  <a class="dcard-art" href={d.href} style={`background:${d.bg}`}>
                    <img src={d.img} alt={`${d.title} design preview`} loading="lazy" decoding="async" />
                    <span class="dcard-pill">PREVIEW LIVE ↗</span>
                  </a>
                  <div class="dcard-body">
                    <span class="micro gold">{d.tag}</span>
                    <h3>{d.title}</h3>
                    <p>{d.desc}</p>
                    <div class="dcard-ctas">
                      <a class="btn dark-btn" href={d.href}>OPEN THE DEMO</a>
                      <a
                        class="btn line-btn dark-line"
                        href={wa(`Hi Invitivals! I love the ${d.title} (${d.tag}) design. I'd like it for my wedding.`)}
                        target="_blank"
                        rel="noopener">CREATE THIS</a
                      >
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ══════════════ 3 · THE EXPERIENCE ══════════════ -->
      <section id="experience" class="scr exp dark">
        <div class="wrap exp-wrap">
          <div class="s-head center rv">
            <span class="eyebrow gold">WHAT YOUR GUESTS FEEL</span>
            <h2>A card gets seen once.<br />An Invitival gets replayed.</h2>
          </div>
          <div class="exp-grid">
            <ol class="steps rv">
              {
                steps.map((s) => (
                  <li>
                    <span class="step-n">{s.n}</span>
                    <span class="step-body">
                      <b>{s.t}</b>
                      <i>{s.d}</i>
                    </span>
                  </li>
                ))
              }
            </ol>
            <div class="promises rv">
              {
                promises.map((p) => (
                  <div class="promise">
                    <b>{p.t}</b>
                    <span>{p.d}</span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════════ 4 · HOW IT WORKS ══════════════ -->
      <section id="how" class="scr how">
        <div class="wrap how-wrap">
          <div class="s-head center rv">
            <span class="eyebrow">A FULLY MANAGED SERVICE</span>
            <h2>You send a WhatsApp.<br />We craft the rest.</h2>
          </div>
          <div class="how-grid">
            {
              how.map((h) => (
                <article class="how-card rv">
                  <span class="how-n">STEP {h.n}</span>
                  <h3>{h.t}</h3>
                  <p>{h.d}</p>
                </article>
              ))
            }
          </div>
          <div class="how-foot rv">
            <a class="btn dark-btn" href={wa('Hi Invitivals! Send me the details checklist — I want to get started.')} target="_blank" rel="noopener">
              START ON WHATSAPP
            </a>
            <span class="how-note">Replies within the hour · 9 AM – 11 PM, every day</span>
          </div>
        </div>
      </section>

      <!-- ══════════════ 5 · PRICING ══════════════ -->
      <section id="pricing" class="scr price">
        <div class="wrap price-wrap">
          <div class="s-head center rv">
            <span class="eyebrow">AN ENTRY POINT, NOT A PRICE TAG</span>
            <h2>Less than one wedding thali.</h2>
            <p>Pay 50% to begin. The rest only after you’ve seen your invitation and love it.</p>
          </div>
          <div class="plans">
            {
              plans.map((p) => (
                <article class={`plan rv${p.popular ? ' popular' : ''}`}>
                  {p.popular && <span class="badge">MOST CHOSEN</span>}
                  <span class="plan-name">{p.name}</span>
                  <div class="plan-price">
                    <b>{p.price}</b>
                    <i>{p.line}</i>
                  </div>
                  <ul>
                    {p.features.map((f) => (
                      <li>
                        <span>—</span>
                        {f}
                      </li>
                    ))}
                  </ul>
                  <a
                    class={`btn ${p.popular ? 'gold-btn' : 'dark-btn'}`}
                    href={wa(`Hi Invitivals! I'd like the ${p.name} plan (${p.price}).`)}
                    target="_blank"
                    rel="noopener">GET {p.name.toUpperCase()}</a
                  >
                </article>
              ))
            }
          </div>
          <p class="guarantee rv">
            The Invitivals promise: unlimited text revisions · full refund if you don’t love it · a
            human on WhatsApp from first message to vidaai.
          </p>
        </div>
      </section>

      <!-- ══════════════ 6 · REVIEWS + FAQ ══════════════ -->
      <section id="voices" class="scr voices">
        <div class="wrap voices-wrap">
          <div class="voices-col">
            <div class="s-head rv">
              <span class="eyebrow">FROM OUR COUPLES</span>
              <h2>The reviews we live for.</h2>
            </div>
            <div class="quotes rv">
              {
                reviews.map((r) => (
                  <figure class="quote">
                    <img src="/brand/seal.png" alt="" width="278" height="284" />
                    <div>
                      <blockquote>“{r.q}”</blockquote>
                      <figcaption>{r.who}</figcaption>
                    </div>
                  </figure>
                ))
              }
            </div>
          </div>
          <div class="faq-col">
            <div class="s-head rv">
              <span class="eyebrow">GOOD TO KNOW</span>
              <h2>Questions, answered.</h2>
            </div>
            <div class="faq-list rv">
              {
                faqs.map((f, i) => (
                  <details name="faq" open={i === 0}>
                    <summary>
                      <span>{f.q}</span>
                      <i aria-hidden="true">+</i>
                    </summary>
                    <p>{f.a}</p>
                  </details>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════════ 7 · FINAL CTA + FOOTER ══════════════ -->
      <section id="start" class="scr final dark">
        <div class="wrap final-wrap">
          <div class="final-body rv">
            <img class="final-seal" src="/brand/seal-light.png" alt="" width="278" height="284" />
            <h2>The shaadi is coming.<br /><em>Let the invite arrive first.</em></h2>
            <div class="btn-row center">
              <a class="btn gold-btn" href={waHello} target="_blank" rel="noopener">MESSAGE US ON WHATSAPP</a>
              <a class="btn line-btn" href="#collection">BROWSE THE COLLECTION</a>
            </div>
            <span class="micro">REPLIES WITHIN THE HOUR · 9 AM – 11 PM, EVERY DAY</span>
          </div>
          <footer>
            <span>© 2026 INVITIVALS · MADE WITH LOVE IN INDIA</span>
            <div class="f-links">
              <a href={waHello} target="_blank" rel="noopener">WHATSAPP</a>
              <a href={`mailto:${EMAIL}`}>{EMAIL.toUpperCase()}</a>
              <a href={INSTAGRAM} target="_blank" rel="noopener">INSTAGRAM</a>
            </div>
          </footer>
        </div>
      </section>
    </main>

    <style>
      /* ══════════════ TOKENS ══════════════
         --u is the single scale unit. On a laptop it tracks BOTH the width
         and the height of the viewport, so a whole section always fits one
         screen — 1366×768 and 1920×1080 get the same composition, resized. */
      :root {
        --ivory: #f6f0e7;
        --ivory-2: #f9f4ee;
        --sand: #ede6d8;
        --line: #e4decf;
        --green: #21463a;
        --green-d: #1c332b;
        --green-dd: #14261f;
        --gold: #cbb48b;
        --gold-d: #a9885a;
        --gold-l: #d8c49d;
        --brass: #b7a377;
        --ink: #25332c;
        --mut: #4f5f56;
        --on-dark: #c9cfc6;
        --on-dark-2: #8f9b93;
        --on-dark-3: #aebbb2;

        /* one unit, governed by whichever of the two viewport dimensions
           is scarcer — this is what keeps a whole section on one screen
           at 1024×768 and 1920×1080 alike */
        --u: clamp(10px, min(1.2vw, 1.62vh), 19px);
        --nav: calc(var(--u) * 4.3);

        --fs-h1: calc(var(--u) * 4.05);
        --fs-h2: calc(var(--u) * 3);
        --fs-h3: calc(var(--u) * 1.72);
        --fs-lead: calc(var(--u) * 1.46);
        --fs-body: calc(var(--u) * 1.22);
        --fs-sm: calc(var(--u) * 1.08);
        --fs-eye: calc(var(--u) * 0.79);
        --fs-btn: calc(var(--u) * 0.95);
        --pad-x: calc(var(--u) * 4);

        --serif: 'Marcellus', 'Cormorant Garamond', Georgia, serif;
        --body: 'Cormorant Garamond', Georgia, serif;
        --mono: ui-monospace, 'SFMono-Regular', 'Menlo', monospace;
      }

      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--ivory);
        color: var(--ink);
        font-family: var(--body);
        font-size: var(--fs-body);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      img {
        max-width: 100%;
        height: auto;
      }
      h1,
      h2,
      h3 {
        font-family: var(--serif);
        font-weight: 400;
        margin: 0;
      }
      h1 {
        font-size: var(--fs-h1);
        line-height: 1.11;
      }
      h2 {
        font-size: var(--fs-h2);
        line-height: 1.15;
        color: var(--green);
      }
      h3 {
        font-size: var(--fs-h3);
        color: var(--green);
      }
      .dark h2,
      .dark h3 {
        color: var(--ivory);
      }
      p {
        margin: 0;
      }
      :focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 3px;
      }

      .eyebrow,
      .micro {
        font-family: var(--mono);
        font-size: var(--fs-eye);
        letter-spacing: 0.26em;
        color: var(--gold-d);
        text-transform: uppercase;
        display: block;
      }
      .eyebrow.gold,
      .micro.gold {
        color: var(--gold);
      }

      /* ══════════════ THE DECK — one section, one screen ══════════════ */
      .scr {
        position: relative;
        display: grid;
        align-content: center;
        justify-items: center;
        padding: calc(var(--nav) + var(--u) * 1.6) var(--pad-x) calc(var(--u) * 2.2);
        background: var(--ivory);
      }
      .scr.dark {
        background: var(--green-d);
        color: var(--ivory);
      }
      .scr.exp {
        background: var(--green);
      }
      .scr.price {
        background: var(--sand);
      }
      .scr.voices {
        background: var(--ivory);
        border-top: 1px solid var(--line);
      }
      .wrap {
        width: min(94vw, calc(var(--u) * 82));
        max-width: 1400px;
      }

      @media (min-width: 900px) and (min-height: 600px) {
        html {
          scroll-snap-type: y mandatory;
        }
        .scr {
          height: 100vh;
          height: 100dvh;
          overflow: hidden;
          scroll-snap-align: start;
        }
      }

      /* ══════════════ NAV ══════════════ */
      nav {
        position: fixed;
        inset: 0 0 auto;
        z-index: 60;
        height: var(--nav);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: calc(var(--u) * 2);
        padding: 0 var(--pad-x);
        background: rgba(246, 240, 231, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
        transition: background 0.4s ease, border-color 0.4s ease;
      }
      nav.on-dark {
        background: rgba(19, 37, 30, 0.82);
        border-bottom-color: rgba(203, 180, 139, 0.24);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: calc(var(--u) * 0.8);
      }
      /* the seal has two presses: deep-green wax for ivory screens,
         ivory wax for dark ones. They cross-fade as the nav changes. */
      .brand-seal {
        position: relative;
        display: block;
        width: calc(var(--u) * 2.1);
        aspect-ratio: 278 / 284;
        flex: none;
      }
      .brand-seal img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transition: opacity 0.4s ease;
      }
      .brand-seal .on-dark-seal {
        opacity: 0;
      }
      nav.on-dark .brand-seal .on-light {
        opacity: 0;
      }
      nav.on-dark .brand-seal .on-dark-seal {
        opacity: 1;
      }
      .brand-name {
        font-family: var(--serif);
        font-size: calc(var(--u) * 1.05);
        letter-spacing: 0.22em;
        color: var(--green);
        transition: color 0.4s ease;
      }
      nav.on-dark .brand-name {
        color: var(--ivory);
      }
      .nav-links {
        display: flex;
        gap: calc(var(--u) * 2.4);
      }
      .nav-links a {
        font-family: var(--serif);
        font-size: var(--fs-btn);
        letter-spacing: 0.14em;
        color: var(--green);
        padding-bottom: 3px;
        border-bottom: 1px solid transparent;
        transition: color 0.3s, border-color 0.3s;
      }
      nav.on-dark .nav-links a {
        color: var(--on-dark);
      }
      .nav-links a:hover {
        color: var(--gold-d);
        border-bottom-color: var(--gold);
      }
      nav.on-dark .nav-links a:hover {
        color: var(--gold);
      }
      .nav-cta {
        font-family: var(--serif);
        font-size: var(--fs-btn);
        letter-spacing: 0.14em;
        padding: calc(var(--u) * 0.72) calc(var(--u) * 1.5);
        background: var(--green);
        color: var(--ivory);
        border-radius: 2px;
        transition: background 0.3s, color 0.3s;
        white-space: nowrap;
      }
      nav.on-dark .nav-cta {
        background: var(--gold);
        color: var(--green-d);
      }
      .nav-cta:hover {
        background: var(--gold-d);
        color: var(--ivory);
      }

      /* ══════════════ SCREEN RAIL ══════════════ */
      .rail {
        position: fixed;
        right: calc(var(--u) * 1.3);
        top: 50%;
        transform: translateY(-50%);
        z-index: 55;
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 0.9);
        align-items: flex-end;
      }
      .rail a {
        display: flex;
        align-items: center;
        gap: calc(var(--u) * 0.6);
      }
      .rail i {
        width: calc(var(--u) * 0.42);
        height: calc(var(--u) * 0.42);
        border-radius: 50%;
        background: var(--gold-d);
        opacity: 0.32;
        transition: opacity 0.3s, transform 0.3s;
      }
      .rail a.on i {
        opacity: 1;
        transform: scale(1.7);
      }
      .rail em {
        font-family: var(--mono);
        font-size: calc(var(--u) * 0.66);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-style: normal;
        color: var(--gold-d);
        opacity: 0;
        transform: translateX(6px);
        transition: opacity 0.3s, transform 0.3s;
        white-space: nowrap;
        order: -1;
      }
      .rail a:hover em {
        opacity: 0.75;
        transform: none;
      }
      .rail.on-dark i,
      .rail.on-dark em {
        color: var(--gold);
        background: var(--gold);
      }
      .rail.on-dark em {
        background: none;
      }

      /* ══════════════ BUTTONS ══════════════ */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--serif);
        font-size: calc(var(--u) * 1.02);
        letter-spacing: 0.14em;
        padding: calc(var(--u) * 1.05) calc(var(--u) * 2);
        border-radius: 2px;
        border: 1px solid transparent;
        transition: background 0.3s, color 0.3s, border-color 0.3s, transform 0.3s;
        text-align: center;
        white-space: nowrap;
      }
      .btn:hover {
        transform: translateY(-2px);
      }
      .gold-btn {
        background: var(--gold);
        color: var(--green-d);
      }
      .gold-btn:hover {
        background: var(--gold-l);
      }
      .dark-btn {
        background: var(--green);
        color: var(--ivory);
      }
      .dark-btn:hover {
        background: var(--green-d);
      }
      .line-btn {
        border-color: #4b5f55;
        color: var(--ivory);
      }
      .line-btn:hover {
        border-color: var(--gold);
        color: var(--gold);
      }
      .line-btn.dark-line {
        border-color: var(--gold);
        color: var(--green);
      }
      .line-btn.dark-line:hover {
        background: var(--gold);
        color: var(--green-d);
      }
      .btn-row {
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--u) * 1);
      }
      .btn-row.center {
        justify-content: center;
      }

      /* ══════════════ SECTION HEADS ══════════════ */
      .s-head {
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 0.85);
        max-width: calc(var(--u) * 33);
      }
      .s-head.center {
        text-align: center;
        align-items: center;
        max-width: calc(var(--u) * 54);
        margin: 0 auto;
      }
      .s-head p {
        font-size: var(--fs-lead);
        line-height: 1.55;
        color: var(--mut);
      }
      .dark .s-head p {
        color: var(--on-dark);
      }

      /* ══════════════ 1 · HERO ══════════════ */
      .hero-wrap {
        display: grid;
        grid-template-columns: 1.06fr 0.94fr;
        grid-template-areas: 'copy phone' 'act phone';
        grid-template-rows: auto auto;
        align-content: center;
        column-gap: calc(var(--u) * 4);
        row-gap: calc(var(--u) * 1.9);
      }
      .hero-copy {
        grid-area: copy;
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 1.5);
      }
      .hero-actions {
        grid-area: act;
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 1.5);
      }
      .hero h1 {
        color: var(--ivory);
      }
      .lead {
        font-size: var(--fs-lead);
        line-height: 1.6;
        color: var(--on-dark);
        max-width: calc(var(--u) * 33);
      }
      .marks {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: calc(var(--u) * 0.6) calc(var(--u) * 1.7);
        font-family: var(--mono);
        font-size: var(--fs-eye);
        letter-spacing: 0.12em;
        color: var(--on-dark-2);
      }

      .hero-phone {
        grid-area: phone;
        align-self: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(var(--u) * 1);
      }
      .phone {
        appearance: none;
        border: 1px solid #3a4f45;
        background: #0f1f19;
        cursor: pointer;
        padding: calc(var(--u) * 0.75);
        border-radius: calc(var(--u) * 2.6);
        box-shadow: 0 calc(var(--u) * 2.4) calc(var(--u) * 5) rgba(0, 0, 0, 0.45);
        height: min(calc(var(--u) * 41), 74vh);
        aspect-ratio: 300 / 610;
        display: block;
        font: inherit;
        color: inherit;
      }
      .phone-screen {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        border-radius: calc(var(--u) * 1.9);
        background: var(--ivory-2);
        overflow: hidden;
      }
      .face {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: calc(var(--u) * 1.2);
        padding: calc(var(--u) * 1.6);
        text-align: center;
        transition: opacity 0.6s ease, transform 0.6s ease;
      }
      .face .micro {
        letter-spacing: 0.18em;
        font-size: calc(var(--u) * 0.72);
      }
      .face.sealed .micro {
        color: #8a8377;
      }
      .face .seal {
        width: min(calc(var(--u) * 9), 44%);
        animation: sealPulse 2.8s ease-in-out infinite;
      }
      @keyframes sealPulse {
        0%,
        100% {
          transform: scale(1);
        }
        50% {
          transform: scale(1.045);
        }
      }
      .tap {
        font-family: var(--serif);
        font-size: calc(var(--u) * 0.92);
        letter-spacing: 0.2em;
        color: var(--green);
      }
      .face.opened {
        opacity: 0;
        transform: translateY(10px);
        pointer-events: none;
      }
      .phone.open .face.sealed {
        opacity: 0;
        transform: translateY(-10px);
      }
      .phone.open .face.opened {
        opacity: 1;
        transform: none;
      }
      .names {
        font-family: var(--serif);
        font-size: calc(var(--u) * 2.4);
        line-height: 1.25;
        color: var(--green);
        display: flex;
        flex-direction: column;
      }
      .names i {
        font-style: normal;
        color: var(--gold-d);
        font-size: 0.7em;
      }
      .rule {
        width: calc(var(--u) * 3.4);
        height: 1px;
        background: var(--gold);
      }
      .req {
        font-style: italic;
        font-size: calc(var(--u) * 1.24);
        color: var(--mut);
      }
      .when {
        font-family: var(--serif);
        font-size: calc(var(--u) * 0.94);
        letter-spacing: 0.16em;
        color: var(--green);
      }
      .reseal {
        font-family: var(--mono);
        font-size: calc(var(--u) * 0.66);
        letter-spacing: 0.2em;
        color: #b5ac9d;
      }
      .phone-note {
        font-family: var(--mono);
        font-size: var(--fs-eye);
        letter-spacing: 0.18em;
        color: var(--on-dark-2);
      }

      /* ══════════════ 2 · COLLECTION ══════════════ */
      .coll-wrap {
        display: grid;
        grid-template-columns: 1.02fr 0.98fr;
        gap: calc(var(--u) * 4);
        align-items: center;
      }
      .coll-list {
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 2);
      }
      .picker {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--line);
      }
      .pick {
        appearance: none;
        background: none;
        border: 0;
        border-bottom: 1px solid var(--line);
        border-left: 2px solid transparent;
        font: inherit;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: calc(var(--u) * 1.1);
        padding: calc(var(--u) * 0.72) calc(var(--u) * 0.9);
        text-align: left;
        color: var(--ink);
        transition: background 0.3s, border-color 0.3s, padding 0.3s;
      }
      .pick-n {
        font-family: var(--serif);
        font-size: calc(var(--u) * 0.92);
        letter-spacing: 0.1em;
        color: var(--gold-d);
        min-width: calc(var(--u) * 2.2);
      }
      .pick-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
      }
      .pick-name {
        font-family: var(--serif);
        font-size: calc(var(--u) * 1.35);
        color: var(--green);
        line-height: 1.25;
      }
      .pick-tag {
        font-family: var(--mono);
        font-size: calc(var(--u) * 0.68);
        letter-spacing: 0.18em;
        color: var(--mut);
        text-transform: uppercase;
      }
      .pick-arrow {
        color: var(--gold-d);
        opacity: 0;
        transition: opacity 0.3s;
        font-size: calc(var(--u) * 0.9);
      }
      .pick:hover {
        background: var(--ivory-2);
      }
      .pick.on {
        background: var(--ivory-2);
        border-left-color: var(--gold);
        padding-left: calc(var(--u) * 1.3);
      }
      .pick.on .pick-arrow {
        opacity: 1;
      }

      .coll-stage {
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 1.1);
        align-items: center;
      }
      .stage-frame {
        position: relative;
        width: 100%;
        max-width: calc(var(--u) * 27);
        height: min(calc(var(--u) * 37), 66vh);
        border: 1px solid var(--line);
        background: var(--green-d);
        overflow: hidden;
      }
      .stage-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.04);
        transition: opacity 0.7s ease, transform 1.4s ease;
      }
      .stage-img.on {
        opacity: 1;
        transform: none;
      }
      .stage-veil {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(15, 31, 25, 0.92) 4%, rgba(15, 31, 25, 0.35) 42%, rgba(15, 31, 25, 0.05) 70%);
      }
      .stage-cap {
        position: absolute;
        inset: auto 0 0;
        padding: calc(var(--u) * 1.4);
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 0.4);
        color: var(--ivory);
      }
      .stage-name {
        font-family: var(--serif);
        font-size: calc(var(--u) * 2);
        line-height: 1.2;
      }
      .stage-cap p {
        font-size: var(--fs-sm);
        line-height: 1.5;
        color: var(--on-dark);
      }
      .stage-ctas {
        display: flex;
        gap: calc(var(--u) * 0.8);
        width: 100%;
        max-width: calc(var(--u) * 27);
      }
      .stage-ctas .btn {
        flex: 1;
        padding-inline: calc(var(--u) * 0.8);
      }
      .coll-cards {
        display: none;
      }

      /* ══════════════ 3 · EXPERIENCE ══════════════ */
      .exp-wrap {
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 2.6);
      }
      .exp-grid {
        display: grid;
        grid-template-columns: 0.92fr 1.08fr;
        gap: calc(var(--u) * 3);
        align-items: stretch;
      }
      .steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
      }
      .steps li {
        display: flex;
        gap: calc(var(--u) * 1.3);
        align-items: baseline;
        padding: calc(var(--u) * 0.75) calc(var(--u) * 0.3);
        border-bottom: 1px solid rgba(203, 180, 139, 0.22);
      }
      .step-n {
        font-family: var(--serif);
        font-size: calc(var(--u) * 0.98);
        letter-spacing: 0.1em;
        color: var(--gold);
        min-width: calc(var(--u) * 2);
      }
      .step-body {
        display: flex;
        flex-direction: column;
      }
      .step-body b {
        font-family: var(--serif);
        font-weight: 400;
        font-size: calc(var(--u) * 1.3);
        color: var(--ivory);
        line-height: 1.3;
      }
      .step-body i {
        font-size: var(--fs-sm);
        color: var(--on-dark-3);
      }
      .promises {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: repeat(3, 1fr);
        gap: 1px;
        background: rgba(203, 180, 139, 0.25);
        border: 1px solid rgba(203, 180, 139, 0.25);
      }
      .promise {
        background: var(--green);
        padding: calc(var(--u) * 1.2) calc(var(--u) * 1.2);
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 0.3);
      }
      .promise b {
        font-family: var(--serif);
        font-weight: 400;
        font-size: calc(var(--u) * 1.18);
        color: var(--gold);
      }
      .promise span {
        font-size: var(--fs-sm);
        line-height: 1.5;
        color: var(--on-dark);
      }

      /* ══════════════ 4 · HOW ══════════════ */
      .how-wrap {
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 3);
      }
      .how-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: calc(var(--u) * 1.6);
      }
      .how-card {
        background: var(--ivory-2);
        border: 1px solid var(--line);
        padding: calc(var(--u) * 2.2) calc(var(--u) * 1.9);
        display: flex;
        flex-direction: column;
        gap: calc(var(--u) * 0.7);
        position: relative;
      }
      .how-card::before {
        content: '';
        position: absolute;
        inset: 0 auto 0 0;
        width: 2px;
        background: var(--gold);
        transform: scaleY(0);
        transform-origin: top;
        transition: transform 0.5s ease;
      }
      .how-card:hover::before {
        transform: none;
      }
      .how-n {
        font-family: var(--serif);
        font-size: calc(var(--u) * 0.86);
        letter-spacing: 0.2em;
        color: var(--gold-d);
      }
      .how-card p {
        font-size: var(--fs-body);
