---
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/700.css';

/* ─────────────────────────────────────────────────────────────────────────
   MYINVITE — brand storefront. Everything a buyer edits is right here:
   ───────────────────────────────────────────────────────────────────────── */

// ⚠️ SET THIS BEFORE GOING LIVE — your WhatsApp number, country code, digits only.
const WHATSAPP = '917997001700';
const EMAIL = 'hello@myinvite.in';
const INSTAGRAM = 'https://instagram.com/myinvite.in';

const wa = (msg: string) => `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;

const designs = [
  {
    href: '/hindu',
    img: '/art/hindu/hero.svg',
    tag: 'Hindu · Shubh Vivah',
    title: 'The Mandap',
    desc: 'Maroon & gold, Ganesh invocation, haldi-to-pheras events, shehnai score.',
    accent: '#a62639',
    dots: ['#a62639', '#d4a643', '#e8862e'],
  },
  {
    href: '/mountain',
    img: '/art/mountain/hero.svg',
    tag: 'Hindu · Pahadi Shaadi',
    title: 'The Mountain',
    desc: 'Moonlit teal & gold, a palace in the clouds — one long scroll from night to day in Mussoorie.',
    accent: '#ac9545',
    dots: ['#022938', '#ac9545', '#88b2a0'],
  },
  {
    href: '/nikah',
    img: '/art/nikah/hero.svg',
    tag: 'Muslim · Nikah',
    title: 'The Fanoos',
    desc: 'Emerald nights, bismillah calligraphy, swaying lanterns, duas wall.',
    accent: '#c9a227',
    dots: ['#0d3b30', '#c9a227', '#e6c96a'],
  },
  {
    href: '/sikh',
    img: '/art/sikh/hero.svg',
    tag: 'Sikh · Anand Karaj',
    title: 'The Phulkari',
    desc: 'Saffron & royal blue, four Laavan, jaggo night — and a dhol guests can play.',
    accent: '#e8862e',
    dots: ['#e8862e', '#1e2a5a', '#d9b45b'],
  },
  {
    href: '/christian',
    img: '/art/christian/hero.svg',
    tag: 'Christian · Holy Matrimony',
    title: 'The Chapel',
    desc: 'Stained glass, script names, 1 Corinthians 13, light-a-candle wishes.',
    accent: '#7d92a1',
    dots: ['#7d92a1', '#e8c9c0', '#c9b37e'],
  },
  {
    href: '/modern',
    img: '/art/modern/hero.svg',
    tag: 'Modern · Editorial',
    title: 'The Rooftop',
    desc: 'Charcoal & terracotta, giant type, marquee energy, guest-built playlist.',
    accent: '#e2725b',
    dots: ['#1a1a1e', '#e2725b', '#e8dcc8'],
  },
  {
    href: '/luxe',
    img: '/photos/demo/hero.svg',
    tag: 'Classic · Luxe',
    title: 'The Estate',
    desc: 'Ivory & gold restraint — envelope opening, Ken Burns hero, quiet luxury.',
    accent: '#a5843e',
    dots: ['#faf8f2', '#a5843e', '#22211c'],
  },
];

const plans = [
  {
    name: 'Essential',
    price: '₹1,499',
    tagline: 'Everything a beautiful invite needs',
    features: [
      'Any one design, personalised',
      'Your names, dates, venues & events',
      'Live countdown + Google Maps',
      'Up to 6 photos',
      'Link live for 12 months',
      'Delivered in 48 hours',
    ],
  },
  {
    name: 'Signature',
    price: '₹2,999',
    tagline: 'The one most couples choose',
    popular: true,
    features: [
      'Everything in Essential',
      'Your love story & full event schedule',
      'RSVP responses to your WhatsApp / Google Sheet',
      'Music of your choice',
      'Up to 20 photos + film section',
      'Personalised guest links ("Especially for…")',
      'Unlimited text revisions',
    ],
  },
  {
    name: 'Royal',
    price: '₹4,999',
    tagline: 'For the wedding of the year',
    features: [
      'Everything in Signature',
      'Custom colour palette on any design',
      'Extra custom sections',
      'Your own domain (yourname.wedding)',
      'Priority same-day delivery',
      'Dedicated WhatsApp support till the vidaai',
    ],
  },
];

/* SAMPLE testimonials — replace with real customer reviews before running ads. */
const testimonials = [
  {
    quote:
      'We sent one link on WhatsApp and the whole family felt like they had received a shagun. The RSVP list filled itself.',
    who: 'Priya & Rohan · Mumbai',
  },
  {
    quote:
      'The lanterns, the bismillah, the music — my nani watched it five times. Worth every rupee.',
    who: 'Ayesha & Faisal · Hyderabad',
  },
  {
    quote: 'Guests kept tapping the dhol at the dinner table. Best decision of the wedding after the caterer.',
    who: 'Sana & Jaskirat · Chandigarh',
  },
];

const faqs = [
  {
    q: 'How do my guests see the invitation?',
    a: 'You get one link. Share it on WhatsApp, Instagram, anywhere — it opens instantly in the browser. No app, no download, works on every phone.',
  },
  {
    q: 'What can be personalised?',
    a: 'Everything you see in the demos — names, dates, every event, your story, family names, venues and maps, photos, music, hashtag, even the colours on the Royal plan.',
  },
  {
    q: 'How fast will it be ready?',
    a: 'Within 48 hours of receiving your details and photos on WhatsApp. Need it today? The Royal plan includes same-day priority delivery.',
  },
  {
    q: 'Where do RSVP responses go?',
    a: 'To you — as a live Google Sheet and WhatsApp notifications. You always know who is coming and how many guests they bring.',
  },
  {
    q: 'Can the text be in Hindi, Punjabi or Urdu?',
    a: 'Yes — any of your events, blessings or quotes can be set in your language at no extra cost.',
  },
  {
    q: 'How long does the link stay live?',
    a: 'Twelve months on every plan — through the save-the-date, the wedding and the anniversary after it.',
  },
  {
    q: 'How do I pay?',
    a: 'UPI or bank transfer. 50% to begin, the rest only after you have seen and approved your invitation. If you do not love it, full refund — no questions.',
  },
];

const ogImage = '/art/hindu/hero.svg';
const title = 'Myinvite — Wedding Invitation Websites';
const description =
  'Your wedding invitation, as a beautiful website. Seven hand-crafted designs for Hindu, Muslim, Sikh, Christian and modern weddings — live demos, RSVP tracking, music & maps. Personalised in 48 hours.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Myinvite',
      email: EMAIL,
      description,
      sameAs: [INSTAGRAM],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f0" />
    <link
      rel="icon"
      href={'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="#1e1b16"/><text x="32" y="44" text-anchor="middle" font-family="Georgia,serif" font-size="34" font-style="italic" fill="#d4a643">M</text></svg>')}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <!-- ── Nav ── -->
    <nav aria-label="Main">
      <a class="logo" href="#top">My<span>invite</span></a>
      <div class="nav-links">
        <a href="#designs">Designs</a>
        <a href="#how">How it works</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
      </div>
      <a class="nav-cta" href={wa('Hi Myinvite! I want a wedding invitation website.')} target="_blank" rel="noopener">WhatsApp us</a>
    </nav>

    <main id="top">
      <!-- ── Hero ── -->
      <header class="hero">
        <div class="hero-copy">
          <div class="eyebrow rv">Digital wedding invitations</div>
          <h1 class="rv">Your wedding invitation,<br /><em>as a website.</em></h1>
          <p class="lead rv">
            One link on WhatsApp. Music, your story, every event, maps and RSVPs —
            wrapped in a design your guests will replay. Personalised for you in 48 hours.
          </p>
          <div class="hero-ctas rv">
            <a class="btn solid" href="#designs">See the seven designs</a>
            <a class="btn ghost" href={wa('Hi Myinvite! I want a wedding invitation website.')} target="_blank" rel="noopener">Talk on WhatsApp</a>
          </div>
          <ul class="chips rv" aria-label="Highlights">
            <li>Try every design live</li>
            <li>Ready in 48 hours</li>
            <li>Money-back promise</li>
          </ul>
        </div>
        <div class="hero-phone rv" aria-hidden="true">
          <div class="phone">
            <i class="notch"></i>
            <div class="screen">
              <img src="/art/hindu/hero.svg" alt="" loading="eager" />
              <div class="screen-ui">
                <b>Aarav &amp; Diya</b>
                <span>27 · 11 · 2026 — Udaipur</span>
              </div>
            </div>
          </div>
          <div class="phone-glow"></div>
        </div>
      </header>

      <!-- ── Trust strip ── -->
      <div class="strip" role="presentation">
        <span>7 hand-crafted designs</span><i>·</i>
        <span>Live demos, before you pay</span><i>·</i>
        <span>RSVPs that count themselves</span><i>·</i>
        <span>48-hour delivery</span><i>·</i>
        <span>12 months hosting included</span>
      </div>

      <!-- ── Designs ── -->
      <section id="designs" class="designs">
        <div class="s-head rv">
          <div class="eyebrow">The collection</div>
          <h2>Seven weddings, seven worlds.</h2>
          <p>Every design is a complete experience — opening ritual, music, story, events, countdown, gallery and RSVP. Tap any of them and see the real thing, exactly as your guests would.</p>
        </div>
        <div class="grid">
          {
            designs.map((d, i) => (
              <article class="card rv" style={`--acc:${d.accent}`}>
                <a class="thumb" href={d.href} aria-label={`Preview the ${d.title} design live`}>
                  <img src={d.img} alt={`${d.tag} design preview`} loading={i < 2 ? 'eager' : 'lazy'} />
                  <span class="preview-pill">Preview live ↗</span>
                </a>
                <div class="card-body">
                  <div class="card-top">
                    <span class="tag">{d.tag}</span>
                    <span class="dots">{d.dots.map((c) => <i style={`background:${c}`}></i>)}</span>
                  </div>
                  <h3>{d.title}</h3>
                  <p>{d.desc}</p>
                  <div class="card-ctas">
                    <a class="mini solid" href={wa(`Hi Myinvite! I love the ${d.title} (${d.tag}) design. I'd like it for my wedding.`)} target="_blank" rel="noopener">Choose this design</a>
                    <a class="mini" href={d.href}>Open demo</a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- ── Why ── -->
      <section class="why">
        <div class="s-head rv">
          <div class="eyebrow light">Why couples switch</div>
          <h2>A card gets seen once.<br />A website gets <em>felt.</em></h2>
        </div>
        <div class="why-grid">
          <div class="why-item rv"><b>Opens like a gift</b><p>An envelope, a tap, music — guests experience your invitation, not just read it.</p></div>
          <div class="why-item rv"><b>RSVPs count themselves</b><p>No more calling 200 relatives. Replies land in your sheet with guest counts and notes.</p></div>
          <div class="why-item rv"><b>Nobody gets lost</b><p>Every venue with live maps and directions built in — one tap from the invite.</p></div>
          <div class="why-item rv"><b>Personal for each guest</b><p>Links that greet each family by name. “Especially for the Sharmas.”</p></div>
          <div class="why-item rv"><b>No printing, no couriers</b><p>Send it to 500 guests in five minutes. Update details anytime — even after sending.</p></div>
          <div class="why-item rv"><b>Made for Indian weddings</b><p>Haldi to walima, jaggo to high tea — designs that speak your tradition fluently.</p></div>
        </div>
      </section>

      <!-- ── How it works ── -->
      <section id="how" class="how">
        <div class="s-head rv">
          <div class="eyebrow">How it works</div>
          <h2>Live in three steps.</h2>
        </div>
        <ol class="steps">
          <li class="rv">
            <span class="num">1</span>
            <b>Pick your design</b>
            <p>Explore all seven live demos. Found the one? Tap “Choose this design” — it opens WhatsApp with us on the other side.</p>
          </li>
          <li class="rv">
            <span class="num">2</span>
            <b>Send your details</b>
            <p>Names, dates, events, story, photos — a simple checklist we send you. Ten minutes of your time, no forms, no logins.</p>
          </li>
          <li class="rv">
            <span class="num">3</span>
            <b>Approve &amp; share</b>
            <p>Within 48 hours you get your private link. Review it, request changes, and when you love it — share it with the world.</p>
          </li>
        </ol>
        <div class="how-cta rv">
          <a class="btn solid" href={wa('Hi Myinvite! Send me the details checklist — I want to get started.')} target="_blank" rel="noopener">Start on WhatsApp →</a>
        </div>
      </section>

      <!-- ── Pricing ── -->
      <section id="pricing" class="pricing">
        <div class="s-head rv">
          <div class="eyebrow">Simple pricing</div>
          <h2>Less than one wedding thali.</h2>
          <p>Pay 50% to begin. The rest only after you’ve seen your invitation and love it.</p>
        </div>
        <div class="plans">
          {
            plans.map((p) => (
              <article class={`plan rv ${p.popular ? 'popular' : ''}`}>
                {p.popular && <span class="pop-badge">Most chosen</span>}
                <h3>{p.name}</h3>
                <div class="price">{p.price}</div>
                <div class="tagline">{p.tagline}</div>
                <ul>
                  {p.features.map((f) => <li>{f}</li>)}
                </ul>
                <a class={`btn ${p.popular ? 'solid' : 'ghost'} full`} href={wa(`Hi Myinvite! I'd like the ${p.name} plan (${p.price}).`)} target="_blank" rel="noopener">
                  Get {p.name}
                </a>
              </article>
            ))
          }
        </div>
        <p class="guarantee rv">
          <b>The Myinvite promise:</b> unlimited text revisions · full refund if you don’t love it ·
          a human on WhatsApp from first message to vidaai.
        </p>
      </section>

      <!-- ── Testimonials (sample copy — replace with real reviews before ads) ── -->
      <section class="voices">
        <div class="s-head rv">
          <div class="eyebrow light">From our couples</div>
          <h2>The reviews we live for.</h2>
        </div>
        <div class="voice-grid">
          {
            testimonials.map((t) => (
              <figure class="voice rv">
                <blockquote>“{t.quote}”</blockquote>
                <figcaption>{t.who}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <!-- ── FAQ ── -->
      <section id="faq" class="faq">
        <div class="s-head rv">
          <div class="eyebrow">Good to know</div>
          <h2>Questions, answered.</h2>
        </div>
        <div class="faq-list rv">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}<span aria-hidden="true">+</span></summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <!-- ── Final CTA ── -->
      <section class="final">
        <div class="rv">
          <h2>The shaadi is coming.<br /><em>Let’s make the invite unforgettable.</em></h2>
          <div class="final-ctas">
            <a class="btn gold" href={wa('Hi Myinvite! I want a wedding invitation website.')} target="_blank" rel="noopener">Message us on WhatsApp</a>
            <a class="btn ghost-l" href="#designs">Browse designs again</a>
          </div>
          <p class="final-note">Replies within the hour, every day 9 AM – 11 PM.</p>
        </div>
      </section>
    </main>

    <footer>
      <div class="f-brand">My<span>invite</span></div>
      <p class="f-line">Wedding invitation websites, made with love in India.</p>
      <div class="f-links">
        <a href={wa('Hi Myinvite!')} target="_blank" rel="noopener">WhatsApp</a>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a href={INSTAGRAM} target="_blank" rel="noopener">Instagram</a>
      </div>
      <div class="f-legal">© 2026 Myinvite · All designs are original work</div>
    </footer>

    <style>
      :root {
        --bg: #faf7f0;
        --bg2: #f1ebdd;
        --ink: #1e1b16;
        --mut: #6f6654;
        --gold: #b08a3e;
        --goldL: #d4a643;
        --dark: #171410;
        --wa: #1fa855;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font-family: 'Manrope', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased; overflow-x: clip;
      }
      a { text-decoration: none; color: inherit; }
      h1, h2, h3, .price { font-family: 'Fraunces', Georgia, serif; font-weight: 400; }
      h1 em, h2 em { font-style: italic; color: var(--gold); }
      :focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; border-radius: 3px; }
      section { padding: 100px 24px; }
      .s-head { text-align: center; max-width: 640px; margin: 0 auto; }
      .s-head p { font-size: 15px; line-height: 1.8; color: var(--mut); margin: 18px auto 0; }
      h2 { font-size: clamp(32px, 5.5vw, 52px); line-height: 1.12; margin: 14px 0 0; }
      .eyebrow {
        font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase;
        color: var(--gold); font-weight: 700;
      }
      .eyebrow.light { color: var(--goldL); }

      /* ── Nav ── */
      nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 50;
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        padding: 12px 22px;
        background: color-mix(in srgb, var(--bg) 80%, transparent);
        backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid #e5dcc6;
      }
      .logo { font-family: 'Fraunces', serif; font-size: 23px; letter-spacing: -0.01em; }
      .logo span { font-style: italic; color: var(--gold); }
      .nav-links { display: none; gap: 26px; }
      @media (min-width: 760px) { .nav-links { display: flex; } }
      .nav-links a { font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mut); font-weight: 600; }
      .nav-links a:hover { color: var(--ink); }
      .nav-cta {
        background: var(--wa); color: #fff; font-weight: 700; font-size: 13px;
        padding: 12px 20px; border-radius: 999px; transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 8px 20px -10px rgba(31, 168, 85, 0.7);
      }
      .nav-cta:hover { transform: translateY(-1px); }

      /* ── Hero ── */
      .hero {
        max-width: 1150px; margin: 0 auto; padding: 150px 24px 60px;
        display: grid; gap: 48px; align-items: center;
      }
      @media (min-width: 900px) { .hero { grid-template-columns: 1.15fr 0.85fr; padding-top: 170px; } }
      h1 { font-size: clamp(42px, 7vw, 76px); line-height: 1.05; margin: 18px 0 0; }
      .lead { font-size: 16.5px; line-height: 1.8; color: var(--mut); max-width: 480px; margin: 22px 0 0; }
      .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
      .btn {
        display: inline-block; padding: 16px 28px; border-radius: 999px;
        font-size: 13.5px; font-weight: 700; letter-spacing: 0.04em;
        transition: transform 0.2s, box-shadow 0.2s, background 0.2s, color 0.2s;
        min-height: 48px;
      }
      .btn:hover { transform: translateY(-2px); }
      .btn.solid { background: var(--ink); color: var(--bg); box-shadow: 0 14px 30px -16px rgba(30, 27, 22, 0.6); }
      .btn.solid:hover { background: var(--gold); color: #fff; }
      .btn.ghost { border: 1.5px solid #d9cfb4; color: var(--ink); }
      .btn.ghost:hover { border-color: var(--gold); color: var(--gold); }
      .btn.gold { background: var(--goldL); color: #241c0c; box-shadow: 0 14px 34px -14px rgba(212, 166, 67, 0.8); }
      .btn.ghost-l { border: 1.5px solid rgba(250, 247, 240, 0.4); color: var(--bg); }
      .btn.ghost-l:hover { border-color: var(--goldL); color: var(--goldL); }
      .btn.full { display: block; text-align: center; }
      .chips { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 28px 0 0; }
      .chips li {
        font-size: 12px; font-weight: 700; color: var(--mut);
        border: 1px solid #e0d7bf; border-radius: 999px; padding: 8px 16px;
        background: rgba(255, 255, 255, 0.5);
      }
      .chips li::before { content: '✓ '; color: var(--gold); }

      /* phone mockup */
      .hero-phone { position: relative; display: flex; justify-content: center; }
      .phone {
        position: relative; width: min(300px, 74vw); aspect-ratio: 9 / 18.6;
        border-radius: 42px; background: #14110d; padding: 12px;
        box-shadow: 0 60px 90px -40px rgba(30, 27, 22, 0.55), inset 0 0 0 2px #2e2a22;
        z-index: 1;
      }
      .notch {
        position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
        width: 34%; height: 22px; background: #14110d; border-radius: 0 0 14px 14px; z-index: 3;
      }
      .screen { position: relative; width: 100%; height: 100%; border-radius: 32px; overflow: hidden; }
      .screen img { width: 100%; height: 130%; object-fit: cover; animation: screenPan 12s ease-in-out infinite alternate; }
      @keyframes screenPan { from { transform: translateY(0); } to { transform: translateY(-18%); } }
      .screen-ui {
        position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 18px 20px;
        background: linear-gradient(transparent, rgba(20, 15, 8, 0.72));
        color: #fdf4e0; text-align: center;
      }
      .screen-ui b { display: block; font-family: 'Fraunces', serif; font-weight: 400; font-size: 24px; }
      .screen-ui span { font-size: 10.5px; letter-spacing: 0.24em; text-transform: uppercase; opacity: 0.85; }
      .phone-glow {
        position: absolute; inset: 10% 6%; border-radius: 50%;
        background: radial-gradient(circle, rgba(212, 166, 67, 0.35), transparent 70%);
        filter: blur(30px); z-index: 0;
      }

      /* ── Trust strip ── */
      .strip {
        display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 14px;
        padding: 22px 24px; background: var(--dark); color: #cfc4a8;
        font-size: 12.5px; font-weight: 600; letter-spacing: 0.06em;
      }
      .strip i { color: var(--gold); font-style: normal; }

      /* ── Designs ── */
      .designs { max-width: 1150px; margin: 0 auto; }
      .grid {
        display: grid; gap: 26px; margin-top: 56px;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      }
      .card {
        background: #fff; border: 1px solid #eae2cd; overflow: hidden; border-radius: 14px;
        box-shadow: 0 30px 60px -45px rgba(30, 27, 22, 0.4);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
      }
      .card:hover { transform: translateY(-6px); box-shadow: 0 42px 70px -40px rgba(30, 27, 22, 0.5); }
      .thumb { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; }
      .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
      .card:hover .thumb img { transform: scale(1.05); }
      .preview-pill {
        position: absolute; right: 12px; bottom: 12px;
        background: rgba(20, 17, 13, 0.72); color: #fdf4e0; backdrop-filter: blur(6px);
        font-size: 11.5px; font-weight: 700; padding: 9px 14px; border-radius: 999px;
      }
      .card-body { padding: 22px 24px 26px; }
      .card-top { display: flex; justify-content: space-between; align-items: center; }
      .tag { font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--acc); font-weight: 800; }
      .dots { display: flex; gap: 5px; }
      .dots i { width: 14px; height: 14px; border-radius: 50%; border: 1px solid rgba(0, 0, 0, 0.12); }
      .card h3 { font-size: 27px; margin: 10px 0 6px; }
      .card-body p { font-size: 13.5px; line-height: 1.7; color: var(--mut); margin: 0 0 18px; }
      .card-ctas { display: flex; gap: 10px; flex-wrap: wrap; }
      .mini {
        font-size: 12px; font-weight: 700; padding: 11px 18px; border-radius: 999px;
        border: 1.5px solid #e0d7bf; color: var(--ink); transition: all 0.25s; min-height: 40px;
      }
      .mini:hover { border-color: var(--acc); color: var(--acc); }
      .mini.solid { background: var(--acc); border-color: var(--acc); color: #fff; }
      .mini.solid:hover { filter: brightness(1.1); color: #fff; }

      /* ── Why ── */
      .why { background: var(--dark); color: #f2ead6; }
      .why h2 { color: #f2ead6; }
      .why-grid {
        max-width: 1000px; margin: 56px auto 0;
        display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
      }
      .why-item {
        border: 1px solid rgba(212, 166, 67, 0.22); border-radius: 12px; padding: 26px;
        background: rgba(212, 166, 67, 0.05);
      }
      .why-item b { font-family: 'Fraunces', serif; font-weight: 400; font-size: 21px; }
      .why-item p { font-size: 13.5px; line-height: 1.75; color: #bfb394; margin: 10px 0 0; }

      /* ── How ── */
      .how { max-width: 960px; margin: 0 auto; }
      .steps {
        list-style: none; padding: 0; margin: 56px 0 0;
        display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        counter-reset: step;
      }
      .steps li { background: #fff; border: 1px solid #eae2cd; border-radius: 14px; padding: 30px 26px; }
      .num {
        display: flex; align-items: center; justify-content: center;
        width: 44px; height: 44px; border-radius: 50%; background: var(--bg2);
        font-family: 'Fraunces', serif; font-size: 20px; color: var(--gold);
        border: 1px solid #e0d7bf; margin-bottom: 16px;
      }
      .steps b { font-family: 'Fraunces', serif; font-weight: 400; font-size: 22px; }
      .steps p { font-size: 13.5px; line-height: 1.75; color: var(--mut); margin: 10px 0 0; }
      .how-cta { text-align: center; margin-top: 44px; }

      /* ── Pricing ── */
      .pricing { background: var(--bg2); }
      .plans {
        max-width: 1050px; margin: 56px auto 0;
        display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        align-items: start;
      }
      .plan {
        position: relative; background: #fff; border: 1px solid #e5dcc6; border-radius: 16px;
        padding: 34px 30px;
      }
      .plan.popular {
        border: 2px solid var(--goldL);
        box-shadow: 0 40px 70px -40px rgba(176, 138, 62, 0.55);
        transform: translateY(-6px);
      }
      .pop-badge {
        position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
        background: var(--goldL); color: #241c0c; font-size: 11px; font-weight: 800;
        letter-spacing: 0.14em; text-transform: uppercase; padding: 6px 16px; border-radius: 999px;
        white-space: nowrap;
      }
      .plan h3 { font-size: 24px; margin: 0; }
      .price { font-size: 44px; margin: 8px 0 2px; }
      .tagline { font-size: 13px; color: var(--mut); font-weight: 600; }
      .plan ul { list-style: none; padding: 0; margin: 22px 0 26px; display: flex; flex-direction: column; gap: 10px; }
      .plan li { font-size: 13.5px; line-height: 1.6; color: var(--mut); padding-left: 22px; position: relative; }
      .plan li::before { content: '✓'; position: absolute; left: 0; color: var(--gold); font-weight: 800; }
      .guarantee {
        text-align: center; max-width: 620px; margin: 44px auto 0;
        font-size: 13.5px; line-height: 1.8; color: var(--mut);
        border: 1px dashed #cdbf9a; border-radius: 12px; padding: 18px 22px; background: rgba(255, 255, 255, 0.6);
      }
      .guarantee b { color: var(--ink); }

      /* ── Voices ── */
      .voices { background: var(--dark); color: #f2ead6; }
      .voices h2 { color: #f2ead6; }
      .voice-grid {
        max-width: 1000px; margin: 52px auto 0;
        display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
      }
      .voice { margin: 0; border: 1px solid rgba(242, 234, 214, 0.14); border-radius: 12px; padding: 28px 26px; background: rgba(242, 234, 214, 0.04); }
      .voice blockquote { margin: 0; font-family: 'Fraunces', serif; font-size: 17.5px; line-height: 1.65; font-style: italic; }
      .voice figcaption { margin-top: 16px; font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--goldL); font-weight: 700; }

      /* ── FAQ ── */
      .faq { max-width: 680px; margin: 0 auto; }
      .faq-list { margin-top: 40px; }
      details { border-bottom: 1px solid #e5dcc6; }
      summary {
        cursor: pointer; list-style: none; display: flex; justify-content: space-between;
        align-items: center; gap: 16px; padding: 22px 4px;
        font-family: 'Fraunces', serif; font-size: 19px;
      }
      summary::-webkit-details-marker { display: none; }
      summary span { color: var(--gold); font-size: 22px; flex: none; transition: transform 0.3s; }
      details[open] summary span { transform: rotate(45deg); }
      details p { font-size: 14px; line-height: 1.8; color: var(--mut); margin: 0; padding: 0 4px 24px; }

      /* ── Final ── */
      .final { background: linear-gradient(160deg, #241c0c, #171410); color: var(--bg); text-align: center; padding: 110px 24px; }
      .final h2 { color: var(--bg); font-size: clamp(34px, 6vw, 58px); }
      .final em { color: var(--goldL); }
      .final-ctas { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 36px; }
      .final-note { font-size: 12.5px; color: rgba(250, 247, 240, 0.55); margin-top: 22px; letter-spacing: 0.06em; }

      /* ── Footer ── */
      footer { background: #100e0a; color: #a99e85; text-align: center; padding: 60px 24px; }
      .f-brand { font-family: 'Fraunces', serif; font-size: 30px; color: #f2ead6; }
      .f-brand span { font-style: italic; color: var(--goldL); }
      .f-line { font-size: 13px; margin: 10px 0 22px; }
      .f-links { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; font-size: 13px; font-weight: 600; }
      .f-links a:hover { color: var(--goldL); }
      .f-legal { font-size: 11.5px; margin-top: 30px; opacity: 0.6; }

      /* reveals */
      html.js .rv { opacity: 0; }
      html.js .rv.in { animation: rise 0.85s ease both; opacity: 1; }
      @keyframes rise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01s !important; animation-delay: 0s !important; transition: none !important; }
        html { scroll-behavior: auto; }
      }
    </style>

    <script>
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
        { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
      );
      document.querySelectorAll('.rv').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
