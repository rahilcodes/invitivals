          transition-duration: 0.01ms !important;
        }
        html.js .rv {
          opacity: 1;
          transform: none;
        }
      }
    </style>

    <script>
      /* ── reveal each screen as it arrives ── */
      const screens = Array.from(document.querySelectorAll('.scr'));
      const nav = document.querySelector('nav');
      const rail = document.querySelector('.rail');
      const railLinks = Array.from(document.querySelectorAll('[data-rail]'));

      /* threshold 0 rather than a fraction: on phones a section can be
         several viewports tall, and any fractional threshold would never
         be met — the screen would simply never reveal itself */
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) e.target.classList.add('in');
          });
        },
        { threshold: 0, rootMargin: '0px 0px -8% 0px' }
      );
      screens.forEach((s) => io.observe(s));

      /* ── nav + rail adapt to whichever screen is behind the nav bar ──
         Measured against the nav line instead of an intersection ratio,
         so it stays correct however tall a section grows. */
      let queued = false;
      const syncTheme = () => {
        queued = false;
        if (!screens.length) return;
        const line = (nav ? nav.offsetHeight : 0) + 4;
        let current = screens[0];
        for (const s of screens) {
          const r = s.getBoundingClientRect();
          if (r.top <= line && r.bottom > line) {
            current = s;
            break;
          }
          if (r.top > line) break;
          current = s;
        }
        const dark = current.classList.contains('dark') || current.classList.contains('exp');
        nav?.classList.toggle('on-dark', dark);
        rail?.classList.toggle('on-dark', dark);
        railLinks.forEach((a) => a.classList.toggle('on', a.getAttribute('data-rail') === current.id));
      };
      const queueSync = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(syncTheme);
      };
      addEventListener('scroll', queueSync, { passive: true });
      addEventListener('resize', queueSync);
      syncTheme();

      /* ── the hero seal: tap to open, tap the note to seal again ── */
      const invite = document.getElementById('invite');
      invite?.addEventListener('click', (ev) => {
        const target = ev.target;
        if (target && target.classList && target.classList.contains('reseal')) {
          invite.classList.remove('open');
          return;
        }
        invite.classList.toggle('open');
      });

      /* ── the collection: pick a world, the stage changes ── */
      const picks = Array.from(document.querySelectorAll('[data-pick]'));
      const stages = Array.from(document.querySelectorAll('[data-stage]'));
      const out = (key) => document.querySelector('[data-out="' + key + '"]');
      const dataEl = document.getElementById('design-data');
      const DATA = JSON.parse((dataEl && dataEl.textContent) || '[]');

      const select = (i) => {
        picks.forEach((p, j) => {
          p.classList.toggle('on', i === j);
          p.setAttribute('aria-selected', String(i === j));
        });
        stages.forEach((s, j) => s.classList.toggle('on', i === j));
        const d = DATA[i];
        if (!d) return;
        const tag = out('tag');
        const title = out('title');
        const desc = out('desc');
        const demo = out('demo');
        const waLink = out('wa');
        if (tag) tag.textContent = d.tag;
        if (title) title.textContent = d.title;
        if (desc) desc.textContent = d.desc;
        if (demo) demo.href = d.href;
        if (waLink) waLink.href = d.wa;
      };

      picks.forEach((p, i) => {
        p.addEventListener('click', () => select(i));
        p.addEventListener('mouseenter', () => select(i));
      });

      /* ── keep only one FAQ open where `name` is unsupported ── */
      const faqItems = Array.from(document.querySelectorAll('.faq-list details'));
      if (!('name' in document.createElement('details'))) {
        faqItems.forEach((d) =>
          d.addEventListener('toggle', () => {
            if (d.open) faqItems.forEach((o) => o !== d && (o.open = false));
          })
        );
      }
    </script>

    <script id="design-data" type="application/json" is:inline set:html={JSON.stringify(
      designs.map((d) => ({
        tag: d.tag,
        title: d.title,
        desc: d.desc,
        href: d.href,
        wa: wa(`Hi Invitivals! I love the ${d.title} (${d.tag}) design. I'd like it for my wedding.`),
      }))
    )} />
  </body>
</html>
