---
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/400-italic.css';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/700.css';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Kabir &amp; Naina — 12.12.26</title>
  <meta name="description" content="Kabir Malhotra and Naina Rao are doing the thing. Sunset vows, 12.12.26, AER at Four Seasons, Worli, Mumbai. RSVP by November 28." />
  <meta property="og:title" content="Kabir & Naina — 12.12.26" />
  <meta property="og:description" content="We're doing the thing. Sunset vows, 34 floors above Mumbai. RSVP by November 28, 2026." />
  <meta property="og:image" content="/art/modern/hero.svg" />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#1A1A1E" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%231A1A1E'/%3E%3Ctext x='32' y='46' font-family='Georgia,serif' font-style='italic' font-size='40' text-anchor='middle' fill='%23E2725B'%3E%26amp;%3C/text%3E%3C/svg%3E" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body class="locked">

  <!-- 1 · INTRO SPLASH -->
  <button id="splash" class="splash" aria-label="Enter the wedding site of Kabir and Naina">
    <span class="splash-kicker">The wedding of</span>
    <span class="splash-mark" aria-hidden="true">K<em>&amp;</em>N</span>
    <span class="splash-hint">tap anywhere to enter</span>
  </button>

  <!-- 2 · STICKY TOP BAR -->
  <header class="topbar">
    <a class="topbar-mark" href="#top" aria-label="Kabir and Naina — back to top">K<em>&amp;</em>N</a>
    <span class="topbar-date">12 · 12 · 26</span>
    <a class="pill pill-solid topbar-rsvp" href="#rsvp">RSVP</a>
  </header>

  <main id="top">

    <!-- 3 · MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="mq-track">
        <span class="mq-chunk">KABIR &amp; NAINA — 12.12.26 — WORLI, MUMBAI — SUNSET VOWS — KABIR &amp; NAINA — 12.12.26 — WORLI, MUMBAI — SUNSET VOWS — KABIR &amp; NAINA — 12.12.26 — WORLI, MUMBAI — SUNSET VOWS —&nbsp;</span>
        <span class="mq-chunk">KABIR &amp; NAINA — 12.12.26 — WORLI, MUMBAI — SUNSET VOWS — KABIR &amp; NAINA — 12.12.26 — WORLI, MUMBAI — SUNSET VOWS — KABIR &amp; NAINA — 12.12.26 — WORLI, MUMBAI — SUNSET VOWS —&nbsp;</span>
      </div>
    </div>

    <!-- 4 · HERO -->
    <section class="hero glowhost" aria-labelledby="hero-h">
      <div class="glow" aria-hidden="true"></div>
      <img class="hero-art" src="/art/modern/hero.svg" alt="Illustration of Kabir and Naina beneath a terracotta arch, a sun orb glowing behind them" width="1600" height="1000" />
      <div class="wrap hero-copy">
        <h1 id="hero-h" class="clip"><span>We're doing</span><span><em>the thing.</em></span></h1>
        <p class="hero-sub rv">After 7 years, 3 cities and one very persuasive dog — we're getting married.</p>
        <p class="hero-meta rv">Saturday, December 12, 2026 · vows at sunset, 5:30 PM<br />AER, Four Seasons, Worli, Mumbai</p>
      </div>
    </section>

    <!-- 5 · THE PLAN -->
    <section class="section" id="plan" aria-labelledby="plan-h">
      <div class="wrap">
        <p class="kicker rv">Saturday · 12.12.26</p>
        <h2 id="plan-h" class="h2 rv">The <em>plan.</em></h2>
        <ol class="plan">
          <li class="plan-row rv">
            <span class="plan-num" aria-hidden="true">01</span>
            <img class="plan-art" src="/art/modern/event-1.svg" alt="Two interlocked wedding rings, graphic illustration" width="600" height="600" loading="lazy" />
            <div class="plan-body">
              <h3>The Vows</h3>
              <p>Short, we promise.</p>
            </div>
            <span class="plan-time">5:30 PM</span>
          </li>
          <li class="plan-row rv">
            <span class="plan-num" aria-hidden="true">02</span>
            <img class="plan-art" src="/art/modern/event-2.svg" alt="Cocktail glass with a citrus twist, graphic illustration" width="600" height="600" loading="lazy" />
            <div class="plan-body">
              <h3>Golden hour</h3>
              <p>Cocktails 34 floors up.</p>
            </div>
            <span class="plan-time">6:15 PM</span>
          </li>
          <li class="plan-row rv">
            <span class="plan-num" aria-hidden="true">03</span>
            <img class="plan-art" src="/art/modern/event-4.svg" alt="Laid table with plates and glasses, graphic illustration" width="600" height="600" loading="lazy" />
            <div class="plan-body">
              <h3>Dinner &amp; chaos</h3>
              <p>Long table, longer toasts.</p>
            </div>
            <span class="plan-time">8:00 PM</span>
          </li>
          <li class="plan-row rv">
            <span class="plan-num" aria-hidden="true">04</span>
            <img class="plan-art" src="/art/modern/event-3.svg" alt="Disco ball throwing sparkles, graphic illustration" width="600" height="600" loading="lazy" />
            <div class="plan-body">
              <h3>Dance floor</h3>
              <p>No requests refused.</p>
            </div>
            <span class="plan-time">10:00 PM</span>
          </li>
        </ol>
        <p class="plan-foot rv"><strong>Sunday:</strong> recovery brunch, 11:30 AM, Olive Bandra. Optional. Recommended.</p>
      </div>
    </section>

    <!-- 6 · STORY -->
    <section class="section section-alt" id="story" aria-labelledby="story-h">
      <div class="wrap">
        <p class="kicker rv">How we got here</p>
        <h2 id="story-h" class="h2 rv">Three beats, <em>seven years.</em></h2>
        <div class="story-grid">
          <figure class="story-art rv">
            <img src="/art/modern/couple.svg" alt="Kabir and Naina standing together inside a terracotta arch, graphic illustration" width="900" height="1150" loading="lazy" />
            <figcaption>Exhibit A. The persuasive dog not pictured.</figcaption>
          </figure>
          <div class="story-beats">
            <blockquote class="beat rv">
              <span class="beat-year">2019</span>
              <p>She stole his cab at Bandra station. He let her.</p>
            </blockquote>
            <blockquote class="beat beat-right rv">
              <span class="beat-year">2023</span>
              <p>Moved in together. The dog voted yes.</p>
            </blockquote>
            <blockquote class="beat rv">
              <span class="beat-year">2026</span>
              <p>He asked at 2 AM over leftover biryani. Obviously yes.</p>
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- 7 · VENUE -->
    <section class="section" id="venue" aria-labelledby="venue-h">
      <div class="wrap">
        <p class="kicker rv">The where</p>
        <h2 id="venue-h" class="h2 h2-xl rv">34 floors <em>above Mumbai.</em></h2>
        <p class="venue-line rv">AER, Four Seasons · Worli, Mumbai. Sunset does the decor, we do the drinks.</p>
        <div class="map-frame rv">
          <iframe src="https://www.google.com/maps?q=19.0176,72.8172&z=15&output=embed" title="Map to AER, Four Seasons Hotel, Worli, Mumbai" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
        <p class="rv"><a class="pill pill-line" href="https://www.google.com/maps/dir/?api=1&destination=Four+Seasons+Hotel+Mumbai" target="_blank" rel="noopener">Get directions ↗</a></p>
      </div>
    </section>

    <!-- 8 · COUNTDOWN -->
    <section class="section countdown glowhost" id="countdown" aria-labelledby="cd-h">
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap">
        <h2 id="cd-h" class="kicker rv">Counting down</h2>
        <div class="cd-grid rv" role="timer" aria-label="Countdown to the wedding">
          <div class="cd-cell"><span class="cd-num" id="cd-d">000</span><span class="cd-lab">days</span></div>
          <div class="cd-cell"><span class="cd-num" id="cd-h2">00</span><span class="cd-lab">hrs</span></div>
          <div class="cd-cell"><span class="cd-num" id="cd-m">00</span><span class="cd-lab">min</span></div>
          <div class="cd-cell"><span class="cd-num" id="cd-s">00</span><span class="cd-lab">sec</span></div>
        </div>
        <p class="cd-cap rv">until sunset</p>
      </div>
    </section>

    <!-- 9 · DRESS CODE -->
    <section class="section section-alt" id="dress" aria-labelledby="dress-h">
      <div class="wrap">
        <p class="kicker rv">Dress code</p>
        <h2 id="dress-h" class="h2 rv">Wear what makes you <em>feel expensive.</em></h2>
        <p class="dress-line rv">Cocktail. Comfortable shoes non-negotiable — see item 04 of the plan.</p>
        <div class="chips rv" role="group" aria-label="Suggested colours">
          <button class="chip" type="button" aria-pressed="false"><span class="chip-dot" style="background:#E2725B"></span><span class="chip-lab">Terracotta</span></button>
          <button class="chip" type="button" aria-pressed="false"><span class="chip-dot" style="background:#E8DCC8"></span><span class="chip-lab">Sand</span></button>
          <button class="chip" type="button" aria-pressed="false"><span class="chip-dot" style="background:#232329;box-shadow:inset 0 0 0 1px #4a4a52"></span><span class="chip-lab">Charcoal</span></button>
          <button class="chip" type="button" aria-pressed="false"><span class="chip-dot" style="background:#6B7245"></span><span class="chip-lab">Olive</span></button>
        </div>
      </div>
    </section>

    <!-- 10 · PLAYLIST WALL -->
    <section class="section" id="playlist" aria-labelledby="pl-h">
      <div class="wrap">
        <p class="kicker rv">The signature request</p>
        <h2 id="pl-h" class="h2 rv">What song gets you <em>on the floor?</em></h2>
        <p class="pl-line rv">Add it below. The DJ has been briefed to trust you completely.</p>
        <form class="pl-form rv" id="pl-form">
          <label class="sr-only" for="pl-input">Song and artist</label>
          <input id="pl-input" type="text" placeholder="Song — Artist" autocomplete="off" maxlength="80" required />
          <button class="pill pill-solid" type="submit">Add it</button>
        </form>
        <ol class="tracklist rv" id="tracklist" aria-live="polite" aria-label="Guest playlist">
          <li>Chaiyya Chaiyya — Sukhwinder Singh</li>
          <li>September — Earth, Wind &amp; Fire</li>
          <li>Levitating — Dua Lipa</li>
        </ol>
      </div>
    </section>

    <!-- 11 · GALLERY -->
    <section class="section section-alt" id="gallery" aria-labelledby="gal-h">
      <div class="wrap">
        <p class="kicker rv">Mood board</p>
        <h2 id="gal-h" class="h2 rv">Loosely <em>the vibe.</em></h2>
      </div>
      <div class="rail rv" tabindex="0" role="region" aria-label="Gallery — scroll sideways">
        <figure class="frame frame-tall"><img src="/art/modern/gallery-1.svg" alt="Abstract sunset in terracotta and peach bands" width="800" height="1000" loading="lazy" /></figure>
        <figure class="frame frame-sq"><img src="/art/modern/gallery-2.svg" alt="Bold K and N typographic artwork" width="800" height="800" loading="lazy" /></figure>
        <figure class="frame frame-tall"><img src="/art/modern/gallery-3.svg" alt="Checkerboard pattern in sand and charcoal" width="800" height="1000" loading="lazy" /></figure>
        <figure class="frame frame-sq"><img src="/art/modern/gallery-4.svg" alt="Sun and moon side by side, graphic artwork" width="800" height="800" loading="lazy" /></figure>
      </div>
    </section>

    <!-- 12 · RSVP -->
    <section class="band" id="rsvp" aria-labelledby="rsvp-h">
      <div class="wrap">
        <div class="card rv">
          <p class="kicker kicker-dark">RSVP by November 28, 2026</p>
          <h2 id="rsvp-h" class="h2 card-h">Are you <em>in?</em></h2>
          <form id="rsvp-form">
            <label class="lab" for="r-name">Your name</label>
            <input id="r-name" type="text" autocomplete="name" placeholder="Full name" required />
            <fieldset class="opts">
              <legend class="lab">The answer</legend>
              <label class="opt"><input type="radio" name="attend" value="yes" required /><span>Obviously coming</span></label>
              <label class="opt"><input type="radio" name="attend" value="no" /><span>Regret forever</span></label>
            </fieldset>
            <div class="stepper-row">
              <span class="lab" id="guests-lab">Guests</span>
              <div class="stepper" role="group" aria-labelledby="guests-lab">
                <button type="button" class="step-btn" id="step-minus" aria-label="Fewer guests">−</button>
                <span class="step-count" id="step-count" aria-live="polite">1</span>
                <button type="button" class="step-btn" id="step-plus" aria-label="More guests">+</button>
              </div>
            </div>
            <label class="lab" for="r-note">Anything we should know?</label>
            <textarea id="r-note" rows="3" placeholder="Dietary drama, song bribes, etc."></textarea>
            <button class="pill pill-solid btn-sub" id="rsvp-submit" type="submit">Send it</button>
          </form>
          <div class="thanks" id="rsvp-thanks" hidden>
            <p class="thanks-msg" id="thanks-msg"></p>
            <button class="linkish" id="rsvp-change" type="button">Change reply</button>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- 13 · FOOTER -->
  <footer class="footer">
    <p class="foot-mark" aria-hidden="true">K<em>&amp;</em>N</p>
    <p class="foot-date">Saturday, December 12, 2026 · Worli, Mumbai</p>
    <p class="foot-tag">#KabirXNaina</p>
    <p class="foot-fine">Made with love &amp; spreadsheets</p>
  </footer>

  <!-- MUSIC TOGGLE -->
  <button class="music" id="music" type="button" aria-label="Toggle music" aria-pressed="false">
    <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>

<style is:global>
  :root {
    --bg: #1A1A1E;
    --bg2: #232329;
    --acc: #E2725B;
    --acc2: #F2A488;
    --sand: #E8DCC8;
    --ink: #F5F1E8;
    --mut: #8E8B84;
    --hair: rgba(232, 220, 200, 0.16);
    --fd: 'Fraunces', Georgia, serif;
    --fb: 'Archivo', system-ui, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--fb);
    font-size: 16px;
    line-height: 1.6;
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
  }
  body.locked { overflow: hidden; height: 100dvh; }
  img { display: block; max-width: 100%; height: auto; }
  em { font-style: italic; }
  :focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; border-radius: 2px; }
  .band :focus-visible { outline-color: var(--bg); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .wrap { max-width: 1060px; margin-inline: auto; padding-inline: clamp(20px, 5vw, 48px); }

  /* ---------- type ---------- */
  .kicker {
    font: 700 12px/1.4 var(--fb);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--acc);
    margin-bottom: 18px;
  }
  .kicker-dark { color: var(--acc); }
  .h2 {
    font: 600 clamp(2.2rem, 6.5vw, 4.2rem)/1.05 var(--fd);
    letter-spacing: -0.02em;
    margin-bottom: clamp(20px, 4vw, 36px);
  }
  .h2 em { color: var(--acc); }
  .h2-xl { font-size: clamp(2.6rem, 8.5vw, 5.6rem); }

  /* ---------- splash ---------- */
  .splash {
    position: fixed; inset: 0; z-index: 100;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    width: 100%; border: 0; cursor: pointer;
    background: var(--bg); color: var(--ink); font-family: var(--fb);
    transition: transform 0.85s cubic-bezier(0.76, 0, 0.24, 1), visibility 0s linear 0.85s;
  }
  .splash.done { transform: translateY(-101%); visibility: hidden; }
  .splash-kicker { font: 700 12px/1 var(--fb); letter-spacing: 0.3em; text-transform: uppercase; color: var(--mut); }
  .splash-mark {
    font: italic 400 clamp(120px, 26vw, 200px)/0.9 var(--fd);
    letter-spacing: -0.04em; color: var(--ink);
    animation: rise 1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .splash-mark em { color: var(--acc); }
  .splash-hint {
    font: 500 13px/1 var(--fb); letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--mut); margin-top: 22px; animation: blink 2.4s ease-in-out infinite;
  }

  /* ---------- topbar ---------- */
  .topbar {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 10px clamp(16px, 4vw, 32px);
    background: rgba(26, 26, 30, 0.82);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hair);
  }
  .topbar-mark {
    font: italic 400 clamp(1.5rem, 4vw, 1.9rem)/1 var(--fd);
    color: var(--ink); text-decoration: none; padding: 8px 4px;
  }
  .topbar-mark em { color: var(--acc); }
  .topbar-date { font: 700 12px/1 var(--fb); letter-spacing: 0.22em; color: var(--mut); }

  /* ---------- pills ---------- */
  .pill {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 44px; padding: 10px 26px; border-radius: 999px;
    font: 700 14px/1 var(--fb); letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; cursor: pointer; border: 0;
    transition: transform 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .pill-solid { background: var(--acc); color: var(--bg); }
  .pill-solid:hover { background: var(--acc2); }
  .pill-line { background: transparent; color: var(--acc); box-shadow: inset 0 0 0 1.5px var(--acc); }
  .pill-line:hover { background: var(--acc); color: var(--bg); }

  /* ---------- marquee ---------- */
  .marquee { background: var(--acc); overflow: clip; }
  .mq-track { display: flex; width: max-content; animation: mq 26s linear infinite; }
  .mq-chunk {
    white-space: nowrap; padding-block: 12px;
    font: 700 13px/1 var(--fb); letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--bg);
  }

  /* ---------- hero ---------- */
  .hero { position: relative; overflow: clip; }
  .hero-art { width: 100%; height: 70svh; min-height: 420px; object-fit: cover; }
  .hero-copy { position: relative; margin-top: clamp(-120px, -14vw, -60px); padding-bottom: clamp(48px, 8vw, 90px); }
  .hero h1 {
    font: 600 clamp(3rem, 10.5vw, 7.5rem)/0.98 var(--fd);
    letter-spacing: -0.03em; text-shadow: 0 4px 40px rgba(26, 26, 30, 0.7);
  }
  .hero h1 em { color: var(--acc); font-weight: 400; }
  .hero-sub {
    font: italic 400 clamp(1.15rem, 3vw, 1.6rem)/1.4 var(--fd);
    color: var(--sand); max-width: 34ch; margin-top: 22px;
  }
  .hero-meta { font: 500 14px/1.8 var(--fb); letter-spacing: 0.12em; text-transform: uppercase; color: var(--mut); margin-top: 22px; }

  /* clip reveal for huge type */
  .clip span { display: block; overflow: clip; }
  html.js .clip span { clip-path: inset(0 0 100% 0); transform: translateY(0.35em); }
  html.js .clip.in span { animation: clipup 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  html.js .clip.in span:nth-child(2) { animation-delay: 0.14s; }

  /* cursor glow (desktop only) */
  .glowhost { position: relative; }
  .glow {
    display: none; position: absolute; top: 0; left: 0; z-index: 1;
    width: 560px; height: 560px; margin: -280px 0 0 -280px; border-radius: 50%;
    background: radial-gradient(circle, rgba(226, 114, 91, 0.14), transparent 62%);
    pointer-events: none; opacity: 0; transition: opacity 0.5s ease;
    will-change: transform;
  }
  @media (pointer: fine) { .glow { display: block; } }
  .glowhost.lit .glow { opacity: 1; }
  .hero-copy, .countdown .wrap { position: relative; z-index: 2; }

  /* ---------- sections ---------- */
  .section { padding-block: clamp(64px, 11vw, 130px); }
  .section-alt { background: var(--bg2); }

  /* ---------- plan ---------- */
  .plan { list-style: none; padding: 0; border-top: 1px solid var(--hair); }
  .plan-row {
    display: grid; grid-template-columns: auto 72px 1fr auto; align-items: center;
    gap: clamp(14px, 3vw, 30px); padding-block: clamp(18px, 3vw, 30px);
    border-bottom: 1px solid var(--hair);
  }
  .plan-num {
    font: italic 400 clamp(2.6rem, 8vw, 5.2rem)/1 var(--fd);
    color: transparent; -webkit-text-stroke: 1.5px var(--acc); min-width: 1.6em;
  }
  .plan-art { width: 72px; height: 72px; background: var(--bg2); border: 1px solid var(--hair); }
  .plan-body h3 { font: 600 clamp(1.25rem, 3.4vw, 1.8rem)/1.15 var(--fd); letter-spacing: -0.01em; }
  .plan-body p { font: italic 400 1rem/1.5 var(--fd); color: var(--mut); }
  .plan-time { font: 700 13px/1 var(--fb); letter-spacing: 0.16em; color: var(--sand); white-space: nowrap; }
  .plan-foot { margin-top: 26px; font-size: 14.5px; color: var(--mut); }
  .plan-foot strong { color: var(--acc); text-transform: uppercase; letter-spacing: 0.1em; font-size: 12.5px; }
  @media (max-width: 560px) {
    .plan-row { grid-template-columns: auto 1fr auto; }
    .plan-art { display: none; }
  }

  /* ---------- story ---------- */
  .story-grid { display: grid; grid-template-columns: minmax(200px, 320px) 1fr; gap: clamp(28px, 6vw, 70px); align-items: center; }
  .story-art { transform: rotate(-2deg); }
  .story-art img { border: 1px solid var(--sand); padding: 10px; background: var(--bg); }
  .story-art figcaption { font: italic 400 0.85rem/1.5 var(--fd); color: var(--mut); margin-top: 10px; text-align: center; }
  .story-beats { display: flex; flex-direction: column; gap: clamp(34px, 6vw, 60px); }
  .beat { position: relative; max-width: 26ch; padding-top: 8px; }
  .beat::before {
    content: '\201C'; position: absolute; top: -0.28em; left: -0.08em; z-index: -1;
    font: 600 clamp(5rem, 12vw, 8rem)/1 var(--fd); color: var(--acc); opacity: 0.35;
  }
  .beat-year { font: 700 13px/1 var(--fb); letter-spacing: 0.26em; color: var(--acc); }
  .beat p { font: italic 400 clamp(1.4rem, 4vw, 2.2rem)/1.25 var(--fd); margin-top: 10px; letter-spacing: -0.01em; }
  .beat-right { align-self: flex-end; text-align: right; }
  .beat-right::before { left: auto; right: -0.08em; }
  @media (max-width: 720px) {
    .story-grid { grid-template-columns: 1fr; }
    .story-art { max-width: 260px; margin-inline: auto; }
  }

  /* ---------- venue ---------- */
  .venue-line { font: italic 400 clamp(1.05rem, 2.6vw, 1.35rem)/1.5 var(--fd); color: var(--sand); max-width: 44ch; margin-bottom: 30px; }
  .map-frame { border: 1px solid var(--sand); padding: 8px; background: var(--bg2); margin-bottom: 26px; }
  .map-frame iframe { display: block; width: 100%; height: 300px; border: 0; filter: grayscale(0.35) contrast(1.05); }

  /* ---------- countdown ---------- */
  .countdown { background: var(--bg2); overflow: clip; text-align: center; }
  .cd-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(8px, 2vw, 24px); }
  .cd-num {
    display: block; font: 600 clamp(2.6rem, 11vw, 8.75rem)/1 var(--fd);
    letter-spacing: -0.03em; font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .cd-lab { display: block; margin-top: 10px; font: 700 11px/1 var(--fb); letter-spacing: 0.3em; text-transform: uppercase; color: var(--mut); }
  .cd-cap { margin-top: 28px; font: italic 400 clamp(1.1rem, 3vw, 1.5rem)/1 var(--fd); color: var(--acc); }
  @media (max-width: 560px) { .cd-grid { grid-template-columns: repeat(2, 1fr); row-gap: 26px; } }

  /* ---------- dress chips ---------- */
  .dress-line { max-width: 46ch; color: var(--sand); margin-bottom: 30px; }
  .chips { display: flex; flex-wrap: wrap; gap: 12px; }
  .chip {
    display: inline-flex; align-items: center; height: 52px; padding: 7px;
    border: 1px solid var(--hair); border-radius: 999px; background: var(--bg);
    cursor: pointer; color: var(--ink); overflow: clip;
    transition: border-color 0.3s ease;
  }
  .chip:hover, .chip.open { border-color: var(--acc); }
  .chip-dot { width: 36px; height: 36px; border-radius: 50%; flex: 0 0 auto; }
  .chip-lab {
    max-width: 0; opacity: 0; overflow: clip; white-space: nowrap;
    font: 700 12.5px/1 var(--fb); letter-spacing: 0.14em; text-transform: uppercase;
    transition: max-width 0.35s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease, padding 0.35s ease;
  }
  .chip:hover .chip-lab, .chip.open .chip-lab { max-width: 140px; opacity: 1; padding-inline: 12px 10px; }
  .chip.open .chip-dot { animation: chippop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }

  /* ---------- playlist ---------- */
  .pl-line { color: var(--mut); margin-bottom: 26px; }
  .pl-form { display: flex; gap: 10px; max-width: 560px; margin-bottom: 34px; flex-wrap: wrap; }
  .pl-form input {
    flex: 1 1 220px; min-height: 48px; padding: 10px 22px; border-radius: 999px;
    background: var(--bg2); border: 1px solid var(--hair); color: var(--ink);
    font: 500 15px/1.4 var(--fb);
  }
  .pl-form input::placeholder { color: var(--mut); }
  .pl-form input:focus-visible { outline-offset: 0; border-color: var(--acc); }
  .tracklist { list-style: none; padding: 0; counter-reset: track; max-width: 640px; border-top: 1px solid var(--hair); }
  .tracklist li {
    counter-increment: track; display: flex; align-items: baseline; gap: 18px;
    padding: 14px 4px; border-bottom: 1px solid var(--hair);
    font: 500 clamp(1rem, 2.6vw, 1.2rem)/1.4 var(--fb);
  }
  .tracklist li::before {
    content: counter(track, decimal-leading-zero);
    font: italic 400 1.15em/1 var(--fd); color: var(--acc); min-width: 2ch;
  }
  .tracklist li.fresh { animation: rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }

  /* ---------- gallery ---------- */
  .rail {
    display: flex; align-items: center; gap: clamp(16px, 3vw, 30px);
    overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 8px clamp(20px, 5vw, 48px) 26px;
    scrollbar-color: var(--acc) var(--bg2);
  }
  .frame {
    flex: 0 0 auto; scroll-snap-align: center;
    border: 1px solid var(--sand); padding: 9px; background: var(--bg2);
  }
  .frame img { height: auto; }
  .frame-tall { width: min(64vw, 270px); }
  .frame-sq { width: min(74vw, 330px); }
  .frame:nth-child(3) { width: min(58vw, 235px); margin-top: 34px; }
  .frame:nth-child(2) { margin-bottom: 30px; }

  /* ---------- rsvp ---------- */
  .band { background: var(--acc); padding-block: clamp(64px, 10vw, 120px); }
  .card {
    background: var(--bg); border-radius: 0; padding: clamp(26px, 5vw, 52px);
    max-width: 580px; margin-inline: auto;
    box-shadow: 14px 14px 0 rgba(26, 26, 30, 0.28);
  }
  .card-h { margin-bottom: 26px; }
  .lab { display: block; font: 700 12px/1 var(--fb); letter-spacing: 0.2em; text-transform: uppercase; color: var(--mut); margin: 22px 0 10px; }
  .card input[type="text"], .card textarea {
    width: 100%; padding: 13px 16px; background: var(--bg2);
    border: 1px solid var(--hair); border-radius: 0; color: var(--ink);
    font: 500 15px/1.5 var(--fb); resize: vertical; min-height: 48px;
  }
  .card input::placeholder, .card textarea::placeholder { color: var(--mut); }
  .card input:focus-visible, .card textarea:focus-visible { outline-color: var(--acc); outline-offset: 0; }
  .opts { border: 0; padding: 0; margin: 0; }
  .opts .opt { display: inline-flex; margin: 0 10px 10px 0; cursor: pointer; }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt span {
    display: inline-flex; align-items: center; min-height: 48px; padding: 11px 24px;
    border-radius: 999px; border: 1.5px solid var(--hair);
    font: 700 13.5px/1 var(--fb); letter-spacing: 0.06em; text-transform: uppercase;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .opt:hover span { border-color: var(--acc); }
  .opt input:checked + span { background: var(--acc); border-color: var(--acc); color: var(--bg); }
  .opt input:focus-visible + span { outline: 2px solid var(--acc); outline-offset: 3px; }
  .stepper-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .stepper-row .lab { margin: 0; }
  .stepper { display: inline-flex; align-items: center; gap: 4px; border: 1px solid var(--hair); border-radius: 999px; padding: 4px; margin-block: 14px; }
  .step-btn {
    width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer;
    background: var(--bg2); color: var(--ink); font: 600 20px/1 var(--fb);
    transition: background 0.2s ease;
  }
  .step-btn:hover { background: var(--acc); color: var(--bg); }
  .step-count { min-width: 44px; text-align: center; font: 600 1.35rem/1 var(--fd); }
  .btn-sub { width: 100%; margin-top: 26px; min-height: 54px; animation: breath 4.5s ease-in-out infinite; will-change: transform; }
  .btn-sub:hover { animation: none; }
  .thanks { text-align: center; padding-block: 16px; }
  .thanks-msg { font: italic 400 clamp(1.5rem, 4.5vw, 2.2rem)/1.3 var(--fd); color: var(--sand); margin-bottom: 20px; }
  .linkish {
    background: none; border: 0; cursor: pointer; color: var(--acc);
    font: 700 13px/1 var(--fb); letter-spacing: 0.14em; text-transform: uppercase;
    text-decoration: underline; text-underline-offset: 4px; padding: 12px;
  }

  /* ---------- footer ---------- */
  .footer { padding: clamp(60px, 10vw, 110px) 20px 130px; text-align: center; border-top: 1px solid var(--hair); }
  .foot-mark { font: italic 400 clamp(5rem, 20vw, 12rem)/0.95 var(--fd); letter-spacing: -0.04em; }
  .foot-mark em { color: var(--acc); }
  .foot-date { margin-top: 18px; font: 700 12px/1.8 var(--fb); letter-spacing: 0.22em; text-transform: uppercase; color: var(--mut); }
  .foot-tag { margin-top: 10px; font: italic 400 1.3rem/1 var(--fd); color: var(--acc); }
  .foot-fine { margin-top: 26px; font-size: 13px; color: var(--mut); }

  /* ---------- music toggle ---------- */
  .music {
    position: fixed; right: 18px; bottom: 18px; z-index: 60;
    width: 52px; height: 52px; border-radius: 50%; border: 0; cursor: pointer;
    background: var(--acc); display: grid; place-items: center;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .music:hover { transform: scale(1.08); }
  .eq { display: flex; align-items: flex-end; gap: 3px; height: 18px; }
  .eq i { width: 4px; height: 100%; background: var(--bg); border-radius: 2px; transform-origin: bottom; animation: eq 0.9s ease-in-out infinite; }
  .eq i:nth-child(2) { animation-delay: 0.22s; }
  .eq i:nth-child(3) { animation-delay: 0.45s; }
  .music.off .eq i { animation-play-state: paused; transform: scaleY(0.25); }

  /* ---------- reveals ---------- */
  html.js .rv { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  html.js .rv.in { opacity: 1; transform: none; }

  /* ---------- keyframes ---------- */
  @keyframes mq { to { transform: translateX(-50%); } }
  @keyframes rise { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
  @keyframes clipup { to { clip-path: inset(-0.2em 0 -0.2em 0); transform: none; } }
  @keyframes chippop { 0% { transform: scale(0.6); } 60% { transform: scale(1.15); } 100% { transform: scale(1); } }
  @keyframes breath { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.025); } }
  @keyframes eq { 0%, 100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }
  @keyframes blink { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
    html { scroll-behavior: auto; }
    .mq-track { animation: none; }
    html.js .clip span { clip-path: none; transform: none; }
  }
</style>

<script is:inline>
(() => {
  'use strict';
  const $ = (s, c) => (c || document).querySelector(s);
  const $$ = (s, c) => Array.from((c || document).querySelectorAll(s));
  const fine = matchMedia('(pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- lo-fi groove (WebAudio) ---------- */
  let ac = null, master = null, noiseBuf = null, nextT = 0, step = 0, loop = null, muted = false;
  const BASS = [65.41, 82.41, 98, 73.42];
  const EIGHTH = 0.3; /* kick every 600ms, hats offbeat */

  function makeNoise() {
    const b = ac.createBuffer(1, ac.sampleRate * 0.06, ac.sampleRate);
    const d = b.getChannelData(0);
    for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
    return b;
  }
  function kick(t) {
    const o = ac.createOscillator(), g = ac.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(120, t);
    o.frequency.exponentialRampToValueAtTime(50, t + 0.12);
    g.gain.setValueAtTime(0.9, t);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.22);
    o.connect(g).connect(master);
    o.start(t); o.stop(t + 0.25);
  }
  function hat(t) {
    const s = ac.createBufferSource(), f = ac.createBiquadFilter(), g = ac.createGain();
    s.buffer = noiseBuf;
    f.type = 'highpass'; f.frequency.value = 6500;
    g.gain.setValueAtTime(0.22, t);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.05);
    s.connect(f).connect(g).connect(master);
    s.start(t); s.stop(t + 0.06);
  }
  function bass(t, freq) {
    const o = ac.createOscillator(), f = ac.createBiquadFilter(), g = ac.createGain();
    o.type = 'triangle'; o.frequency.value = freq;
    f.type = 'lowpass'; f.frequency.value = 320;
    g.gain.setValueAtTime(0.0001, t);
    g.gain.linearRampToValueAtTime(0.5, t + 0.04);
    g.gain.setTargetAtTime(0.0001, t + 1.7, 0.25);
    o.connect(f).connect(g).connect(master);
    o.start(t); o.stop(t + 2.35);
  }
  function schedule() {
    while (nextT < ac.currentTime + 0.25) {
      const s = step % 8; /* 8 eighths per bar */
      if (s % 2 === 0) kick(nextT); else hat(nextT);
      if (s === 0) bass(nextT, BASS[Math.floor(step / 8) % 4]);
      nextT += EIGHTH; step += 1;
    }
  }
  function startAudio() {
    if (ac) { if (ac.state === 'suspended') ac.resume(); return; }
    try {
      ac = new (window.AudioContext || window.webkitAudioContext)();
    } catch (e) { return; }
    master = ac.createGain();
    master.gain.value = 0.055; /* ≤0.06 */
    master.connect(ac.destination);
    noiseBuf = makeNoise();
    nextT = ac.currentTime + 0.1; step = 0;
    loop = setInterval(schedule, 120);
  }
  const musicBtn = $('#music');
  function setMuted(m) {
    muted = m;
    musicBtn.classList.toggle('off', m);
    musicBtn.setAttribute('aria-pressed', String(!m));
    musicBtn.setAttribute('aria-label', m ? 'Play music' : 'Mute music');
    if (ac) master.gain.setTargetAtTime(m ? 0 : 0.055, ac.currentTime, 0.05);
  }
  musicBtn.addEventListener('click', () => {
    if (!ac) { startAudio(); setMuted(false); return; }
    setMuted(!muted);
  });
  setMuted(true); /* visual state until entered */

  /* ---------- splash ---------- */
  const splash = $('#splash');
  splash.addEventListener('click', () => {
    splash.classList.add('done');
    document.body.classList.remove('locked');
    startAudio();
    setMuted(false);
  }, { once: true });

  /* ---------- reveals ---------- */
  const targets = $$('.rv, .clip');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -5% 0px' });
    targets.forEach((t) => io.observe(t));
  } else {
    targets.forEach((t) => t.classList.add('in'));
  }

  /* ---------- countdown ---------- */
  const TARGET = new Date('2026-12-12T17:30:00+05:30').getTime();
  const cd = { d: $('#cd-d'), h: $('#cd-h2'), m: $('#cd-m'), s: $('#cd-s') };
  const pad = (n, w) => String(n).padStart(w || 2, '0');
  function tick() {
    const diff = TARGET - Date.now();
    if (diff <= 0) {
      cd.d.textContent = '000'; cd.h.textContent = cd.m.textContent = cd.s.textContent = '00';
      clearInterval(cdLoop);
      return;
    }
    const sec = Math.floor(diff / 1000);
    cd.d.textContent = pad(Math.floor(sec / 86400), 3);
    cd.h.textContent = pad(Math.floor(sec / 3600) % 24);
    cd.m.textContent = pad(Math.floor(sec / 60) % 60);
    cd.s.textContent = pad(sec % 60);
  }
  const cdLoop = setInterval(tick, 1000);
  tick();

  /* ---------- cursor glow (desktop, subtle, transform-only) ---------- */
  if (fine && !still) {
    $$('.glowhost').forEach((host) => {
      const glow = $('.glow', host);
      if (!glow) return;
      let raf = 0, gx = 0, gy = 0;
      host.addEventListener('pointermove', (e) => {
        const r = host.getBoundingClientRect();
        gx = e.clientX - r.left; gy = e.clientY - r.top;
        host.classList.add('lit');
        if (!raf) raf = requestAnimationFrame(() => {
          glow.style.transform = 'translate3d(' + gx + 'px,' + gy + 'px,0)';
          raf = 0;
        });
      });
      host.addEventListener('pointerleave', () => host.classList.remove('lit'));
    });
  }

  /* ---------- magnetic RSVP button ---------- */
  if (fine && !still) {
    const mag = $('#rsvp-submit');
    mag.addEventListener('pointermove', (e) => {
      const r = mag.getBoundingClientRect();
      const dx = e.clientX - (r.left + r.width / 2);
      const dy = e.clientY - (r.top + r.height / 2);
      mag.style.transition = 'transform 0.1s ease-out';
      mag.style.transform = 'translate(' + dx * 0.18 + 'px,' + dy * 0.3 + 'px)';
    });
    mag.addEventListener('pointerleave', () => {
      mag.style.transition = 'transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)';
      mag.style.transform = 'translate(0,0)';
    });
  }

  /* ---------- dress chips ---------- */
  $$('.chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const open = chip.classList.toggle('open');
      chip.setAttribute('aria-pressed', String(open));
    });
  });

  /* ---------- playlist wall ---------- */
  const plForm = $('#pl-form'), plInput = $('#pl-input'), tracklist = $('#tracklist');
  plForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = plInput.value.trim();
    if (!v) return;
    const li = document.createElement('li');
    li.className = 'fresh';
    li.textContent = v;
    tracklist.appendChild(li);
    plInput.value = '';
    plInput.focus();
  });

  /* ---------- guest stepper ---------- */
  let guests = 1;
  const count = $('#step-count');
  const setGuests = (n) => { guests = Math.min(6, Math.max(1, n)); count.textContent = guests; };
  $('#step-minus').addEventListener('click', () => setGuests(guests - 1));
  $('#step-plus').addEventListener('click', () => setGuests(guests + 1));

  /* ---------- rsvp ---------- */
  const rsvpForm = $('#rsvp-form'), thanks = $('#rsvp-thanks'), thanksMsg = $('#thanks-msg');
  rsvpForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const yes = ($('input[name="attend"]:checked', rsvpForm) || {}).value === 'yes';
    thanksMsg.textContent = yes
      ? '“Taash. See you on the floor.”'
      : '“You will be judged. Lovingly.”';
    rsvpForm.hidden = true;
    thanks.hidden = false;
    thanks.focus && thanksMsg.setAttribute('tabindex', '-1');
    thanksMsg.focus();
  });
  $('#rsvp-change').addEventListener('click', () => {
    thanks.hidden = true;
    rsvpForm.hidden = false;
    $('#r-name').focus();
  });
})();
</script>
