---
import '@fontsource/rozha-one/400.css';
import '@fontsource/mukta/300.css';
import '@fontsource/mukta/400.css';
import '@fontsource/mukta/500.css';
import '@fontsource/mukta/600.css';

const title = 'Aarav & Diya — November 27, 2026';
const description =
  'With the blessings of our families — Aarav & Diya invite you to their Shubh Vivah. Pheras at The Leela Palace, Udaipur · November 27, 2026.';
const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="32" fill="#7a1f2b"/><circle cx="32" cy="32" r="25" fill="none" stroke="#d4a643" stroke-width="3"/><circle cx="32" cy="32" r="10" fill="#e8862e"/><circle cx="32" cy="32" r="4" fill="#f2b134"/></svg>'
  );
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdf3e0" />
    <link rel="icon" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/art/hindu/hero.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <!-- ── Envelope: Ganesh invocation ─────────────────────────────── -->
    <div class="intro" id="intro">
      <div class="intro-inner">
        <div class="frame f1" aria-hidden="true"></div>
        <div class="frame f2" aria-hidden="true"></div>
        <div class="shloka" lang="hi">॥ श्री गणेशाय नमः ॥</div>
        <div class="om" aria-hidden="true">ॐ</div>
        <p class="bless-line">With the blessings of our families</p>
        <h1 class="i-names">Aarav <span class="amp">&amp;</span> Diya</h1>
        <p class="i-sub">request the pleasure of your company<br />at their Shubh Vivah</p>
        <div class="i-date">27 · 11 · 2026 &nbsp;·&nbsp; Udaipur</div>
        <button class="open-btn" id="openBtn" type="button"><span>Open Invitation</span></button>
        <div class="i-hint">with shehnai &mdash; sound on</div>
      </div>
    </div>

    <!-- ── Nav + toran ─────────────────────────────────────────────── -->
    <nav id="navbar" aria-label="Invitation">
      <a class="brand" href="#top">A <span class="amp">&amp;</span> D</a>
      <div class="nav-links">
        <a href="#events">Events</a>
        <a href="#venue">Venue</a>
        <a class="nav-rsvp" href="#rsvp">RSVP</a>
      </div>
    </nav>
    <div class="toran" aria-hidden="true">
      {Array.from({ length: 24 }).map(() => <i></i>)}
    </div>

    <main id="top">
      <!-- ── Hero ──────────────────────────────────────────────────── -->
      <header class="hero">
        <div class="hero-art">
          <img src="/art/hindu/hero.svg" alt="Aarav and Diya beneath the wedding mandap, garlands exchanged" loading="eager" />
        </div>
        <div class="hero-plate">
          <div class="overline wide">The wedding of</div>
          <h1 class="hero-names mask">Aarav <span class="amp">&amp;</span> Diya</h1>
          <p class="hero-meta">
            Friday, November 27, 2026 &middot; Pheras at 7:20 PM<br />
            The Leela Palace &middot; Udaipur, Rajasthan
          </p>
        </div>
        <div class="scroll-cue" aria-hidden="true">
          <span>Scroll</span>
          <div class="cue-line"><i></i></div>
        </div>
      </header>

      <!-- ── The couple ────────────────────────────────────────────── -->
      <section class="couple" aria-labelledby="couple-h">
        <div class="s-head rv">
          <div class="overline">Do parivaar, ek rishta</div>
          <h2 id="couple-h">Two families become one</h2>
          <div class="rule" aria-hidden="true"></div>
        </div>
        <div class="couple-grid">
          <figure class="couple-art rv">
            <img src="/art/hindu/couple.svg" alt="Illustration of Aarav and Diya in wedding attire with varmala garlands" loading="lazy" />
          </figure>
          <div class="couple-bios">
            <div class="bio rv">
              <h3>Diya Kapoor</h3>
              <div class="role">The Bride</div>
              <p>Daughter of Mrs. Anita &amp; Mr. Rajesh Kapoor, Mumbai. Textile designer, mehndi perfectionist, first on every dance floor.</p>
            </div>
            <div class="bio rv">
              <h3>Aarav Sharma</h3>
              <div class="role">The Groom</div>
              <p>Son of Mrs. Sunita &amp; Mr. Vikram Sharma, Jaipur. Architect, chai purist, has been practicing his sangeet steps since June.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ── Events ────────────────────────────────────────────────── -->
      <section id="events" class="events" aria-labelledby="events-h">
        <div class="s-head rv">
          <div class="overline">Shaadi ka schedule</div>
          <h2 id="events-h">Five celebrations, one love</h2>
        </div>
        <div class="event-list">
          <article class="event-card rv">
            <div class="ev-art"><img src="/art/hindu/event-1.svg" alt="Haldi bowl with marigolds" loading="lazy" /></div>
            <div class="ev-body">
              <div class="ev-when">Wed, Nov 25 &middot; 10:00 AM</div>
              <h3>Haldi</h3>
              <p>Sharma residence courtyard. Turmeric, laughter, and everyone in yellow &mdash; you have been warned.</p>
              <div class="ev-dress">Wear: Haldi yellow</div>
            </div>
          </article>
          <article class="event-card rv">
            <div class="ev-art"><img src="/art/hindu/event-2.svg" alt="Henna-decorated hand" loading="lazy" /></div>
            <div class="ev-body">
              <div class="ev-when">Wed, Nov 25 &middot; 4:00 PM</div>
              <h3>Mehndi</h3>
              <p>Palace gardens. Henna artists, folk songs, and the traditional hunt for Aarav&rsquo;s initials in the pattern.</p>
              <div class="ev-dress">Wear: Mehndi green</div>
            </div>
          </article>
          <article class="event-card rv">
            <div class="ev-art"><img src="/art/hindu/event-3.svg" alt="Dhol with music notes" loading="lazy" /></div>
            <div class="ev-body">
              <div class="ev-when">Thu, Nov 26 &middot; 7:00 PM</div>
              <h3>Sangeet</h3>
              <p>The Leela lawns. Two families, one dance floor, months of secret rehearsals settled at last.</p>
              <div class="ev-dress">Wear: Festive glam</div>
            </div>
          </article>
          <article class="event-card highlight rv">
            <div class="ev-art"><img src="/art/hindu/event-4.svg" alt="Sacred fire of the pheras with kalash" loading="lazy" /></div>
            <div class="ev-body">
              <div class="ev-when">Fri, Nov 27 &middot; From 5:30 PM</div>
              <h3>Baraat &amp; Pheras</h3>
              <p>The main event &mdash; the baraat arrives on horseback, var mala under the stars, and the seven pheras around the sacred fire.</p>
              <div class="ev-dress">Wear: Your wedding best</div>
            </div>
          </article>
          <article class="event-card rv">
            <div class="ev-art"><img src="/art/hindu/gallery-4.svg" alt="Mangal kalash with mango leaves" loading="lazy" /></div>
            <div class="ev-body">
              <div class="ev-when">Sat, Nov 28 &middot; 7:00 PM</div>
              <h3>Reception</h3>
              <p>Dinner, blessings and one last dance before we let you go home.</p>
              <div class="ev-dress">Wear: Evening elegant</div>
            </div>
          </article>
        </div>
      </section>

      <!-- ── Shubh muhurat ─────────────────────────────────────────── -->
      <section class="muhurat" aria-labelledby="muhurat-h">
        <div class="rv">
          <div class="overline light">Shubh Muhurat</div>
          <h2 id="muhurat-h">The wedding day, hour by hour</h2>
          <div class="mu-row" role="list">
            <div class="mu-item" role="listitem"><b>5:30 PM</b><span>Baraat</span></div>
            <i class="mu-dot" aria-hidden="true"></i>
            <div class="mu-item" role="listitem"><b>7:00 PM</b><span>Var Mala</span></div>
            <i class="mu-dot" aria-hidden="true"></i>
            <div class="mu-item" role="listitem"><b>7:20 PM</b><span>Pheras &middot; muhurat</span></div>
            <i class="mu-dot" aria-hidden="true"></i>
            <div class="mu-item" role="listitem"><b>9:00 PM</b><span>Dinner</span></div>
            <i class="mu-dot" aria-hidden="true"></i>
            <div class="mu-item" role="listitem"><b>11:30 PM</b><span>Vidaai</span></div>
          </div>
        </div>
      </section>

      <!-- ── Story ─────────────────────────────────────────────────── -->
      <section class="story" aria-labelledby="story-h">
        <div class="s-head rv">
          <div class="overline">Humari kahani</div>
          <h2 id="story-h">It began at a sangeet</h2>
        </div>
        <div class="story-rail">
          <div class="milestone rv">
            <div class="ms-date">2019 &middot; A cousin&rsquo;s wedding, Mumbai</div>
            <h3>The worst dancers on the floor</h3>
            <p>They were paired for a sangeet performance neither wanted to do. They were terrible. They practiced anyway &mdash; long after the wedding was over.</p>
          </div>
          <div class="milestone rv">
            <div class="ms-date">2022 &middot; Mumbai &harr; Jaipur</div>
            <h3>Three years of flights</h3>
            <p>Airport chai, missed calls, and a shared playlist called <em>&ldquo;for the aisle seat.&rdquo;</em> Somewhere in there, it became forever.</p>
          </div>
          <div class="milestone rv">
            <div class="ms-date">2025 &middot; The same rooftop</div>
            <h3>She said &ldquo;finally&rdquo;</h3>
            <p>He proposed where they first danced, at a haldi-yellow sunset, with both families hiding badly behind the door.</p>
          </div>
        </div>
      </section>

      <!-- ── Venue ─────────────────────────────────────────────────── -->
      <section id="venue" class="venue" aria-labelledby="venue-h">
        <div class="s-head rv">
          <div class="overline">Sthaan</div>
          <h2 id="venue-h">The Leela Palace, Udaipur</h2>
          <p class="venue-sub">On the banks of Lake Pichola &mdash; pheras by the water, fireworks over it.</p>
        </div>
        <div class="map-wrap rv">
          <iframe
            src="https://www.google.com/maps?q=24.5754,73.6811&z=15&output=embed"
            title="Map showing The Leela Palace, Udaipur"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="venue-actions rv">
          <a class="pill solid" href="https://www.google.com/maps/dir/?api=1&destination=The+Leela+Palace+Udaipur" target="_blank" rel="noopener">Get directions</a>
          <a class="pill" href="https://maps.google.com/?q=The+Leela+Palace+Udaipur" target="_blank" rel="noopener">View on map</a>
        </div>
        <p class="venue-notes rv">
          45 minutes from Udaipur airport &middot; shuttles from Hotel Lakend at 4:30 PM.<br />
          Room block: mention <strong>AARAV&amp;DIYA</strong> when booking.
        </p>
      </section>

      <!-- ── Countdown ─────────────────────────────────────────────── -->
      <section class="countdown" aria-labelledby="count-h">
        <div class="rv">
          <div class="overline light">Ab bas kuch din</div>
          <h2 id="count-h" class="serif-it">Until the pheras</h2>
          <div class="digits" role="timer" aria-label="Time remaining until the wedding">
            <div class="unit"><b id="dd">--</b><span>Days</span></div>
            <div class="colon" aria-hidden="true">:</div>
            <div class="unit"><b id="hh">--</b><span>Hours</span></div>
            <div class="colon" aria-hidden="true">:</div>
            <div class="unit"><b id="mm">--</b><span>Minutes</span></div>
            <div class="colon" aria-hidden="true">:</div>
            <div class="unit"><b id="ss">--</b><span>Seconds</span></div>
          </div>
          <div class="count-diyas" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
      </section>

      <!-- ── Gallery ───────────────────────────────────────────────── -->
      <section class="gallery" aria-labelledby="gal-h">
        <div class="s-head rv">
          <div class="overline">Shagun</div>
          <h2 id="gal-h">Motifs of a Shubh Vivah</h2>
        </div>
        <div class="gal-scroller" tabindex="0" role="region" aria-label="Artwork gallery — scroll horizontally">
          <div class="gal-item tall"><img src="/art/hindu/gallery-1.svg" alt="Peacock artwork" loading="lazy" /></div>
          <div class="gal-item square"><img src="/art/hindu/gallery-2.svg" alt="Lotus mandala artwork" loading="lazy" /></div>
          <div class="gal-item square"><img src="/art/hindu/gallery-3.svg" alt="Caparisoned wedding elephant artwork" loading="lazy" /></div>
          <div class="gal-item tall"><img src="/art/hindu/gallery-4.svg" alt="Mangal kalash artwork" loading="lazy" /></div>
        </div>
        <div class="gal-hint" aria-hidden="true">Swipe &rarr;</div>
      </section>

      <!-- ── Ashirwad wall ─────────────────────────────────────────── -->
      <section class="bless" aria-labelledby="bless-h">
        <div class="bless-inner">
          <div class="s-head rv">
            <div class="overline light">Ashirwad</div>
            <h2 id="bless-h" class="serif-it">Shower your blessings</h2>
          </div>
          <div class="bless-list" id="blessList" aria-live="polite">
            <div class="bless-card rv"><p>&ldquo;May your jodi be blessed like Shiv-Parvati. Khush raho, beta.&rdquo;</p><div class="who">Dadi ji &middot; Jaipur</div></div>
            <div class="bless-card indent rv"><p>&ldquo;Diya didi, we already made your wedding hashtag trend in the family group.&rdquo;</p><div class="who">The Kapoor cousins</div></div>
            <div class="bless-card rv"><p>&ldquo;Sau saal ki khushiyan. Now please pass the laddoos.&rdquo;</p><div class="who">Sharma parivaar</div></div>
          </div>
          <form class="bless-form" id="blessForm">
            <label class="sr-only" for="blessInput">Your blessing</label>
            <input id="blessInput" placeholder="Likho apna ashirwad&hellip;" autocomplete="off" maxlength="240" />
            <button type="submit">Send</button>
          </form>
        </div>
      </section>

      <!-- ── RSVP ──────────────────────────────────────────────────── -->
      <section id="rsvp" class="rsvp" aria-labelledby="rsvp-h">
        <div class="rsvp-card rv">
          <div class="float-label" aria-hidden="true">Kripya uttar dein</div>
          <form id="rsvpForm" novalidate>
            <h2 id="rsvp-h">Will you bless us with your presence?</h2>
            <p class="deadline">Please reply by November 10, 2026</p>
            <div class="fields">
              <label class="sr-only" for="rName">Your full name</label>
              <input id="rName" placeholder="Your full name" autocomplete="name" required />
              <div class="choice" role="group" aria-label="Will you attend?">
                <button type="button" id="rYes" class="pillbtn yes selected" aria-pressed="true">Joyfully accept</button>
                <button type="button" id="rNo" class="pillbtn no" aria-pressed="false">Regretfully decline</button>
              </div>
              <div class="stepper">
                <span id="gLabel">Guests in your party</span>
                <div class="step-controls">
                  <button type="button" id="gMinus" aria-label="Fewer guests">&minus;</button>
                  <b id="gCount" aria-labelledby="gLabel">2</b>
                  <button type="button" id="gPlus" aria-label="More guests">+</button>
                </div>
              </div>
              <label class="sr-only" for="rNote">A note for us</label>
              <textarea id="rNote" rows="3" placeholder="Dietary needs, song requests for the sangeet&hellip;"></textarea>
              <button type="submit" class="submit">Send reply</button>
            </div>
          </form>
          <div class="rsvp-done" id="rsvpDone" hidden>
            <div class="om small" aria-hidden="true">ॐ</div>
            <h2 id="doneTitle" tabindex="-1">&nbsp;</h2>
            <p id="doneBody"></p>
            <button type="button" class="change" id="rsvpReset">Change my reply</button>
          </div>
        </div>
      </section>
    </main>

    <!-- ── Footer ──────────────────────────────────────────────────── -->
    <footer>
      <div class="f-om" aria-hidden="true">ॐ</div>
      <div class="f-names">Aarav <span class="amp">&amp;</span> Diya</div>
      <div class="f-date">November 27, 2026 &middot; The Leela Palace, Udaipur</div>
      <div class="f-tag">#AaravWedsDiya</div>
      <div class="f-close">Aapka aana hi humara shagun hai</div>
    </footer>

    <button id="musicBtn" class="music is-muted" type="button" aria-label="Toggle music" aria-pressed="false">
      <span></span><span></span><span></span>
    </button>

    <a class="mi-bar" href="/#pricing" aria-label="Get this design from Myinvite">✦ Get this design — <b>Myinvite</b></a>
    <style>
      .mi-bar { position: fixed; left: 18px; bottom: 18px; z-index: 55; display: flex; align-items: center; gap: 6px; background: rgba(18,15,12,.82); color: #f5edd9; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(212,166,67,.5); border-radius: 999px; padding: 12px 18px; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .04em; text-decoration: none; transition: transform .2s ease, border-color .2s ease; }
      .mi-bar b { color: #d4a643; font-style: italic; font-family: Georgia, serif; font-weight: 400; font-size: 13px; }
      .mi-bar:hover { transform: translateY(-2px); border-color: #d4a643; color: #f5edd9; }
    </style>

    <style>
      :root {
        --bg: #fdf3e0;
        --bg2: #f9e6c8;
        --maroon: #7a1f2b;
        --red: #a62639;
        --gold: #c98f3d;
        --goldL: #e9c15c;
        --mari: #e8862e;
        --ink: #3a2418;
        --mut: #8a6f52;
        --green: #4a6b3a;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Mukta', sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: clip;
      }
      body.locked { overflow: hidden; }
      a { color: var(--gold); text-decoration: none; }
      ::selection { background: #f3d9a4; }
      :focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; border-radius: 2px; }
      img { display: block; width: 100%; height: 100%; object-fit: cover; }
      .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .amp { color: var(--gold); font-style: italic; }
      h1, h2, h3, .serif { font-family: 'Rozha One', serif; font-weight: 400; }
      h2 { font-size: clamp(32px, 6vw, 50px); margin: 12px 0 0; line-height: 1.15; color: var(--maroon); }
      .serif-it { font-style: normal; }
      .overline {
        font-size: 11px; letter-spacing: 0.32em; text-transform: uppercase;
        color: var(--gold); font-weight: 500;
      }
      .overline.light { color: var(--goldL); }
      .s-head { text-align: center; }
      .rule { width: 46px; height: 2px; background: var(--gold); margin: 20px auto 0; }
      section { padding: 96px 24px; }

      /* ── Intro ── */
      .intro {
        position: fixed; inset: 0; z-index: 60; background: var(--bg);
        display: flex; align-items: center; justify-content: center;
        animation: kFade 0.8s ease both;
      }
      .intro.closing { animation: introUp 1s 0.35s cubic-bezier(0.7, 0, 0.2, 1) both; pointer-events: none; }
      .intro.closing .intro-inner { animation: kOut 0.45s ease both; }
      @keyframes introUp { to { transform: translateY(-104%); } }
      .intro-inner {
        position: absolute; inset: 0; display: flex; flex-direction: column;
        align-items: center; justify-content: center; text-align: center; padding: 32px;
      }
      .frame { position: absolute; border: 1px solid #e5c98e; pointer-events: none; }
      .f1 { inset: 14px; }
      .f2 { inset: 20px; opacity: 0.6; }
      .shloka {
        font-family: 'Rozha One', serif; font-size: 15px; color: var(--maroon);
        letter-spacing: 0.1em; animation: kRise 1s 0.2s ease both;
      }
      .om {
        width: 78px; height: 78px; border: 1px solid var(--gold); border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-family: 'Rozha One', serif; font-size: 34px; color: var(--gold);
        margin: 26px 0; animation: kZoom 1.2s 0.5s ease both;
      }
      .om.small { width: 64px; height: 64px; font-size: 28px; margin: 0 auto; }
      .bless-line { font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--mut); margin: 0; animation: kRise 1.1s 0.7s ease both; }
      .i-names {
        font-size: clamp(46px, 11vw, 88px); line-height: 1.08; margin: 14px 0 0;
        color: var(--maroon); animation: kRise 1.2s 0.9s ease both;
      }
      .i-sub { font-size: 15px; line-height: 1.8; color: var(--mut); margin: 20px 0 0; animation: kRise 1.2s 1.3s ease both; }
      .i-date { font-size: 13px; letter-spacing: 0.3em; margin: 24px 0 36px; animation: kRise 1.2s 1.6s ease both; }
      .open-btn {
        background: transparent; border: 1px solid var(--gold); color: var(--gold);
        padding: 0; border-radius: 999px; cursor: pointer; min-height: 50px;
        font-family: 'Mukta', sans-serif; font-size: 13px; letter-spacing: 0.28em;
        text-transform: uppercase; animation: kRise 1.2s 1.9s ease both;
        transition: background 0.3s, color 0.3s;
      }
      .open-btn span { display: inline-block; padding: 16px 40px; border-radius: 999px; animation: breath 2.6s ease infinite; }
      .open-btn:hover { background: var(--gold); color: var(--bg); }
      .i-hint { font-size: 12px; color: var(--mut); margin-top: 20px; animation: kFade 1s 2.4s ease both; }

      /* ── Nav + toran ── */
      nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 40;
        display: flex; align-items: center; justify-content: space-between;
        padding: 10px 20px;
        background: color-mix(in srgb, var(--bg) 78%, transparent);
        backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid #ecd7a8;
      }
      .brand { font-family: 'Rozha One', serif; font-size: 19px; color: var(--maroon); letter-spacing: 0.12em; }
      .nav-links { display: flex; align-items: center; gap: 18px; }
      .nav-links a { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--mut); font-weight: 500; }
      .nav-links a:hover { color: var(--maroon); }
