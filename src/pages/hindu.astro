      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01s !important; animation-delay: 0s !important; transition: none !important; }
        html { scroll-behavior: auto; }
      }
    </style>

    <script>
      const $ = (id) => document.getElementById(id);
      const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* Scroll reveals */
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.rv').forEach((el) => io.observe(el));

      /* Marigold burst */
      function burst(x, y, n = 22) {
        if (REDUCED) return;
        const colors = ['#e8862e', '#f2b134', '#d96b7f'];
        for (let i = 0; i < n; i++) {
          const p = document.createElement('div');
          const w = 6 + Math.random() * 7;
          p.style.cssText = `position:fixed;left:${x}px;top:${y}px;width:${w}px;height:${w}px;border-radius:50% 10% 50% 10%;background:${colors[i % 3]};pointer-events:none;z-index:80`;
          document.body.appendChild(p);
          const a = (i / n) * Math.PI * 2 + Math.random() * 0.5;
          const d = 60 + Math.random() * 120;
          p.animate(
            [
              { transform: 'translate(-50%,-50%) rotate(0)', opacity: 1 },
              { transform: `translate(calc(-50% + ${Math.cos(a) * d}px), calc(-50% + ${Math.sin(a) * d - 30}px)) rotate(${Math.random() * 300 - 150}deg)`, opacity: 0 },
            ],
            { duration: 750 + Math.random() * 650, easing: 'cubic-bezier(.16,.61,.36,1)' }
          ).onfinish = () => p.remove();
        }
      }

      /* Music — shehnai-flavoured generative (drone + Yaman-ish plucks) */
      const music = {
        started: false, muted: true, actx: null, timer: null,
        start() {
          if (this.started) return;
          this.started = true; this.muted = false;
          try {
            const C = new (window.AudioContext || window.webkitAudioContext)();
            this.actx = C;
            const master = C.createGain(); master.gain.value = 0.05; master.connect(C.destination);
            const delay = C.createDelay(1); delay.delayTime.value = 0.46;
            const fb = C.createGain(); fb.gain.value = 0.34;
            delay.connect(fb); fb.connect(delay);
            const wet = C.createGain(); wet.gain.value = 0.45; delay.connect(wet); wet.connect(master);
            const padG = C.createGain(); padG.gain.value = 0.14; padG.connect(master);
            [146.83, 220].forEach((f) => {
              const o = C.createOscillator(); o.type = 'sine'; o.frequency.value = f;
              const gn = C.createGain(); gn.gain.value = 0.3; o.connect(gn); gn.connect(padG); o.start();
            });
            const lfo = C.createOscillator(); lfo.frequency.value = 0.06;
            const lg = C.createGain(); lg.gain.value = 0.06; lfo.connect(lg); lg.connect(padG.gain); lfo.start();
            const notes = [293.66, 329.63, 369.99, 415.3, 440, 493.88, 554.37, 587.33];
            const pluck = () => {
              if (!this.actx) return;
              if (this.muted) { this.timer = setTimeout(pluck, 1500); return; }
              const o = C.createOscillator(); o.type = 'triangle';
              o.frequency.value = notes[Math.floor(Math.random() * notes.length)];
              const gn = C.createGain();
              gn.gain.setValueAtTime(0, C.currentTime);
              gn.gain.linearRampToValueAtTime(0.22, C.currentTime + 0.05);
              gn.gain.exponentialRampToValueAtTime(0.001, C.currentTime + 2.4);
              o.connect(gn); gn.connect(master); gn.connect(delay);
              o.start(); o.stop(C.currentTime + 2.6);
              this.timer = setTimeout(pluck, 1000 + Math.random() * 1800);
            };
            pluck();
            C.resume();
          } catch {}
          this.paint();
        },
        toggle() {
          if (!this.started) { this.start(); return; }
          this.muted = !this.muted;
          if (this.actx) this.muted ? this.actx.suspend() : this.actx.resume();
          this.paint();
        },
        paint() {
          const b = $('musicBtn');
          b.classList.toggle('is-muted', this.muted);
          b.setAttribute('aria-pressed', String(!this.muted));
        },
      };
      $('musicBtn').addEventListener('click', () => music.toggle());

      /* Intro */
      const intro = $('intro');
      document.body.classList.add('locked');
      $('openBtn').addEventListener('click', () => {
        music.start();
        intro.classList.add('closing');
        document.body.classList.remove('locked');
        const r = $('openBtn').getBoundingClientRect();
        burst(r.left + r.width / 2, r.top + r.height / 2, 18);
        setTimeout(() => intro.remove(), 1600);
      });

      /* Countdown → pheras muhurat */
      const target = new Date('2026-11-27T19:20:00+05:30').getTime();
      const dd = $('dd'), hh = $('hh'), mm = $('mm'), ss = $('ss');
      let ctimer;
      function tick() {
        const t = target - Date.now();
        const p = (n) => String(n).padStart(2, '0');
        if (t <= 0) { dd.textContent = hh.textContent = mm.textContent = ss.textContent = '00'; clearInterval(ctimer); return; }
        dd.textContent = p(Math.floor(t / 864e5));
        hh.textContent = p(Math.floor(t / 36e5) % 24);
        mm.textContent = p(Math.floor(t / 6e4) % 60);
        ss.textContent = p(Math.floor(t / 1e3) % 60);
      }
      tick();
      ctimer = setInterval(tick, 1000);

      /* Blessings wall */
      $('blessForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const input = $('blessInput');
        const text = input.value.trim();
        if (!text) { input.focus(); return; }
        const list = $('blessList');
        const card = document.createElement('div');
        card.className = 'bless-card' + (list.children.length % 2 === 1 ? ' indent' : '');
        const p = document.createElement('p');
        p.textContent = `“${text}”`;
        const who = document.createElement('div');
        who.className = 'who';
        who.textContent = 'You · just now';
        card.append(p, who);
        list.appendChild(card);
        input.value = '';
        const r = e.submitter ? e.submitter.getBoundingClientRect() : card.getBoundingClientRect();
        burst(r.left + r.width / 2, r.top, 16);
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      /* RSVP */
      let attending = 'yes', guests = 2;
      const yes = $('rYes'), no = $('rNo'), gCount = $('gCount');
      function paintChoice() {
        yes.classList.toggle('selected', attending === 'yes');
        no.classList.toggle('selected', attending === 'no');
        yes.setAttribute('aria-pressed', String(attending === 'yes'));
        no.setAttribute('aria-pressed', String(attending === 'no'));
      }
      yes.addEventListener('click', () => {
        const first = attending !== 'yes';
        attending = 'yes'; paintChoice();
        if (first) { const r = yes.getBoundingClientRect(); burst(r.left + r.width / 2, r.top + r.height / 2, 10); }
      });
      no.addEventListener('click', () => { attending = 'no'; paintChoice(); });
      $('gMinus').addEventListener('click', () => { guests = Math.max(1, guests - 1); gCount.textContent = guests; });
      $('gPlus').addEventListener('click', () => { guests = Math.min(10, guests + 1); gCount.textContent = guests; });

      $('rsvpForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const name = $('rName');
        if (!name.value.trim()) { name.setAttribute('aria-invalid', 'true'); name.focus(); return; }
        name.removeAttribute('aria-invalid');
        const acc = attending === 'yes';
        $('doneTitle').textContent = acc ? 'Dhanyavaad! We can’t wait.' : 'You’ll be missed at the pheras';
        $('doneBody').textContent = acc
          ? `Your reply for ${guests} ${guests === 1 ? 'guest' : 'guests'} is noted. The baraat expects your best moves.`
          : 'Thank you for letting us know. We’ll send you laddoos and photos.';
        $('rsvpForm').hidden = true;
        $('rsvpDone').hidden = false;
        $('doneTitle').focus();
        if (acc) {
          const r = $('rsvpDone').getBoundingClientRect();
          burst(r.left + r.width / 2, r.top + 80, 26);
          setTimeout(() => burst(r.left + r.width / 2, r.top + 40, 14), 260);
        }
      });
      $('rsvpReset').addEventListener('click', () => {
        $('rsvpDone').hidden = true;
        $('rsvpForm').hidden = false;
        $('rName').focus();
      });
    </script>
  </body>
</html>
