      @keyframes bar { 0%, 100% { transform: scaleY(0.25); } 50% { transform: scaleY(1); } }

      /* ── Shared keyframes ── */
      @keyframes kFade { from { opacity: 0; } to { opacity: 1; } }
      @keyframes kOut { to { opacity: 0; visibility: hidden; } }
      @keyframes kRise { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: none; } }
      @keyframes kZoom { from { opacity: 0; transform: scale(1.06); } to { opacity: 1; transform: scale(1); } }
