  .foot-names{font-family:var(--serif);font-size:clamp(28px,6vw,38px);margin-bottom:6px}
  .foot-date{font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,246,232,.7)}
  .foot-tag{font-family:var(--serif);font-style:italic;font-size:19px;color:var(--gold);margin:14px 0 4px}
  .foot-bless{font-size:13.5px;letter-spacing:.24em;text-transform:uppercase;color:rgba(255,246,232,.55)}

  /* ---------- music toggle ---------- */
  .music-btn{
    position:fixed;right:18px;bottom:18px;z-index:45;width:52px;height:52px;border-radius:50%;
    border:2px solid var(--gold);background:var(--blue);cursor:pointer;display:grid;place-items:center;
    box-shadow:0 10px 26px rgba(30,42,90,.4);transition:transform .2s ease;
  }
  .music-btn:hover{transform:scale(1.06)}
  .bars{display:flex;align-items:flex-end;gap:3px;height:16px}
  .bars i{width:3px;height:16px;background:var(--gold);border-radius:2px;transform:scaleY(.3);transform-origin:bottom;
    animation:bars 1.05s ease-in-out infinite;animation-play-state:paused}
  .bars i:nth-child(2){animation-delay:.22s}
  .bars i:nth-child(3){animation-delay:.44s}
  .music-btn.playing .bars i{animation-play-state:running}

  /* ---------- reveals & keyframes ---------- */
  html.js .reveal{opacity:0;transform:translateY(26px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.7,.2,1)}
  html.js .reveal.in{opacity:1;transform:none}
  .d1{transition-delay:.1s}
  .d2{transition-delay:.2s}
  .d3{transition-delay:.3s}

  @keyframes rise{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:none}}
  @keyframes heroClip{from{opacity:.35;clip-path:inset(10% 8% 14% 8% round 28px)}to{opacity:1;clip-path:inset(0 0 0 0 round 0)}}
  @keyframes sway{0%,100%{transform:rotate(-.5deg) translateY(0)}50%{transform:rotate(.5deg) translateY(2px)}}
  @keyframes glowPulse{0%,100%{opacity:.3;transform:scale(.96)}50%{opacity:.8;transform:scale(1.06)}}
  @keyframes dholPulse{0%{transform:scale(1)}45%{transform:scale(1.02)}100%{transform:scale(1)}}
  @keyframes petalPop{
    0%{opacity:1;transform:translate(-50%,-50%) scale(.5) rotate(0)}
    100%{opacity:0;transform:translate(calc(-50% + var(--dx,0px)),calc(-50% + var(--dy,-80px))) scale(1.05) rotate(var(--rz,180deg))}
  }
  @keyframes bars{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1)}}

  @media (prefers-reduced-motion:reduce){
    *,*::before,*::after{
      animation-duration:.01ms !important;animation-iteration-count:1 !important;
      transition-duration:.01ms !important;transition-delay:0s !important;
    }
    html{scroll-behavior:auto}
  }
</style>

<script is:inline>
(() => {
  'use strict';
  const $  = (s, r) => (r || document).querySelector(s);
  const $$ = (s, r) => Array.prototype.slice.call((r || document).querySelectorAll(s));

  /* ================= AUDIO ================= */
  let ctx = null, musicGain = null, fxGain = null, muted = true, musicBuilt = false;
  const NOTES = [293.66, 329.63, 369.99, 440, 493.88];

  function ensureCtx() {
    if (ctx) return ctx;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    ctx = new AC();
    fxGain = ctx.createGain();  fxGain.gain.value = 0.5;  fxGain.connect(ctx.destination);
    musicGain = ctx.createGain(); musicGain.gain.value = 0; musicGain.connect(ctx.destination);
    return ctx;
  }

  function buildMusic() {
    if (musicBuilt || !ensureCtx()) return;
    musicBuilt = true;
    const master = ctx.createGain(); master.gain.value = 0.06; master.connect(musicGain);
    const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 900; lp.connect(master);
    // tanpura-ish drone: two low saws, very low gain, slow LFO shimmer
    [146.83, 220].forEach((f, i) => {
      const o = ctx.createOscillator(); o.type = 'sawtooth'; o.frequency.value = f;
      const g = ctx.createGain(); g.gain.value = i ? 0.10 : 0.14;
      o.connect(g); g.connect(lp); o.start();
      const lfo = ctx.createOscillator(); lfo.frequency.value = 0.07 + i * 0.04;
      const lg = ctx.createGain(); lg.gain.value = 0.04;
      lfo.connect(lg); lg.connect(g.gain); lfo.start();
    });
    // occasional plucked notes (Bilawal-ish)
    const pluck = () => {
      if (ctx.state === 'running' && !muted) {
        const t = ctx.currentTime;
        const o = ctx.createOscillator(); o.type = 'triangle';
        o.frequency.value = NOTES[Math.floor(Math.random() * NOTES.length)];
        const g = ctx.createGain();
        g.gain.setValueAtTime(0.0001, t);
        g.gain.linearRampToValueAtTime(0.5, t + 0.012);
        g.gain.exponentialRampToValueAtTime(0.001, t + 1.6);
        const f = ctx.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = 2400;
        o.connect(g); g.connect(f); f.connect(master);
        o.start(t); o.stop(t + 1.7);
      }
      setTimeout(pluck, 2400 + Math.random() * 2600);
    };
    setTimeout(pluck, 1400);
  }

  function setMuted(m) {
    muted = m;
    const btn = $('#music-btn');
    btn.classList.toggle('playing', !m);
    btn.setAttribute('aria-pressed', String(!m));
    btn.setAttribute('aria-label', m ? 'Play music' : 'Mute music');
    if (!ctx) return;
    if (!m && ctx.state === 'suspended') ctx.resume();
    musicGain.gain.setTargetAtTime(m ? 0 : 1, ctx.currentTime, 0.35);
  }

  function startMusic() {
    if (!ensureCtx()) return;
    if (ctx.state === 'suspended') ctx.resume();
    buildMusic();
    setMuted(false);
  }

  $('#music-btn').addEventListener('click', () => {
    if (!musicBuilt) { startMusic(); return; }
    setMuted(!muted);
  });

  /* ---- dhol synthesis: dha (membrane) + tak (snap) ---- */
  function dholDha(t, oomph) {
    const o = ctx.createOscillator(); o.type = 'sine';
    o.frequency.setValueAtTime(90, t);
    o.frequency.exponentialRampToValueAtTime(45, t + 0.16);
    const g = ctx.createGain();
    g.gain.setValueAtTime(oomph || 0.9, t);
    g.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
    o.connect(g); g.connect(fxGain);
    o.start(t); o.stop(t + 0.32);
  }
  function dholTak(t) {
    const dur = 0.09, n = Math.floor(ctx.sampleRate * dur);
    const buf = ctx.createBuffer(1, n, ctx.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / n, 2);
    const src = ctx.createBufferSource(); src.buffer = buf;
    const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 1900; bp.Q.value = 1.2;
    const g = ctx.createGain(); g.gain.value = 0.55;
    src.connect(bp); bp.connect(g); g.connect(fxGain);
    src.start(t);
  }
  function playDhol() {
    if (!ensureCtx()) return;
    if (ctx.state === 'suspended') ctx.resume();
    const sw = () => Math.random() * 0.025; // slight timing swing
    const t = ctx.currentTime + 0.03;
    dholDha(t, 0.9);                 // dha
    dholDha(t + 0.2 + sw(), 0.75);   // dha
    dholTak(t + 0.38 + sw());        // tak
    dholDha(t + 0.54 + sw(), 1.0);   // DHA
  }

  /* ================= INTRO ================= */
  const intro = $('#intro');
  $('#open-btn').addEventListener('click', () => {
    startMusic();
    document.body.classList.remove('locked');
    intro.classList.add('lift');
    intro.addEventListener('transitionend', () => intro.remove(), { once: true });
    setTimeout(() => { if (document.body.contains(intro)) intro.remove(); }, 1400);
  });

  /* ================= REVEALS ================= */
  const targets = $$('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
    targets.forEach((el) => io.observe(el));
  } else {
    targets.forEach((el) => el.classList.add('in'));
  }

  /* ================= COUNTDOWN ================= */
  const TARGET = new Date('2026-11-15T10:00:00+05:30').getTime();
  const pad = (n) => String(n).padStart(2, '0');
  const cd = { d: $('#cd-d'), h: $('#cd-h2'), m: $('#cd-m'), s: $('#cd-s') };
  let cdTimer = null;
  function tick() {
    const ms = TARGET - Date.now();
    if (ms <= 0) {
      cd.d.textContent = cd.h.textContent = cd.m.textContent = cd.s.textContent = '00';
      if (cdTimer) clearInterval(cdTimer);
      return;
    }
    const s = Math.floor(ms / 1000);
    cd.d.textContent = pad(Math.floor(s / 86400));
    cd.h.textContent = pad(Math.floor(s / 3600) % 24);
    cd.m.textContent = pad(Math.floor(s / 60) % 60);
    cd.s.textContent = pad(s % 60);
  }
  tick();
  cdTimer = setInterval(tick, 1000);

  /* ================= DHOL TAP ================= */
  const dholBtn = $('#dhol-btn'), dholStage = $('#dhol-stage'), dholSec = $('#dhol-pulse');
  dholBtn.addEventListener('click', () => {
    playDhol();
    dholSec.classList.remove('pulse');
    void dholSec.offsetWidth; // restart animation
    dholSec.classList.add('pulse');
    for (let i = 0; i < 9; i++) {
      const p = document.createElement('span');
      p.className = 'petal';
      const a = Math.random() * Math.PI * 2, dist = 70 + Math.random() * 90;
      p.style.setProperty('--dx', (Math.cos(a) * dist).toFixed(0) + 'px');
      p.style.setProperty('--dy', (Math.sin(a) * dist - 50).toFixed(0) + 'px');
      p.style.setProperty('--rz', Math.floor(Math.random() * 380) + 'deg');
      dholStage.appendChild(p);
      p.addEventListener('animationend', () => p.remove());
      setTimeout(() => { if (p.parentNode) p.remove(); }, 1500);
    }
  });

  /* ================= VADHAIYAN WALL ================= */
  $('#wish-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const nameEl = $('#wish-name'), msgEl = $('#wish-msg');
    const msg = msgEl.value.trim();
    if (!msg) { msgEl.focus(); return; }
    const li = document.createElement('li');
    li.className = 'wish';
    const p = document.createElement('p');
    p.textContent = msg;
    const who = document.createElement('span');
    who.textContent = '— ' + (nameEl.value.trim() || 'A well-wisher');
    li.appendChild(p); li.appendChild(who);
    $('#wish-list').prepend(li);
    e.target.reset();
    msgEl.focus();
  });

  /* ================= RSVP ================= */
  let attending = null, guests = 1;
  const attHint = $('#att-hint'), gCount = $('#g-count');
  $$('.att-pill').forEach((b) => b.addEventListener('click', () => {
    attending = b.dataset.v;
    attHint.hidden = true;
    $$('.att-pill').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));
  $('#g-minus').addEventListener('click', () => { guests = Math.max(1, guests - 1); gCount.textContent = guests; });
  $('#g-plus').addEventListener('click', () => { guests = Math.min(10, guests + 1); gCount.textContent = guests; });

  const rForm = $('#rsvp-form'), rThanks = $('#rsvp-thanks');
  rForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const nameEl = $('#r-name');
    if (!nameEl.value.trim()) { nameEl.focus(); return; }
    if (!attending) { attHint.hidden = false; $$('.att-pill')[0].focus(); return; }
    const yes = attending === 'yes';
    $('#thanks-msg').textContent = yes
      ? 'Balle balle! See you on the floor.'
      : 'You’ll be missed — we’ll dance one for you.';
    $('#thanks-sub').textContent = yes
      ? 'Shukriya, ' + nameEl.value.trim() + ' · ' + guests + (guests > 1 ? ' guests' : ' guest') + ' noted.'
      : 'Shukriya for letting us know, ' + nameEl.value.trim() + '.';
    rForm.hidden = true;
    rThanks.hidden = false;
    $('#r-change').focus();
  });
  $('#r-change').addEventListener('click', () => {
    rThanks.hidden = true;
    rForm.hidden = false;
    $('#r-name').focus();
  });
})();
</script>
