# Shazli & Ashir RSVP dashboard: only index.php (and export/index.php) are reachable; the helpers, the sign-in secret
# and the data folder are closed to the web.
Options -Indexes
DirectoryIndex index.php
<FilesMatch "^(_lib\.php|auth\.secret\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "no-store, private"
</IfModule>
