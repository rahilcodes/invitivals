# This invitation is corrected in place, so browsers re-check every script,
# style and picture (a quick "not modified" when nothing changed). The film and
# the music are large and rarely change, so they keep the site's normal caching.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# the RSVP entries live in data/ and are never served
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/ - [F]
</IfModule>
