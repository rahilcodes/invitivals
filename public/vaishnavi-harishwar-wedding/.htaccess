# This invitation is corrected in place, so browsers re-check the page, its scripts and its styles on every visit
# (a quick "not modified" when nothing changed). Pictures, the film and the music keep the site's normal caching.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
